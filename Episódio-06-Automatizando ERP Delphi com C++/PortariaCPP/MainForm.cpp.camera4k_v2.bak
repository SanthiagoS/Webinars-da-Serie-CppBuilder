    }

    LstEmployees->Items->BeginUpdate();
    try
    {
        LstEmployees->Items->Clear();

        if (FAccessEventRepository == nullptr)
        {
            LblDeveloperStatus->Caption =
                L"Registro de ocorrências indisponível.";
            return;
        }

        const std::vector<TOccurrence> Occurrences =
            FAccessEventRepository->GetRecentOccurrences(50);

        for (const TOccurrence& Occurrence : Occurrences)
        {
            UnicodeString DisplayTime = Occurrence.EventDateTime;
            if (DisplayTime.Length() >= 19)
            {
                DisplayTime = DisplayTime.SubString(12, 8);
            }

            UnicodeString Line =
                DisplayTime + L"  •  " +
                Occurrence.OccurrenceType;

            if (!Occurrence.EmployeeName.IsEmpty())
            {
                Line += L"  •  " + Occurrence.EmployeeName;
            }

            if (!Occurrence.Description.IsEmpty())
            {
                Line += L"  •  " + Occurrence.Description;
            }

            LstEmployees->Items->Add(Line);
        }

        if (Occurrences.empty())
        {
            LblDeveloperStatus->Caption =
                L"Nenhuma ocorrência registrada.";
        }
        else
        {
            LblDeveloperStatus->Caption =
                IntToStr(static_cast<int>(Occurrences.size())) +
                L" ocorrência(s) recente(s)";
        }
    }
    __finally
    {
        LstEmployees->Items->EndUpdate();
    }
}

bool TMainForm::ResolveEmployeeByName(
    const UnicodeString& Name,
    TEmployee& Employee)
{
    Employee = TEmployee();

    if (FEmployeeRepository == nullptr || Trim(Name).IsEmpty())
    {
        return false;
    }

    const UnicodeString Wanted = LowerCase(Trim(Name));
    const std::vector<TEmployee> Employees =
        FEmployeeRepository->GetAll();

    for (const TEmployee& Candidate : Employees)
    {
        if (LowerCase(Trim(Candidate.Name)) == Wanted)
        {
            Employee = Candidate;
            return Employee.Id > 0;
        }
    }

    return false;
}

bool TMainForm::IsEmployeeAccessBlocked(
    const TEmployee& Employee,
    UnicodeString& Reason) const
{
    Reason = UnicodeString();

    return FAccessEventRepository != nullptr &&
        FAccessEventRepository->IsEmployeeBlocked(
            Employee.Id, Reason);
}

void TMainForm::ShowBlockedEmployeeResult(
    const TEmployee& Employee,
    const UnicodeString& Reason,
    const TCameraFrame& Frame)
{
    FFacePreviewState = TFacePreviewState::NotRecognized;
    FIdentificationState = IdentificationState::Failed;
    FFaceRecognitionLocked = true;
    FRecognizedEmployeeId = Employee.Id;
    FFaceMissFrames = 0;
    FRecognitionCandidateId = 0;
    FRecognitionCandidateHits = 0;

    if (ReturnTimer != nullptr)
    {
        ReturnTimer->Enabled = false;
        ReturnTimer->Interval = 3500;
        ReturnTimer->Enabled = true;
    }

    UpdateEmployeePhotoSnapshot(Frame, FPrimaryFaceDetection);

    EmployeeResultPanel->Visible = true;
    EmployeeResultPanel->BringToFront();

    if (FRecognitionCheckShape != nullptr)
    {
        FRecognitionCheckShape->Visible = false;
    }
    if (FRecognitionCheckLabel != nullptr)
    {
        FRecognitionCheckLabel->Visible = false;
    }

    const TColor DeniedColor = RgbColor(220, 72, 82);

    LblEmployeeState->Caption = L"ACESSO NEGADO";
    LblEmployeeState->Font->Color = DeniedColor;

    LblName->Caption = Employee.Name;
    LblDepartment->Caption = Employee.Department;

    LblIdentifiedAt->Caption =
        L"Bloqueado às " + FormatDateTime(L"hh:nn:ss", Now());

    LblPrompt->Caption = Reason.IsEmpty()
        ? L"Acesso negado — procure a portaria"
        : L"Acesso negado — " + Reason;
    LblPrompt->Font->Color = DeniedColor;

    TOccurrence Attempt;
    Attempt.OccurrenceType = L"Tentativa bloqueada";
    Attempt.Description = Reason.IsEmpty()
        ? L"Funcionário reconhecido com acesso bloqueado."
        : Reason;
    Attempt.EmployeeName = Employee.Name;
    Attempt.EventDateTime =
        FormatDateTime(L"yyyy-mm-dd hh:nn:ss", Now());
    Attempt.Terminal = TerminalDisplayName();
    Attempt.Status = L"REGISTRADA";

    if (FAccessEventRepository != nullptr)
    {
        FAccessEventRepository->AddOccurrence(Attempt);
    }

    // OBSERVABILITY:
    // A tentativa bloqueada por identificação facial também precisa chegar
    // ao WebServer :8080. Antes ela era registrada somente no access.s3db,
    // por isso o Dashboard não mostrava o bloqueio.
    if (FObservabilityHeartbeat != nullptr)
    {
        FObservabilityHeartbeat->SendEvent(
            L"WARN",
            L"FACE_ACCESS_DENIED",
            L"Acesso negado por identificação facial",
            Employee.Name,
            Reason.IsEmpty()
                ? UnicodeString(L"ACCESS_DENIED")
                : Reason,
            FLastRecognitionDurationMs);
    }

    LayoutTerminal();
}

void TMainForm::RefreshOccurrenceEmployees()
{
    FEmployees.clear();

    if (LstEmployees == nullptr)
    {
        return;
    }

    LstEmployees->Items->BeginUpdate();
    try
    {
        LstEmployees->Items->Clear();

        if (FEmployeeRepository != nullptr)
        {
            FEmployees = FEmployeeRepository->GetAll();
        }

        for (const TEmployee& Employee : FEmployees)
        {
            UnicodeString Reason;
            const bool Blocked =
                IsEmployeeAccessBlocked(Employee, Reason);

            UnicodeString Line = Employee.Name;

            if (!Employee.Department.IsEmpty())
            {
                Line += L"  •  " + Employee.Department;
            }

            Line += Blocked
                ? L"  •  BLOQUEADO"
                : L"  •  LIBERADO";

            if (Blocked && !Reason.IsEmpty())
            {
                Line += L"  •  " + Reason;
            }

            LstEmployees->Items->Add(Line);
        }

        if (!FEmployees.empty())
        {
            LstEmployees->ItemIndex = 0;
        }

        LblDeveloperStatus->Caption =
            IntToStr(static_cast<int>(FEmployees.size())) +
            L" funcionário(s) • selecione um cadastro para bloquear/liberar.";
    }
    __finally
    {
        LstEmployees->Items->EndUpdate();
    }
}

void TMainForm::UpdateOccurrencePageButtons()
{
    if (FCurrentPage != TAccessPage::Incidents)
    {
        return;
    }

    if (FIncidentHistoryMode)
    {
        BtnSimulate->Visible = true;
        BtnSimulate->Caption = L"FUNCIONÁRIOS";

        BtnClear->Visible = true;
        BtnClear->Caption = L"REGISTRAR OCORRÊNCIA";

        BtnStartCamera->Visible = false;
    }
    else
    {
        BtnSimulate->Visible = true;
        BtnSimulate->Caption = L"BLOQUEAR ACESSO";

        BtnClear->Visible = true;
        BtnClear->Caption = L"LIBERAR ACESSO";

        BtnStartCamera->Visible = true;
        BtnStartCamera->Caption = L"HISTÓRICO";
    }
}

bool TMainForm::SetSelectedEmployeeBlocked(bool Blocked)
{
    TEmployee Employee;
    if (!TryGetSelectedEmployee(Employee))
    {
        MessageDlg(
            L"Selecione um funcionário.",
            mtWarning,
            TMsgDlgButtons() << mbOK,
            0);
        return false;
    }

    UnicodeString Reason;

    if (Blocked)
    {
        if (!InputQuery(
                L"Bloquear acesso",
                L"Motivo do bloqueio:",
                Reason))
        {
            return false;
        }

        Reason = Trim(Reason);
        if (Reason.IsEmpty())
        {
            MessageDlg(
                L"Informe o motivo do bloqueio.",
                mtWarning,
                TMsgDlgButtons() << mbOK,
                0);
            return false;
        }
    }
    else
    {
        Reason = L"Acesso liberado pelo operador da portaria.";
    }

    const UnicodeString Question =
        (Blocked
            ? UnicodeString(L"Bloquear acesso de:\n\n")
            : UnicodeString(L"Liberar acesso de:\n\n")) +
        Employee.Name +
        (Employee.Department.IsEmpty()
            ? UnicodeString()
            : L"\n" + Employee.Department);

    if (MessageDlg(
            Question,
            mtConfirmation,
            TMsgDlgButtons() << mbYes << mbNo,
            0) != mrYes)
    {
        return false;
    }

    if (FAccessEventRepository == nullptr ||
        !FAccessEventRepository->SetEmployeeBlocked(
            Employee.Id,
            Employee.Name,
            Blocked,
            Reason,
            TerminalDisplayName()))
    {
        MessageDlg(
            L"Não foi possível atualizar o status de acesso.",
            mtError,
            TMsgDlgButtons() << mbOK,
            0);
        return false;
    }

    TOccurrence Occurrence;
    Occurrence.OccurrenceType =
        Blocked ? L"Acesso bloqueado" : L"Acesso liberado";
    Occurrence.Description = Reason;
    Occurrence.EmployeeName = Employee.Name;
    Occurrence.EventDateTime =
        FormatDateTime(L"yyyy-mm-dd hh:nn:ss", Now());
    Occurrence.Terminal = TerminalDisplayName();
    Occurrence.Status = L"REGISTRADA";
    FAccessEventRepository->AddOccurrence(Occurrence);

    MessageDlg(
        Blocked
            ? L"Acesso bloqueado com sucesso."
            : L"Acesso liberado com sucesso.",
        mtInformation,
        TMsgDlgButtons() << mbOK,
        0);

    RefreshOccurrenceEmployees();
    return true;
}

bool TMainForm::RegisterOccurrence()
{
    if (FAccessEventRepository == nullptr)
    {
        MessageDlg(
            L"O repositório de ocorrências não está disponível.",
            mtError,
            TMsgDlgButtons() << mbOK,
            0);
        return false;
    }

    UnicodeString OccurrenceType;
    if (!InputQuery(
            L"Registrar ocorrência",
            L"Tipo (ex.: Acesso negado, Visitante, RFID, Câmera, Exceção):",
            OccurrenceType))
    {
        return false;
    }

    OccurrenceType = Trim(OccurrenceType);
    if (OccurrenceType.IsEmpty())
    {
        MessageDlg(
            L"Informe o tipo da ocorrência.",
            mtWarning,
            TMsgDlgButtons() << mbOK,
            0);
        return false;
    }

    UnicodeString EmployeeName;
    if (!InputQuery(
            L"Registrar ocorrência",
            L"Funcionário/visitante relacionado (opcional):",
            EmployeeName))
    {
        return false;
    }

    UnicodeString Description;
    if (!InputQuery(
            L"Registrar ocorrência",
            L"Descrição da ocorrência:",
            Description))
    {
        return false;
    }

    Description = Trim(Description);
    if (Description.IsEmpty())
    {
        MessageDlg(
            L"Informe uma descrição para a ocorrência.",
            mtWarning,
            TMsgDlgButtons() << mbOK,
            0);
        return false;
    }

    TOccurrence Occurrence;
    Occurrence.OccurrenceType = OccurrenceType;
    Occurrence.Description = Description;
    Occurrence.EmployeeName = Trim(EmployeeName);
    Occurrence.EventDateTime =
        FormatDateTime(L"yyyy-mm-dd hh:nn:ss", Now());
    Occurrence.Terminal = TerminalDisplayName();
    Occurrence.Status = L"REGISTRADA";

    if (!FAccessEventRepository->AddOccurrence(Occurrence))
    {
        MessageDlg(
            L"Não foi possível registrar a ocorrência.",
            mtError,
            TMsgDlgButtons() << mbOK,
            0);
        return false;
    }

    // Algumas ocorrências têm efeito operacional no controle de acesso.
    // "Acesso negado" bloqueia o funcionário; "Acesso liberado" ou
    // "Desbloqueio" remove o bloqueio. O nome deve coincidir com o cadastro.
    const UnicodeString NormalizedType =
        LowerCase(Trim(OccurrenceType));

    const bool ShouldBlock =
        NormalizedType.Pos(L"acesso negado") > 0 ||
        NormalizedType.Pos(L"bloqueio") > 0;

    const bool ShouldUnblock =
        NormalizedType.Pos(L"acesso liberado") > 0 ||
        NormalizedType.Pos(L"desbloqueio") > 0;

    if (ShouldBlock || ShouldUnblock)
    {
        TEmployee RelatedEmployee;
        if (!ResolveEmployeeByName(EmployeeName, RelatedEmployee))
        {
            MessageDlg(
                L"A ocorrência foi registrada, mas o funcionário informado "
                L"não corresponde exatamente a um cadastro do Employees.s3db. "
                L"Por isso, nenhum bloqueio foi alterado.",
                mtWarning,
                TMsgDlgButtons() << mbOK,
                0);
            return true;
        }

        if (!FAccessEventRepository->SetEmployeeBlocked(
                RelatedEmployee.Id,
                RelatedEmployee.Name,
                ShouldBlock,
                Description,
                TerminalDisplayName()))
        {
            MessageDlg(
                L"A ocorrência foi registrada, mas não foi possível atualizar "
                L"o bloqueio operacional do funcionário.",
                mtWarning,
                TMsgDlgButtons() << mbOK,
                0);
            return true;
        }

        MessageDlg(
            ShouldBlock
                ? L"Ocorrência registrada e acesso do funcionário BLOQUEADO."
                : L"Ocorrência registrada e acesso do funcionário LIBERADO.",
            mtInformation,
            TMsgDlgButtons() << mbOK,
            0);

        return true;
    }

    MessageDlg(
        L"Ocorrência registrada com sucesso.",
        mtInformation,
        TMsgDlgButtons() << mbOK,
        0);

    return true;
}

UnicodeString TMainForm::NormalizeRfidUid(
    const UnicodeString& RawUid) const
{
    UnicodeString Result;

    for (int Index = 1; Index <= RawUid.Length(); ++Index)
    {
        const wchar_t Ch = RawUid[Index];

        if ((Ch >= L'0' && Ch <= L'9') ||
            (Ch >= L'A' && Ch <= L'F') ||
            (Ch >= L'a' && Ch <= L'f'))
        {
            Result += UpCase(Ch);
        }
    }

    return Result;
}

bool TMainForm::IsValidRfidUid(const UnicodeString& Uid) const
{
    // UIDs comuns: 4, 7 ou 10 bytes = 8, 14 ou 20 dígitos hexadecimais.
    return Uid.Length() == 8 ||
           Uid.Length() == 14 ||
           Uid.Length() == 20;
}

void TMainForm::RefreshRfidTagEmployees()
{
    FEmployees.clear();

    if (LstEmployees == nullptr)
    {
        return;
    }

    LstEmployees->Items->BeginUpdate();
    try
    {
        LstEmployees->Items->Clear();

        if (FEmployeeRepository != nullptr)
        {
            FEmployees = FEmployeeRepository->GetAll();
        }

        int TagCount = 0;

        for (const TEmployee& Employee : FEmployees)
        {
            TRfidTagAssignment Tag;
            const bool HasTag =
                FAccessEventRepository != nullptr &&
                FAccessEventRepository->GetRfidTagByEmployee(
                    Employee.Id, Tag);

            UnicodeString Line = Employee.Name;

            if (!Employee.Department.IsEmpty())
            {
                Line += L"  •  " + Employee.Department;
            }

            if (HasTag && Tag.Active)
            {
                ++TagCount;
				Line += L"  •  TAG RFID: " + Tag.TagUid +
                    L"  •  " + Tag.TagType;
            }
            else
            {
                Line += L"  •  SEM TAG RFID";
            }

            LstEmployees->Items->Add(Line);
        }

        if (!FEmployees.empty())
        {
            LstEmployees->ItemIndex = 0;
		}

        LblDeveloperStatus->Caption =
            IntToStr(TagCount) + L" TAG(s) RFID cadastrada(s) • " +
            IntToStr(static_cast<int>(FEmployees.size())) +
            L" funcionário(s)";
    }
    __finally
    {
        LstEmployees->Items->EndUpdate();
    }
}

bool TMainForm::RegisterRfidTagManual()
{
    TEmployee Employee;
    if (!TryGetSelectedEmployee(Employee))
    {
        MessageDlg(
            L"Selecione um funcionário para cadastrar a TAG RFID.",
            mtWarning,
            TMsgDlgButtons() << mbOK,
            0);
        return false;
    }

    UnicodeString RawUid;

    if (!FRfidAdminUid.IsEmpty())
    {
        RawUid = FRfidAdminUid;

        if (MessageDlg(
                L"VINCULAR TAG LIDA\n\n"
                L"Funcionário: " + Employee.Name +
                L"\nUID: " + RawUid +
                L"\n\nConfirmar este vínculo?",
                mtConfirmation,
                TMsgDlgButtons() << mbYes << mbNo,
                0) != mrYes)
        {
            return false;
        }
    }
    else
    {
        // Mantemos o cadastro manual como fallback para manutenção.
        if (!InputQuery(
                L"Cadastrar TAG RFID",
                L"Aproxime uma TAG no leitor ou informe o UID manualmente "
                L"(ex.: 556A37D5):",
                RawUid))
        {
            return false;
        }
    }

    const UnicodeString TagUid = NormalizeRfidUid(RawUid);

    if (!IsValidRfidUid(TagUid))
    {
        MessageDlg(
            L"UID inválido.\n\n"
            L"Informe apenas o UID hexadecimal da TAG.\n"
            L"Exemplo: 556A37D5\n\n"
            L"Também são aceitos espaços, hífens ou dois-pontos; "
            L"o sistema fará a normalização automaticamente.",
            mtWarning,
            TMsgDlgButtons() << mbOK,
            0);
        return false;
    }

    TRfidTagAssignment ExistingUid;
    if (FAccessEventRepository != nullptr &&
        FAccessEventRepository->GetRfidTagByUid(
            TagUid, ExistingUid) &&
        ExistingUid.EmployeeId != Employee.Id)
    {
        MessageDlg(
            L"Esta TAG já está vinculada a outro funcionário:\n\n" +
            ExistingUid.EmployeeName +
            L"\nUID: " + ExistingUid.TagUid,
            mtError,
            TMsgDlgButtons() << mbOK,
            0);
        return false;
    }

    TRfidTagAssignment ExistingEmployee;
    if (FAccessEventRepository != nullptr &&
        FAccessEventRepository->GetRfidTagByEmployee(
            Employee.Id, ExistingEmployee))
    {
        if (MessageDlg(
                L"Este funcionário já possui a TAG:\n\n" +
                ExistingEmployee.TagUid +
                L"\n\nDeseja substituir pelo UID " +
                TagUid + L"?",
                mtConfirmation,
                TMsgDlgButtons() << mbYes << mbNo,
                0) != mrYes)
        {
            return false;
        }
    }

    const UnicodeString RfidIdentityKey =
        BuildRfidIdentityKey(Employee);

    OutputDebugStringW(
        (L"[RFID][PORTARIA] Cadastrando vínculo: EmployeeId=" +
         IntToStr(Employee.Id) +
         L" | Employee=" + Employee.Name +
         L" | UID=" + TagUid +
         L" | IdentityKey=" + RfidIdentityKey +
         (Trim(Employee.FaceKey).IsEmpty()
             ? L" | source=RFID_FALLBACK"
             : L" | source=FACE_KEY") +
         L"\r\n").c_str());

    if (FAccessEventRepository == nullptr ||
        !FAccessEventRepository->AssignRfidTag(
            Employee.Id,
            RfidIdentityKey,
            Employee.Name,
            Employee.Department,
            TagUid,
            L"CHAVEIRO / BOLACHA RFID"))
    {
        MessageDlg(
            L"Não foi possível cadastrar a TAG RFID.\n\n"
            L"Funcionário: " + Employee.Name +
            L"\nEmployeeID: " + IntToStr(Employee.Id) +
            L"\nUID: " + TagUid +
            L"\n\nA leitura do RC522 está correta; "
            L"a falha ocorreu ao gravar o vínculo no banco local.",
            mtError,
            TMsgDlgButtons() << mbOK,
            0);
        return false;
    }

    // Atualiza a lista ANTES da confirmação visual. Assim, enquanto a caixa
    // de sucesso estiver aberta, o operador já consegue ver o vínculo aplicado
    // na linha do funcionário ao fundo.
    RefreshRfidTagEmployees();

    MessageDlg(
        L"TAG RFID cadastrada com sucesso.\n\n" +
        Employee.Name +
        L"\nUID: " + TagUid +
        L"\nTipo: CHAVEIRO / BOLACHA RFID\n\n"
        L"O vínculo está ativo. Ao aproximar esta TAG na tela principal, "
        L"o funcionário será identificado automaticamente.",
        mtInformation,
        TMsgDlgButtons() << mbOK,
        0);

    FRfidAdminUid = UnicodeString();
    UpdateRfidAdminReader();
    return true;
}

bool TMainForm::RemoveSelectedRfidTag()
{
    TEmployee Employee;
    if (!TryGetSelectedEmployee(Employee))
    {
        MessageDlg(
            L"Selecione um funcionário.",
            mtWarning,
            TMsgDlgButtons() << mbOK,
            0);
        return false;
    }

    TRfidTagAssignment Existing;
    if (FAccessEventRepository == nullptr ||
        !FAccessEventRepository->GetRfidTagByEmployee(
            Employee.Id, Existing))
    {
        MessageDlg(
            L"Este funcionário não possui TAG RFID cadastrada.",
            mtInformation,
            TMsgDlgButtons() << mbOK,
            0);
        return false;
    }

    if (MessageDlg(
            L"Remover a TAG RFID " + Existing.TagUid +
            L" de " + Employee.Name + L"?",
            mtConfirmation,
            TMsgDlgButtons() << mbYes << mbNo,
            0) != mrYes)
    {
        return false;
    }

    if (!FAccessEventRepository->RemoveRfidTag(Employee.Id))
    {
        MessageDlg(
            L"Não foi possível remover a TAG RFID.",
            mtError,
            TMsgDlgButtons() << mbOK,
            0);
        return false;
    }

    MessageDlg(
        L"TAG RFID removida com sucesso.",
        mtInformation,
        TMsgDlgButtons() << mbOK,
        0);

    RefreshRfidTagEmployees();
    return true;
}


void TMainForm::ProcessRfidIdentification(const UnicodeString& Uid)
{
    if (Uid.IsEmpty() ||
        FAccessEventRepository == nullptr ||
        FEmployeeRepository == nullptr)
    {
        return;
    }

    if (FObservabilityHeartbeat != nullptr)
    {
        FObservabilityHeartbeat->SendEvent(
            L"INFO",
            L"RFID_READ",
            L"TAG RFID lida no terminal",
            L"",
            Uid,
            0.0);
    }

    TRfidTagAssignment Assignment;
    if (!FAccessEventRepository->GetRfidTagByUid(
            Uid, Assignment) ||
        !Assignment.Active ||
        Assignment.EmployeeId <= 0)
    {
        OutputDebugStringW(
            (L"[RFID][PORTARIA] TAG não cadastrada: " +
             Uid + L"\r\n").c_str());

        if (FObservabilityHeartbeat != nullptr)
        {
            FObservabilityHeartbeat->SendEvent(
                L"WARN",
                L"RFID_UNKNOWN_TAG",
                L"TAG RFID não cadastrada",
                L"",
                Uid,
                0.0);
        }

        // Feedback rápido sem criar um falso funcionário.
        LblPrompt->Caption =
            L"TAG RFID não cadastrada • procure a portaria";
        LblPrompt->Font->Color = RgbColor(245, 190, 79);

        FLastRfidState = TRfidVisualState::UnknownTag;

        LblBleStatusDetail->Caption =
            L"● NÃO CADASTRADA • " + Uid;
        LblBleStatusDetail->Font->Color =
            RgbColor(245, 190, 79);

        if (ReturnTimer != nullptr)
        {
            ReturnTimer->Enabled = false;
            ReturnTimer->Interval = 2500;
            ReturnTimer->Enabled = true;
        }

        return;
    }

    // Sempre consulta o funcionário atual. O snapshot de nome/departamento
    // gravado no access.s3db não é usado como fonte oficial.
    TEmployee Employee;

    const bool EmployeeFound =
        FEmployeeRepository->FindById(
            Assignment.EmployeeId, Employee) &&
        Employee.Id > 0;

    const bool IdentityMatches =
        EmployeeFound &&
        RfidIdentityMatches(
            Assignment.IdentityKey,
            Employee);

    if (!IdentityMatches)
    {
        OutputDebugStringW(
            (L"[RFID][PORTARIA] Vínculo RFID inválido/órfão: " +
             Uid +
             L" | EmployeeId=" +
             IntToStr(Assignment.EmployeeId) +
             L"\r\n").c_str());

        if (FObservabilityHeartbeat != nullptr)
        {
            FObservabilityHeartbeat->SendEvent(
                L"WARN",
                L"RFID_INVALID_LINK",
                L"Vínculo RFID inválido ou órfão removido",
                EmployeeFound ? Employee.Name : L"",
                Uid,
                0.0);
        }

        // Evita que um EmployeeID eventualmente reutilizado herde uma
        // TAG antiga. Também elimina vínculos legados sem IdentityKey.
        if (FAccessEventRepository != nullptr)
            FAccessEventRepository->RemoveRfidTag(
                Assignment.EmployeeId);

        FLastRfidState =
            TRfidVisualState::InvalidLink;

        LblPrompt->Caption =
            EmployeeFound
                ? L"Vínculo RFID inválido • recadastre a TAG"
                : L"TAG vinculada a funcionário indisponível";

        LblPrompt->Font->Color =
            RgbColor(220, 72, 82);

        ApplyRfidStatus();

        if (ReturnTimer != nullptr)
        {
            ReturnTimer->Enabled = false;
            ReturnTimer->Interval = 2500;
            ReturnTimer->Enabled = true;
        }

        return;
    }

    UnicodeString BlockReason;
    const bool LocalBlocked =
        IsEmployeeAccessBlocked(Employee, BlockReason);

    // ETAPA 5: ERP online decide. A regra local fica somente como fallback.
    TErpAccessDecision ErpDecision;
    TryGetErpAccessDecision(
        Employee.Id,
        L"RFID",
        ErpDecision);
    LogAccessDecisionComparison(
        L"RFID",
        Employee,
        !LocalBlocked,
        ErpDecision);

    if (ErpDecision.Available)
    {
        if (!ErpDecision.Authorized)
        {
            ShowRfidBlockedEmployeeResult(
                Employee,
                Uid,
                ErpAccessReasonToDisplay(ErpDecision.Reason));
            return;
        }

        ShowRfidEmployeeResult(Employee, Uid);
        return;
    }

    // ETAPA 6 - CONTINGENCIA EXPLICITA:
    // ERP indisponivel -> a Portaria continua operacional com a regra local,
    // mas deixa claro para o operador e para a observabilidade que a decisao
    // nao veio da fonte corporativa em tempo real.
    if (FObservabilityHeartbeat != nullptr)
    {
        FObservabilityHeartbeat->SendEvent(
            L"WARN",
            L"ACCESS_DECISION_OFFLINE",
            L"ERP indisponível • decisão local de contingência",
            Employee.Name,
            LocalBlocked
                ? UnicodeString(L"RFID|ERP_UNAVAILABLE|LOCAL_DENIED")
                : UnicodeString(L"RFID|ERP_UNAVAILABLE|LOCAL_GRANTED"),
            0.0);
    }

    if (LocalBlocked)
    {
        const UnicodeString ContingencyReason =
            BlockReason.IsEmpty()
                ? UnicodeString(L"Modo contingência • ERP indisponível")
                : UnicodeString(L"Modo contingência • ") + BlockReason;

        ShowRfidBlockedEmployeeResult(
            Employee, Uid, ContingencyReason);
        return;
    }

    ShowRfidEmployeeResult(Employee, Uid);

    // ShowRfidEmployeeResult monta o card normal de sucesso; nesta etapa
    // apenas enriquecemos a mensagem para evidenciar a contingencia.
    if (LblPrompt != nullptr)
    {
        LblPrompt->Caption =
            L"Acesso autorizado • Modo contingência (ERP indisponível)";
        LblPrompt->Font->Color = RgbColor(245, 190, 79);
    }
}

void TMainForm::ShowRfidEmployeeResult(
    const TEmployee& Employee,
    const UnicodeString& Uid)
{
    // Enquanto o resultado RFID está visível, não permitimos que uma
    // identificação facial simultânea sobrescreva o card do funcionário.
    FFaceRecognitionLocked = true;
    FRecognizedEmployeeId = Employee.Id;
    FRecognitionCandidateId = 0;
    FRecognitionCandidateHits = 0;

    if (FIdentificationManager != nullptr)
        FIdentificationManager->ClearIdentification();

    if (FEmployeePhotoImage != nullptr)
        FEmployeePhotoImage->Visible = false;

    if (LblPhoto != nullptr)
    {
        LblPhoto->Visible = true;
        LblPhoto->Caption = L"RFID";
    }

    if (FRecognitionCheckShape != nullptr)
        FRecognitionCheckShape->Visible = false;

    if (FRecognitionCheckLabel != nullptr)
        FRecognitionCheckLabel->Visible = false;

    const TColor GrantedColor = RgbColor(41, 214, 132);

    EmployeeResultPanel->Visible = true;
    EmployeeResultPanel->BringToFront();

    LblEmployeeState->Caption = L"ACESSO AUTORIZADO";
    LblEmployeeState->Font->Color = GrantedColor;
    LblName->Caption = Employee.Name;
    LblDepartment->Caption = Employee.Department;
    LblIdentifiedAt->Caption =
        L"RFID confirmado às " +
        FormatDateTime(L"hh:nn:ss", Now());

    LblPrompt->Caption =
        L"Acesso autorizado por TAG RFID";
    LblPrompt->Font->Color = GrantedColor;

    FLastRfidState = TRfidVisualState::Authorized;

    LblBleStatusDetail->Caption =
        L"● AUTORIZADA • " + Uid;
    LblBleStatusDetail->Font->Color = GrantedColor;

    RecordRfidAccessEvent(Employee, Uid);

    if (FObservabilityHeartbeat != nullptr)
    {
        FObservabilityHeartbeat->SendEvent(
            L"SUCCESS",
            L"RFID_ACCESS_GRANTED",
            L"Acesso autorizado por TAG RFID",
            Employee.Name,
            Uid,
            0.0);
    }

    OutputDebugStringW(
        (L"[RFID][PORTARIA] ACESSO AUTORIZADO: " +
         Employee.Name + L" • " +
         Employee.Department + L" • UID " +
         Uid + L"\r\n").c_str());

    LayoutTerminal();

    // RFID é uma leitura discreta: depois de alguns segundos o terminal
    // volta automaticamente ao estado pronto para o próximo funcionário.
    if (ReturnTimer != nullptr)
    {
        ReturnTimer->Enabled = false;
        ReturnTimer->Interval = 3000;
        ReturnTimer->Enabled = true;
    }
}

void TMainForm::ShowRfidBlockedEmployeeResult(
    const TEmployee& Employee,
    const UnicodeString& Uid,
    const UnicodeString& Reason)
{
    FFaceRecognitionLocked = true;
    FRecognizedEmployeeId = Employee.Id;
    FRecognitionCandidateId = 0;
    FRecognitionCandidateHits = 0;

    if (FIdentificationManager != nullptr)
        FIdentificationManager->ClearIdentification();

    if (FEmployeePhotoImage != nullptr)
        FEmployeePhotoImage->Visible = false;

    if (LblPhoto != nullptr)
    {
        LblPhoto->Visible = true;
        LblPhoto->Caption = L"RFID";
    }

    if (FRecognitionCheckShape != nullptr)
        FRecognitionCheckShape->Visible = false;

    if (FRecognitionCheckLabel != nullptr)
        FRecognitionCheckLabel->Visible = false;

    const TColor DeniedColor = RgbColor(220, 72, 82);

    EmployeeResultPanel->Visible = true;
    EmployeeResultPanel->BringToFront();

    LblEmployeeState->Caption = L"ACESSO NEGADO";
    LblEmployeeState->Font->Color = DeniedColor;
    LblName->Caption = Employee.Name;
    LblDepartment->Caption = Employee.Department;
    LblIdentifiedAt->Caption =
        L"RFID bloqueado às " +
        FormatDateTime(L"hh:nn:ss", Now());

    LblPrompt->Caption = Reason.IsEmpty()
        ? L"Acesso negado por TAG RFID"
        : L"Acesso negado • " + Reason;
    LblPrompt->Font->Color = DeniedColor;

    FLastRfidState = TRfidVisualState::Denied;

    LblBleStatusDetail->Caption =
        L"● ACESSO NEGADO • " + Uid;
    LblBleStatusDetail->Font->Color = DeniedColor;

    TOccurrence Attempt;
    Attempt.OccurrenceType = L"Tentativa bloqueada RFID";
    Attempt.Description = Reason.IsEmpty()
        ? L"Tentativa de acesso por TAG RFID bloqueada."
        : Reason;
    Attempt.EmployeeName = Employee.Name;
    Attempt.EventDateTime =
        FormatDateTime(L"yyyy-mm-dd hh:nn:ss", Now());
    Attempt.Terminal = TerminalDisplayName();
    Attempt.Status = L"REGISTRADA";

    if (FAccessEventRepository != nullptr)
        FAccessEventRepository->AddOccurrence(Attempt);

    if (FObservabilityHeartbeat != nullptr)
    {
        FObservabilityHeartbeat->SendEvent(
            L"WARN",
            L"RFID_ACCESS_DENIED",
            L"Acesso negado por TAG RFID",
            Employee.Name,
            Reason.IsEmpty() ? Uid : Uid + L" • " + Reason,
            0.0);
    }

    LayoutTerminal();

    if (ReturnTimer != nullptr)
    {
        ReturnTimer->Enabled = false;
        ReturnTimer->Interval = 3500;
        ReturnTimer->Enabled = true;
    }
}

bool TMainForm::RecordRfidAccessEvent(
    const TEmployee& Employee,
    const UnicodeString& Uid)
{
    if (FAccessEventRepository == nullptr ||
        Employee.Id <= 0)
    {
        return false;
    }

    TAccessEvent Event;
    Event.EmployeeId = Employee.Id;
    Event.EmployeeName = Employee.Name;
    Event.Department = Employee.Department;
    Event.EventType = L"ENTRADA";
    Event.IdentificationMethod = L"RFID";
    Event.EventDateTime =
        FormatDateTime(L"yyyy-mm-dd hh:nn:ss", Now());
    Event.Terminal = TerminalDisplayName();
    Event.Status = L"RFID_AUTORIZADO";
    Event.RecognitionScore = 0.0;

    const bool Saved =
        FAccessEventRepository->Add(Event);

    if (!Saved)
    {
        OutputDebugStringW(
            (L"[RFID][PORTARIA] Falha ao registrar acesso RFID: " +
             Employee.Name + L" • UID " +
             Uid + L"\r\n").c_str());
    }

    return Saved;
}

void TMainForm::LoadPersistedSettings()
{
    try
    {
        const UnicodeString DataPath =
            TPath::Combine(ExtractFilePath(Application->ExeName), L"data");
        ForceDirectories(DataPath);

        const UnicodeString IniPath =
            TPath::Combine(DataPath, L"terminal.ini");

        if (!FileExists(IniPath))
            return;

        std::unique_ptr<TIniFile> Ini(new TIniFile(IniPath));

        FConfig.TerminalName =
            Ini->ReadString(L"Terminal", L"Name", FConfig.TerminalName);
        FConfig.ApiUrl =
            Ini->ReadString(L"ERP", L"ApiUrl", FConfig.ApiUrl);
        FConfig.DatabasePath =
            Ini->ReadString(L"Database", L"Employees", FConfig.DatabasePath);

        // v0.4 - a câmera escolhida pelo operador deve continuar sendo
        // a câmera operacional da tela principal, inclusive após reiniciar.
        FPreviewCameraIndex =
            Ini->ReadInteger(L"Camera", L"Index", FPreviewCameraIndex);

        if (FPreviewCameraIndex < 0 || FPreviewCameraIndex > 15)
            FPreviewCameraIndex = 0;
    }
    catch (...)
    {
        // Mantém os valores padrão se a configuração persistida falhar.
    }
}

void TMainForm::SavePersistedSettings()
{
    try
    {
        const UnicodeString DataPath =
            TPath::Combine(ExtractFilePath(Application->ExeName), L"data");
        ForceDirectories(DataPath);

        const UnicodeString IniPath =
            TPath::Combine(DataPath, L"terminal.ini");

        std::unique_ptr<TIniFile> Ini(new TIniFile(IniPath));
        Ini->WriteString(L"Terminal", L"Name", FConfig.TerminalName);
        Ini->WriteString(L"ERP", L"ApiUrl", FConfig.ApiUrl);
        Ini->WriteString(L"Database", L"Employees", FConfig.DatabasePath);
        Ini->WriteInteger(L"Camera", L"Index", FPreviewCameraIndex);
        Ini->UpdateFile();
    }
    catch (const Exception& E)
    {
        MessageDlg(
            L"Não foi possível salvar as configurações:\n" + E.Message,
            mtWarning,
            TMsgDlgButtons() << mbOK,
            0);
    }
}

void TMainForm::InitializeSettingsControls()
{
    const TColor CardColor = RgbColor(10, 20, 32);
    const TColor TextColor = RgbColor(224, 230, 238);
    const TColor Subtle = RgbColor(164, 176, 194);
    const TColor Green = RgbColor(41, 214, 132);

    if (FSettingsErpCard == nullptr)
    {
        FSettingsErpCard = new TPanel(DeveloperPanel);
        FSettingsErpCard->Parent = DeveloperPanel;
        FSettingsErpCard->BevelOuter = bvNone;
        FSettingsErpCard->Color = CardColor;
        FSettingsErpCard->Visible = false;

        FSettingsErpTitle = new TLabel(FSettingsErpCard);
        FSettingsErpTitle->Parent = FSettingsErpCard;
		FSettingsErpTitle->Caption = L"INTEGRAÇÃO ERP DELPHI";
        FSettingsErpTitle->Font->Name = L"Segoe UI Semibold";
        FSettingsErpTitle->Font->Size = 9;
        FSettingsErpTitle->Font->Color = TextColor;

        FSettingsErpStatus = new TLabel(FSettingsErpCard);
