        {
            LblDeveloperStatus->Caption =
                IntToStr(static_cast<int>(Present.size())) +
                L" funcionário(s) presente(s) identificado(s) hoje";
        }
    }
    __finally
    {
        LstEmployees->Items->EndUpdate();
