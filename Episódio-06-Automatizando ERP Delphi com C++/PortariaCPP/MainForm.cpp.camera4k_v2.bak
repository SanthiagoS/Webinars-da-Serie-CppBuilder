{
    if (FCameraSelectorLabel == nullptr)
    {
        FCameraSelectorLabel = new TLabel(DeveloperPanel);
        FCameraSelectorLabel->Parent = DeveloperPanel;
        FCameraSelectorLabel->AutoSize = false;
        FCameraSelectorLabel->Caption = L"Câmera de vídeo";
        FCameraSelectorLabel->Font->Name = L"Segoe UI Semibold";
        FCameraSelectorLabel->Font->Size = 10;
        FCameraSelectorLabel->Font->Color = RgbColor(170, 181, 194);
        FCameraSelectorLabel->Visible = false;
    }

    if (FCameraSelector == nullptr)
    {
        FCameraSelector = new TComboBox(DeveloperPanel);
        FCameraSelector->Parent = DeveloperPanel;
        FCameraSelector->Style = csDropDownList;
        FCameraSelector->Font->Name = L"Segoe UI";
        FCameraSelector->Font->Size = 11;

        // v0.4.1 - o VCL Style escuro estava aplicando fonte clara
        // sobre o fundo claro do dropdown. Mantemos somente a borda
        // estilizada e deixamos cor/fonte sob controle do componente.
        FCameraSelector->StyleElements =
            TStyleElements() << seBorder;
        FCameraSelector->Color = clWhite;
        FCameraSelector->Font->Color = clBlack;
        FCameraSelector->DropDownCount = 8;

        FCameraSelector->OnChange = CameraSelectorChange;
        FCameraSelector->Visible = false;
    }

    if (FCameraSettingsPreview == nullptr)
    {
        FCameraSettingsPreview = new TImage(DeveloperPanel);
        FCameraSettingsPreview->Parent = DeveloperPanel;
        FCameraSettingsPreview->Stretch = true;
        FCameraSettingsPreview->Proportional = true;
        FCameraSettingsPreview->Center = true;
        FCameraSettingsPreview->Visible = false;
    }
}

void TMainForm::RefreshCameraDeviceList()
{
    if (FCameraSelector == nullptr || FCameraManager == nullptr)
        return;

    const int PreviousIndex = FPreviewCameraIndex;
    const bool WasOpen = FCameraManager->IsOpen();

    if (WasOpen)
        StopCameraPreview();

    FCameraSelector->Items->BeginUpdate();
    try
    {
        FCameraSelector->Items->Clear();

        // IMPORTANTE:
        // O índice OpenCV NÃO indica se a câmera é nativa ou USB.
        // Em uma máquina a USB pode ser índice 0 e a integrada índice 1.
        // Portanto não tentamos mais adivinhar o tipo físico pelo índice.
        //
        // Também não basta Open() retornar true: alguns backends abrem o
        // dispositivo, mas não entregam frames. Só listamos índices que
        // realmente fornecem ao menos um frame.
        for (int CameraIndex = 0; CameraIndex < 6; ++CameraIndex)
        {
            std::unique_ptr<TCameraManager> Probe =
                std::make_unique<TCameraManager>();

            if (!Probe->Open(CameraIndex))
                continue;

            bool HasFrame = false;
            TCameraFrame ProbeFrame;

            for (int Attempt = 0; Attempt < 10; ++Attempt)
            {
                if (Probe->ReadFrame(ProbeFrame) && !ProbeFrame.Empty())
                {
                    HasFrame = true;
                    break;
                }

                ::Sleep(60);
            }

            Probe->Close();

            if (!HasFrame)
                continue;

            const UnicodeString Caption =
                L"Câmera " + IntToStr(CameraIndex) +
                L" (índice de vídeo)";

            const int ItemIndex =
                FCameraSelector->Items->AddObject(
                    Caption,
                    reinterpret_cast<TObject*>(
                        static_cast<NativeInt>(CameraIndex + 1)));

            if (CameraIndex == PreviousIndex)
                FCameraSelector->ItemIndex = ItemIndex;
        }

        if (FCameraSelector->Items->Count == 0)
        {
            FCameraSelector->Items->Add(L"Nenhuma câmera com vídeo encontrada");
            FCameraSelector->ItemIndex = 0;
            FCameraSelector->Enabled = false;
        }
        else
        {
            FCameraSelector->Enabled = true;

            if (FCameraSelector->ItemIndex < 0)
            {
                FCameraSelector->ItemIndex = 0;

                const NativeInt Value =
                    reinterpret_cast<NativeInt>(
                        FCameraSelector->Items->Objects[0]);

                FPreviewCameraIndex =
                    static_cast<int>(Value) - 1;
            }
        }
    }
    __finally
    {
        FCameraSelector->Items->EndUpdate();
    }

    FCameraListInitialized = true;

    // v1.0.1 - Recuperação da câmera após enumeração.
    // Se a abertura inicial ocorreu cedo demais (comum em execução sem debugger),
    // a enumeração pode localizar uma câmera operacional depois que o formulário
    // já está visível. Nesse caso também iniciamos o preview mesmo que WasOpen=false.
    if (FCameraSelector->Enabled)
    {
        ::Sleep(120);
        StartCameraPreview();
    }
}

bool TMainForm::SwitchCamera(int CameraIndex)
{
    if (FCameraManager == nullptr || CameraIndex < 0)
        return false;

    if (FEnrollmentActive)
    {
        MessageDlg(
            L"Cadastro de identificação facial em andamento.\n\n"
            L"Conclua a captura das 8 amostras antes de trocar a câmera.",
            mtInformation,
            TMsgDlgButtons() << mbOK,
            0);
        return false;
    }

    const int PreviousIndex = FPreviewCameraIndex;
    const bool WasOpen = FCameraManager->IsOpen();

    StopCameraPreview();
    FPreviewCameraIndex = CameraIndex;

    if (!WasOpen)
    {
        // Mesmo com a câmera previamente parada, validamos a câmera escolhida
        // antes de persistir o índice.
        StartCameraPreview();

        if (FCameraManager->IsOpen())
        {
            SavePersistedSettings();

            LblDeveloperStatus->Caption =
                L"Câmera " + IntToStr(CameraIndex) +
                L" selecionada. Preview operacional.";
            return true;
        }

        FPreviewCameraIndex = PreviousIndex;

        LblDeveloperStatus->Caption =
            L"A câmera " + IntToStr(CameraIndex) +
            L" não entregou vídeo.";
        return false;
    }

    StartCameraPreview();

    if (FCameraManager->IsOpen())
    {
        SavePersistedSettings();

        LblDeveloperStatus->Caption =
            L"Câmera " + IntToStr(CameraIndex) +
            L" selecionada. Preview operacional.";
        return true;
    }

    // A câmera abriu sem fornecer frames ou falhou por completo.
    // Restaura a fonte que estava ativa antes da troca.
    FPreviewCameraIndex = PreviousIndex;
    StartCameraPreview();

    if (FCameraSelector != nullptr)
    {
        for (int Item = 0; Item < FCameraSelector->Items->Count; ++Item)
        {
            const NativeInt Value =
                reinterpret_cast<NativeInt>(
                    FCameraSelector->Items->Objects[Item]);

            if ((static_cast<int>(Value) - 1) == PreviousIndex)
            {
                FCameraSelector->ItemIndex = Item;
                break;
            }
        }
    }

    MessageDlg(
        L"A câmera selecionada não entregou um frame de vídeo válido. "
        L"A câmera anterior foi restaurada.",
        mtWarning,
        TMsgDlgButtons() << mbOK,
        0);

    return false;
}

void __fastcall TMainForm::CameraSelectorChange(TObject *Sender)
{
    (void)Sender;

    if (FCameraSelector == nullptr ||
        FCameraSelector->ItemIndex < 0 ||
        !FCameraSelector->Enabled)
        return;

    const NativeInt Value =
        reinterpret_cast<NativeInt>(
            FCameraSelector->Items->Objects[
                FCameraSelector->ItemIndex]);

    const int CameraIndex = static_cast<int>(Value) - 1;

    if (CameraIndex == FPreviewCameraIndex)
        return;

    SwitchCamera(CameraIndex);
    RefreshIdentificationView();
}

void TMainForm::UpdateCameraSettingsPreview()
{
    if (FCurrentPage != TAccessPage::Camera ||
        FCameraSettingsPreview == nullptr ||
        FCameraPreviewBitmap == nullptr)
    {
        return;
    }

    if (!FCameraManager->IsOpen())
    {
        FCameraSettingsPreview->Picture->Assign(nullptr);
        return;
    }

    // Usa exatamente o mesmo bitmap que alimenta o preview principal,
    // sem abrir uma segunda instância da câmera.
    FCameraSettingsPreview->Picture->Assign(FCameraPreviewBitmap);
}

bool TMainForm::WaitForOperationalCameraFrame(int Attempts)
{
    if (FCameraManager == nullptr || !FCameraManager->IsOpen())
        return false;

    if (Attempts < 1)
        Attempts = 1;

    TCameraFrame Frame;

    for (int Attempt = 0; Attempt < Attempts; ++Attempt)
    {
        if (FCameraManager->ReadFrame(Frame) && !Frame.Empty())
        {
            // O primeiro frame confirma que não temos apenas um handle aberto:
            // existe fluxo de vídeo real vindo deste índice.
            return true;
        }

        ::Sleep(60);
    }

    return false;
}

void TMainForm::StartCameraPreview()
{
    if (FCameraManager == nullptr || FCameraPreviewTimer == nullptr)
    {
        return;
    }

    bool Opened = FCameraManager->IsOpen();
    const int RequestedIndex = FPreviewCameraIndex;

    auto TryOpenOperationalIndex = [this](int CameraIndex) -> bool
    {
        if (CameraIndex < 0)
            return false;

        if (FCameraManager->IsOpen())
            FCameraManager->Close();

        // Algumas webcams/Media Foundation precisam de um pequeno intervalo
        // depois do fechamento/probe anterior antes de reabrir o dispositivo.
        ::Sleep(120);

        if (!FCameraManager->Open(CameraIndex))
            return false;

        // Na execução sem debugger o processo chega aqui muito mais rápido.
        // O antigo tempo de aquecimento podia encerrar a câmera antes do
        // primeiro frame. Damos até ~1,5 s para o fluxo ficar operacional.
        if (!WaitForOperationalCameraFrame(25))
        {
            FCameraManager->Close();
            return false;
        }

        return true;
    };

    if (!Opened)
    {
        Opened = TryOpenOperationalIndex(RequestedIndex);

        // Se o índice persistido não estiver operacional nesta execução,
        // procuramos uma câmera que realmente entregue frames. Isso evita
        // depender do atraso introduzido pelo debugger para a webcam iniciar.
        if (!Opened)
        {
            for (int CameraIndex = 0; CameraIndex < 6 && !Opened; ++CameraIndex)
            {
                if (CameraIndex == RequestedIndex)
                    continue;

                if (TryOpenOperationalIndex(CameraIndex))
                {
                    FPreviewCameraIndex = CameraIndex;
                    Opened = true;

                    OutputDebugStringW(
                        (L"[CAMERA][RECOVERY] Índice " +
                         IntToStr(RequestedIndex) +
                         L" indisponível; usando índice " +
                         IntToStr(CameraIndex) + L"\r\n").c_str());

                    // O índice recuperado entregou vídeo real; preservamos para
                    // a próxima inicialização e sincronizamos o combo, se criado.
                    SavePersistedSettings();

                    if (FCameraSelector != nullptr)
                    {
                        for (int Item = 0; Item < FCameraSelector->Items->Count; ++Item)
                        {
                            const NativeInt Value =
                                reinterpret_cast<NativeInt>(
                                    FCameraSelector->Items->Objects[Item]);

                            if ((static_cast<int>(Value) - 1) == CameraIndex)
                            {
                                FCameraSelector->ItemIndex = Item;
                                break;
                            }
                        }
                    }
                }
            }
        }
    }

    if (Opened)
    {
        FPreviewFrameCounter = 0;
        ResetFacePreviewState();
    }

    FCameraPreviewTimer->Enabled = Opened;

    if (BtnStartCamera != nullptr)
    {
        BtnStartCamera->Caption =
            Opened ? L"Parar câmera" : L"Iniciar câmera";
    }

    if (LblCameraStatus != nullptr)
    {
        LblCameraStatus->Caption = Opened
            ? L"● Câmera ativa • índice " +
              IntToStr(FPreviewCameraIndex)
            : L"● Câmera indisponível";
    }

    UpdateCameraPreviewVisibility();
    RefreshIdentificationView();
}

void TMainForm::StopCameraPreview()
{
    if (FCameraPreviewTimer != nullptr)
    {
        FCameraPreviewTimer->Enabled = false;
    }

    if (FCameraSettingsPreview != nullptr)
    {
        FCameraSettingsPreview->Picture->Assign(nullptr);
    }

    if (FCameraManager != nullptr)
    {
        FCameraManager->Close();
    }

    if (FCameraPreviewImage != nullptr)
    {
        FCameraPreviewImage->Visible = false;
        FCameraPreviewImage->Picture->Bitmap->SetSize(0, 0);
    }

    if (BtnStartCamera != nullptr)
    {
        BtnStartCamera->Caption = L"Iniciar câmera";
    }

    if (FIdleVisualTimer != nullptr)
        FIdleVisualTimer->Enabled = false;

    if (FIdleVisual != nullptr)
        FIdleVisual->Visible = false;

    ResetFacePreviewState();
}

void TMainForm::UpdateCameraPreviewVisibility()
{
    static constexpr unsigned int IdleAnimationDelayMs = 1500;

    const bool CameraActive =
        FCameraManager != nullptr &&
        FCameraManager->IsOpen();

    const bool FacePresent =
        FHasPrimaryFace ||
        FHasMultipleOperationalFaces;

    const bool ShowingEmployee =
        EmployeeResultPanel != nullptr &&
        EmployeeResultPanel->Visible;

    // A câmera selecionada permanece visível sempre que estiver operacional.
    const bool ShowLiveCamera =
        CameraActive &&
        !ShowingEmployee;

    if (FCameraPreviewImage != nullptr)
    {
        FCameraPreviewImage->Visible = ShowLiveCamera;

        if (ShowLiveCamera)
            FCameraPreviewImage->SendToBack();
    }

    ShapeFaceFrame->Visible = false;

    // ---------------------------------------------------------
    // CÂMERA DESLIGADA / INDISPONÍVEL
    // ---------------------------------------------------------
    if (!CameraActive && !ShowingEmployee)
    {
        FNoFaceSinceTick = 0;

        if (FIdleVisual != nullptr)
            FIdleVisual->Visible = false;

        if (FIdleVisualTimer != nullptr)
            FIdleVisualTimer->Enabled = false;

        if (FIdleLottie != nullptr)
            FIdleLottie->Visible = false;

        LblFaceGlyph->Visible = true;
        LblFaceGlyph->Caption = L"CÂMERA INDISPONÍVEL";
        LblFaceGlyph->Font->Color = RgbColor(220, 72, 82);
        LblFaceGlyph->BringToFront();

        LblCameraPlaceholder->Visible = true;
        LblCameraPlaceholder->Caption =
            L"Verifique a configuração da câmera";
        LblCameraPlaceholder->BringToFront();

        return;
    }

    // ---------------------------------------------------------
    // FUNCIONÁRIO / RESULTADO
    // ---------------------------------------------------------
    if (ShowingEmployee)
    {
        FNoFaceSinceTick = 0;

        if (FIdleVisual != nullptr)
            FIdleVisual->Visible = false;

        if (FIdleVisualTimer != nullptr)
            FIdleVisualTimer->Enabled = false;

        if (FIdleLottie != nullptr)
            FIdleLottie->Visible = false;

        LblFaceGlyph->Visible = false;
        LblCameraPlaceholder->Visible = false;
        return;
    }

    // ---------------------------------------------------------
    // FACE PRESENTE
    // Qualquer detecção válida cancela IMEDIATAMENTE a animação.
    // ---------------------------------------------------------
    if (FacePresent ||
        FFacePreviewState == TFacePreviewState::Detected ||
        FFacePreviewState == TFacePreviewState::Recognizing ||
        FFacePreviewState == TFacePreviewState::Recognized ||
        FFacePreviewState == TFacePreviewState::Enrolling ||
        FFacePreviewState == TFacePreviewState::TooClose ||
        FFacePreviewState == TFacePreviewState::TooFar ||
        FFacePreviewState == TFacePreviewState::Multiple)
    {
        FNoFaceSinceTick = 0;

        if (FIdleVisual != nullptr)
            FIdleVisual->Visible = false;

        if (FIdleVisualTimer != nullptr)
            FIdleVisualTimer->Enabled = false;

        if (FIdleLottie != nullptr)
            FIdleLottie->Visible = false;

        // Sem textos grandes sobre o rosto.
        LblFaceGlyph->Caption = L"";
        LblCameraPlaceholder->Caption = L"";
        LblFaceGlyph->Visible = false;
        LblCameraPlaceholder->Visible = false;
        return;
    }

    // ---------------------------------------------------------
    // SEM FACE
    // Inicia contagem. Não mostra a animação imediatamente.
    // Isso elimina o pisca-pisca quando o YuNet perde 1 ou 2 frames.
    // ---------------------------------------------------------
    const unsigned int NowTick = GetTickCount();

    if (FNoFaceSinceTick == 0)
        FNoFaceSinceTick = NowTick;

    const unsigned int NoFaceElapsed =
        NowTick - FNoFaceSinceTick;

    const bool ShowIdleAnimation =
        CameraActive &&
        FFacePreviewState == TFacePreviewState::Waiting &&
        NoFaceElapsed >= IdleAnimationDelayMs;

    if (ShowIdleAnimation)
    {
        if (FIdleVisual != nullptr)
        {
            FIdleVisual->Visible = true;
            FIdleVisual->BringToFront();
            FIdleVisual->Invalidate();
        }

        if (FIdleVisualTimer != nullptr)
            FIdleVisualTimer->Enabled = true;

        // O visual TSX animado é o PaintBox.
        if (FIdleLottie != nullptr)
            FIdleLottie->Visible = false;

        // A animação em si já comunica aproximação.
        // Mantemos os textos centrais desligados para nunca cobrir o rosto.
        LblFaceGlyph->Caption = L"";
        LblCameraPlaceholder->Caption = L"";
        LblFaceGlyph->Visible = false;
        LblCameraPlaceholder->Visible = false;
    }
    else
    {
        if (FIdleVisual != nullptr)
            FIdleVisual->Visible = false;

        if (FIdleVisualTimer != nullptr)
            FIdleVisualTimer->Enabled = false;

        if (FIdleLottie != nullptr)
            FIdleLottie->Visible = false;

        LblFaceGlyph->Caption = L"";
        LblCameraPlaceholder->Caption = L"";
        LblFaceGlyph->Visible = false;
        LblCameraPlaceholder->Visible = false;
    }
}

void TMainForm::ResetFacePreviewState()
{
    FFacePreviewState = TFacePreviewState::Waiting;
    FFaceHitFrames = 0;
    FFaceMissFrames = 0;
    FSingleFaceFrames = 0;
    FMultipleFaceFrames = 0;
    FLastFaceDetections.clear();
    FCurrentFaceBounds = FaceRect();
    FSmoothedFaceDetection = FaceDetection();
    FHasCurrentFaceBounds = false;
    FHasSmoothedFaceDetection = false;
    FDetectionFramesThisSecond = 0;
    FLastDetectionMetricTick = GetTickCount();
    FMeasuredDetectionsPerSecond = 0.0;
    FLastRecognitionAttemptTick = 0;
    FRecognitionCandidateId = 0;
    FRecognitionCandidateHits = 0;
    FLastRecognitionResult = FaceRecognitionResult();
    FLastRecognitionDurationMs = 0.0;
    FEnrollmentActive = false;
    FEnrollmentEmployeeId = 0;
    FEnrollmentSamples.clear();
    FPrimaryFaceDetection = FaceDetection();
    FHasPrimaryFace = false;
    FHasMultipleOperationalFaces = false;
    FStableFaceStartTick = 0;
    FLastFaceSeenTick = 0;
    FNoFaceSinceTick = 0;
    FHadRecentFace = false;
    FIdentificationState = IdentificationState::WaitingForFace;
    FFaceQualityIssue = TFaceQualityIssue::None;
    FLastDistance = FaceDistance::NoFace;
    FPreviousDistance = FaceDistance::NoFace;
    FLastFaceBounds = cv::Rect();
    FLastFaceTime = std::chrono::steady_clock::time_point();
    FLastFaceRatio = 0.0;
    FPreviousFaceRatio = 0.0;
    FFaceRecognitionLocked = false;
    FRecognizedEmployeeId = 0;

    if (EmployeeResultPanel != nullptr)
    {
        EmployeeResultPanel->Visible = false;
    }

    if (FEmployeePhotoImage != nullptr)
    {
        FEmployeePhotoImage->Visible = false;
    }

    if (FRecognitionCheckShape != nullptr)
    {
        FRecognitionCheckShape->Visible = false;
    }
    if (FRecognitionCheckLabel != nullptr)
    {
        FRecognitionCheckLabel->Visible = false;
    }

    if (FLivenessDetector != nullptr)
    {
        FLivenessDetector->Reset();
    }
}

void TMainForm::UpdateFacePreviewState(const std::vector<FaceDetection>& Detections,
    int FrameWidth, int FrameHeight)
{
    // Um reconhecimento facial confirmado fica travado enquanto a pessoa
    // continuar diante da câmera. BLE ainda pode estar aguardando, portanto
    // não usamos HasCurrentEmployee() como trava.
    if (FFaceRecognitionLocked)
    {
        // v0.4.5 - resultados de acesso (FACE ou RFID) ficam visíveis pelo
        // tempo do ReturnTimer. A ausência do rosto não pode apagar o card
        // antes de o operador/funcionário conseguir ler o resultado.
        if (ReturnTimer != nullptr && ReturnTimer->Enabled)
        {
            if (!Detections.empty())
                FLastFaceDetections = Detections;

            return;
        }

        if (Detections.empty())
        {
            ++FFaceMissFrames;

            // Só libera o terminal depois de uma ausência consistente.
            // Com detecção a cada poucos frames, 8 misses evita reset por uma
            // simples perda momentânea do YuNet.
            if (FFaceMissFrames >= 8)
            {
                ClearRecognizedFaceResult();
            }
        }
        else
        {
            FFaceMissFrames = 0;
            FLastFaceDetections = Detections;
        }
        return;
    }

    const bool HoldNotRecognized =
        FFacePreviewState == TFacePreviewState::NotRecognized &&
        ReturnTimer != nullptr &&
        ReturnTimer->Enabled;

    if (HoldNotRecognized)
    {
        if (!Detections.empty())
        {
            FLastFaceDetections = Detections;
        }
        return;
    }

    const auto Now = std::chrono::steady_clock::now();
    const bool HasRecentFace = FHadRecentFace &&
        FLastFaceTime != std::chrono::steady_clock::time_point() &&
        std::chrono::duration_cast<std::chrono::milliseconds>(
            Now - FLastFaceTime).count() <= RecentFaceToleranceMs;

    if (Detections.empty())
    {
        FFaceHitFrames = 0;
        FSingleFaceFrames = 0;
        FMultipleFaceFrames = 0;
        ++FFaceMissFrames;
        FCurrentFaceBounds = FaceRect();
        FHasCurrentFaceBounds = false;
        FHasPrimaryFace = false;
        FPrimaryFaceDetection = FaceDetection();
        FStableFaceStartTick = 0;

        if (HasRecentFace)
        {
            const bool LastFaceWasLarge = FLastFaceRatio >= LargeFaceNearEdgeRatio;
            const bool LastFaceWasGrowing = FPreviousFaceRatio > 0.0 &&
                FLastFaceRatio >= FPreviousFaceRatio + GrowingFaceRatioDelta;
            const bool LastFaceNearEdge = IsFaceNearFrameEdge(FLastFaceBounds,
                FrameWidth, FrameHeight);

            if (FLastDistance == FaceDistance::TooClose || LastFaceWasLarge ||
                LastFaceWasGrowing || LastFaceNearEdge)
            {
                FLastDistance = FaceDistance::TooClose;
                FFacePreviewState = TFacePreviewState::TooClose;
            }
            else if (FLastDistance == FaceDistance::TooFar)
            {
                FFacePreviewState = TFacePreviewState::TooFar;
            }
            else if (FFacePreviewState == TFacePreviewState::Waiting)
            {
                FFacePreviewState = TFacePreviewState::Detected;
            }
            return;
        }

        if (FFaceMissFrames >= FaceMissingRequiredFrames)
        {
            FFacePreviewState = TFacePreviewState::Waiting;
            FIdentificationState = IdentificationState::WaitingForFace;
            FLastDistance = FaceDistance::NoFace;
            FHadRecentFace = false;
            FHasSmoothedFaceDetection = false;
            FLastFaceBounds = cv::Rect();
            FLastFaceRatio = 0.0;
            FPreviousFaceRatio = 0.0;
            FLastFaceDetections.clear();
        }
        return;
    }

    FFaceMissFrames = 0;
    ++FFaceHitFrames;
    FHadRecentFace = true;
    FLastFaceTime = Now;
    FLastFaceSeenTick = GetTickCount();

    // Face voltou: cancela imediatamente a contagem da animação ociosa.
    FNoFaceSinceTick = 0;

    if (Detections.size() > 1)
    {
        FSingleFaceFrames = 0;
        ++FMultipleFaceFrames;
        FHasMultipleOperationalFaces = true;
        FHasPrimaryFace = false;
        FPrimaryFaceDetection = FaceDetection();
        FStableFaceStartTick = 0;
        FIdentificationState = IdentificationState::Failed;
        if (FMultipleFaceFrames >= FaceDetectedRequiredFrames)
        {
            FFacePreviewState = TFacePreviewState::Multiple;
            FCurrentFaceBounds = FaceRect();
            FHasCurrentFaceBounds = false;
            FHasSmoothedFaceDetection = false;
        }
        return;
    }

    ++FSingleFaceFrames;
    FMultipleFaceFrames = 0;
    FHasMultipleOperationalFaces = false;

    const FaceDetection& NewDetection = Detections[0];
    FPrimaryFaceDetection = NewDetection;
    FHasPrimaryFace = true;
    if (!FHasSmoothedFaceDetection)
    {
        FSmoothedFaceDetection = NewDetection;
        FHasSmoothedFaceDetection = true;
    }
    else
    {
        const double Alpha = 0.5;
        FSmoothedFaceDetection.Bounds.X = static_cast<int>(std::round(
            Alpha * NewDetection.Bounds.X + (1.0 - Alpha) * FSmoothedFaceDetection.Bounds.X));
        FSmoothedFaceDetection.Bounds.Y = static_cast<int>(std::round(
            Alpha * NewDetection.Bounds.Y + (1.0 - Alpha) * FSmoothedFaceDetection.Bounds.Y));
        FSmoothedFaceDetection.Bounds.Width = static_cast<int>(std::round(
            Alpha * NewDetection.Bounds.Width + (1.0 - Alpha) * FSmoothedFaceDetection.Bounds.Width));
        FSmoothedFaceDetection.Bounds.Height = static_cast<int>(std::round(
            Alpha * NewDetection.Bounds.Height + (1.0 - Alpha) * FSmoothedFaceDetection.Bounds.Height));
        FSmoothedFaceDetection.Confidence = NewDetection.Confidence;
    }

    // IMPORTANTE: DrawDetections() usa DetectionBounds, enquanto a suavizacao
    // acima atualizava somente Bounds. Isso fazia o retangulo visual ficar
    // preso/deslocado em relacao ao rosto real. Mantemos ambos sincronizados.
    FSmoothedFaceDetection.DetectionBounds = FSmoothedFaceDetection.Bounds;

    FPreviousFaceRatio = FLastFaceRatio;
    FPreviousDistance = FLastDistance;
    FLastFaceRatio = CalculateFaceRatio(FSmoothedFaceDetection.Bounds,
        FrameWidth, FrameHeight);
    FLastDistance = ClassifyFaceDistance(FSmoothedFaceDetection.Bounds,
        FrameWidth, FrameHeight, FPreviousDistance);
    FLastFaceBounds = ToCvRect(FSmoothedFaceDetection.Bounds);

    FLastFaceDetections.clear();
    FLastFaceDetections.push_back(FSmoothedFaceDetection);

    if (FLastDistance == FaceDistance::TooClose)
    {
        FFacePreviewState = TFacePreviewState::TooClose;
        FIdentificationState = IdentificationState::AdjustDistance;
        FCurrentFaceBounds = FaceRect();
        FHasCurrentFaceBounds = false;
        FStableFaceStartTick = 0;
        return;
    }

    if (FLastDistance == FaceDistance::TooFar)
    {
        FFacePreviewState = TFacePreviewState::TooFar;
        FIdentificationState = IdentificationState::AdjustDistance;
        FCurrentFaceBounds = FaceRect();
        FHasCurrentFaceBounds = false;
        FStableFaceStartTick = 0;
        return;
    }

    if (FSingleFaceFrames >= FaceDetectedRequiredFrames)
    {
        const unsigned int NowTick = GetTickCount();
        if (FStableFaceStartTick == 0)
        {
            FStableFaceStartTick = NowTick;
        }

        FCurrentFaceBounds = FSmoothedFaceDetection.Bounds;
        FHasCurrentFaceBounds = true;
        if (NowTick - FStableFaceStartTick >= 250)
        {
            FFacePreviewState = TFacePreviewState::Detected;
            FIdentificationState = IdentificationState::ReadyForRecognition;
        }
        else
        {
            FFacePreviewState = TFacePreviewState::Detected;
            FIdentificationState = IdentificationState::Stabilizing;
        }
    }
}

void TMainForm::ApplyFacePreviewStatus()
{
    const TColor WaitingColor = RgbColor(245, 190, 79);
    const TColor DetectedColor = RgbColor(41, 214, 132);
    const TColor MultipleColor = RgbColor(245, 190, 79);

    UnicodeString FaceCaption = L"FACE";
    UnicodeString FaceDetail = L"● Aguardando";
    UnicodeString Prompt = L"Aproxime-se para identificação";
    TColor FaceColor = WaitingColor;

    if (FFacePreviewState == TFacePreviewState::TooFar)
    {
        FaceDetail = L"● Muito distante";
        Prompt = L"Aproxime-se um pouco";
        FaceColor = WaitingColor;
    }
    else if (FFacePreviewState == TFacePreviewState::Detected)
    {
        FaceDetail = L"● Detectada";
        Prompt = FIdentificationState == IdentificationState::ReadyForRecognition
            ? L"Pronto para reconhecimento"
            : L"Aguardando estabilidade da face";
        FaceColor = DetectedColor;

        if (FIdentificationState == IdentificationState::ReadyForRecognition)
        {
            if (FFaceQualityIssue == TFaceQualityIssue::LowLight)
            {
                FaceDetail = L"● Pouca iluminação";
                Prompt = L"Iluminação insuficiente • aumente a iluminação sobre o rosto";
                FaceColor = WaitingColor;
            }
            else if (FFaceQualityIssue == TFaceQualityIssue::Blurred)
            {
                FaceDetail = L"● Imagem sem nitidez";
                Prompt = L"Mantenha-se imóvel por um instante";
                FaceColor = WaitingColor;
            }
        }
    }
    else if (FFacePreviewState == TFacePreviewState::TooClose)
    {
        FaceDetail = L"● Muito próxima";
        Prompt = L"Afaste-se um pouco";
        FaceColor = WaitingColor;
    }
    else if (FFacePreviewState == TFacePreviewState::Multiple)
    {
        FaceDetail = L"● Múltiplas pessoas";
        Prompt = L"Mantenha apenas uma pessoa diante da câmera";
        FaceColor = MultipleColor;
    }
    else if (FFacePreviewState == TFacePreviewState::Recognizing)
    {
        FaceDetail = L"● Detectada";
        Prompt = L"Identificando funcionário...";
        FaceColor = DetectedColor;
    }
    else if (FFacePreviewState == TFacePreviewState::Recognized)
    {
        FaceDetail = L"● Confirmada";
        Prompt = L"Acesso autorizado por identificação facial";
        FaceColor = DetectedColor;
    }
    else if (FFacePreviewState == TFacePreviewState::NotRecognized)
    {
        FaceDetail = L"● Não reconhecida";
        Prompt = L"Pessoa não reconhecida";
        FaceColor = RgbColor(210, 82, 92);
    }
    else if (FFacePreviewState == TFacePreviewState::Enrolling)
    {
        const int EnrollmentCount =
            static_cast<int>(FEnrollmentSamples.size());

        FaceDetail =
            L"● Cadastro " +
            IntToStr(EnrollmentCount) +
            L"/" +
            IntToStr(FaceEnrollmentRequiredSamples);

        const UnicodeString EnrollmentName =
            !FRemoteEnrollmentEmployeeName.IsEmpty()
                ? FRemoteEnrollmentEmployeeName
                : L"funcionário selecionado";

        Prompt =
            L"Cadastrando identificação facial • " +
            EnrollmentName +
            L" • " +
            IntToStr(EnrollmentCount) +
            L"/" +
            IntToStr(FaceEnrollmentRequiredSamples);

        FaceColor = DetectedColor;

        if (FFaceQualityIssue == TFaceQualityIssue::LowLight)
        {
            Prompt =
                L"Iluminação insuficiente • aumente a iluminação para continuar • " +
                IntToStr(EnrollmentCount) +
                L"/" +
                IntToStr(FaceEnrollmentRequiredSamples);
            FaceColor = WaitingColor;
        }
        else if (FFaceQualityIssue == TFaceQualityIssue::Blurred)
        {
            Prompt =
                L"Mantenha-se imóvel para continuar o cadastro • " +
                IntToStr(EnrollmentCount) +
                L"/" +
                IntToStr(FaceEnrollmentRequiredSamples);
            FaceColor = WaitingColor;
        }
    }

    // Se o resultado atual veio do RFID, a identificação facial não participou
    // da decisão. Não exibir "Não reconhecida" em vermelho nesse intervalo,
    // pois isso sugere uma falha embora o acesso RFID já tenha sido decidido.
    const bool RfidResultVisible =
        FFaceRecognitionLocked &&
        ReturnTimer != nullptr &&
        ReturnTimer->Enabled &&
        (FLastRfidState == TRfidVisualState::Authorized ||
         FLastRfidState == TRfidVisualState::Denied);

    if (RfidResultVisible)
    {
        FaceDetail = L"○ Não utilizada";
        FaceColor = RgbColor(164, 176, 194);
    }

    LblFaceIndicator->Caption = FaceCaption;
    LblFaceStatusDetail->Caption = FaceDetail;
    LblFaceIndicator->Font->Color = RgbColor(164, 176, 194);
    LblFaceStatusDetail->Font->Color = FaceColor;

    ApplyRfidStatus();

    if (!FFaceRecognitionLocked &&
        !FIdentificationManager->HasCurrentEmployee())
    {
        LblPrompt->Caption = Prompt;
        LblPrompt->Font->Color = FaceColor;
    }
}

void TMainForm::UpdateDetectionMetrics()
{
    ++FDetectionFramesThisSecond;
    const unsigned int NowTick = GetTickCount();
    const unsigned int Elapsed = NowTick - FLastDetectionMetricTick;
    if (Elapsed >= 1000)
    {
        FMeasuredDetectionsPerSecond =
            (static_cast<double>(FDetectionFramesThisSecond) * 1000.0) / Elapsed;
        FDetectionFramesThisSecond = 0;
        FLastDetectionMetricTick = NowTick;
    }
}

void TMainForm::RefreshEmployeeList()
{
    FEmployees.clear();
    LstEmployees->Items->BeginUpdate();
    try
    {
        LstEmployees->Items->Clear();
        if (FEmployeeRepository != nullptr)
        {
            FEmployees = FEmployeeRepository->GetAll();
        }

        for (const TEmployee& Employee : FEmployees)
        {
            LstEmployees->Items->Add(Format(L"%d - %s (%s)",
                ARRAYOFCONST((Employee.Id, Employee.Name, Employee.Department))));
        }

        if (!FEmployees.empty())
        {
            LstEmployees->ItemIndex = 0;
            LblDeveloperStatus->Caption = Format(L"%d funcionário(s) disponíveis. Selecione um registro para cadastrar a identificação facial.",
                ARRAYOFCONST((static_cast<int>(FEmployees.size()))));
        }
        else
        {
            LblDeveloperStatus->Caption = L"Nenhum funcionário disponível. Verifique a sincronização com o ERP Delphi.";
        }
    }
    __finally
    {
        LstEmployees->Items->EndUpdate();
    }
}


void TMainForm::ReconfigureEmployeeSync()
{
    if (FEmployeeSyncClient != nullptr)
    {
        FEmployeeSyncClient->Stop();
        FEmployeeSyncClient.reset();
    }

    if (FEmployeeRepository == nullptr)
        return;

    FEmployeeSyncClient =
        std::make_unique<TEmployeeSyncClient>(
            FEmployeeRepository.get(),
            FConfig.ApiUrl);

    FEmployeeSyncStateInitialized = false;
    FLastEmployeeSyncOnline = false;
    FLastEmployeeSyncCount = -1;

    FEmployeeSyncClient->Start();
}

void TMainForm::ProcessEmployeeSyncStatus()
{
    if (FEmployeeSyncClient == nullptr)
        return;

    TEmployeeSyncStatus Status;

    if (!FEmployeeSyncClient->TryConsumeStatus(
            Status))
    {
        return;
    }

    const bool Changed =
        !FEmployeeSyncStateInitialized ||
        FLastEmployeeSyncOnline != Status.Success ||
        (Status.Success &&
         FLastEmployeeSyncCount != Status.EmployeeCount);

    FEmployeeSyncStateInitialized = true;
    FLastEmployeeSyncOnline = Status.Success;

    if (Status.Success)
    {
        FLastEmployeeSyncCount = Status.EmployeeCount;

        // v0.4.5 - ERP é a fonte oficial dos funcionários.
        // Remove TAGs locais que ficaram órfãs depois de uma exclusão no ERP.
        ReconcileRfidAssignments();
    }

    if (Changed &&
        FObservabilityHeartbeat != nullptr)
    {
        FObservabilityHeartbeat->SendEvent(
            Status.Success ? L"SUCCESS" : L"WARN",
            L"EMPLOYEE_SYNC",
            Status.Success
                ? L"Funcionários sincronizados do ERP Delphi"
                : L"Falha na sincronização de funcionários do ERP Delphi",
            L"",
            Status.Success
                ? IntToStr(Status.EmployeeCount) + L" funcionário(s)"
                : Status.Message,
            0.0);
    }

    // Não mexe na tela de câmera/identificação.
    // Atualiza somente telas administrativas quando necessário.
    if (FCurrentPage == TAccessPage::Settings)
    {
        RefreshSettingsView();
    }
    else if (Status.Success &&
             FCurrentPage == TAccessPage::ManualRelease)
    {
        RefreshManualReleaseEmployees();
    }
    else if (Status.Success &&
             FCurrentPage == TAccessPage::BleDevices)
    {
        RefreshRfidTagEmployees();
    }
    else if (Status.Success &&
             FCurrentPage == TAccessPage::Incidents)
    {
        RefreshOccurrenceEmployees();
    }
}


void TMainForm::ReconcileRfidAssignments()
{
    if (FAccessEventRepository == nullptr ||
        FEmployeeRepository == nullptr ||
        !FEmployeeRepository->HasRemoteSnapshot())
    {
        return;
    }

    const std::vector<TRfidTagAssignment> Tags =
        FAccessEventRepository->GetRfidTags();

    int RemovedCount = 0;

    for (const TRfidTagAssignment& Tag : Tags)
    {
        if (!Tag.Active || Tag.EmployeeId <= 0)
            continue;

        TEmployee Employee;
        const bool EmployeeFound =
            FEmployeeRepository->FindById(
                Tag.EmployeeId, Employee) &&
            Employee.Id > 0;

        const bool IdentityMatches =
            EmployeeFound &&
            RfidIdentityMatches(
                Tag.IdentityKey,
                Employee);

        if (IdentityMatches)
            continue;

        if (!FAccessEventRepository->RemoveRfidTag(Tag.EmployeeId))
            continue;

        ++RemovedCount;

        if (SameText(FLastRfidUid, Tag.TagUid))
        {
            FLastRfidUid = UnicodeString();
            FLastRfidState = TRfidVisualState::Idle;
        }

        if (FObservabilityHeartbeat != nullptr)
        {
            FObservabilityHeartbeat->SendEvent(
                L"WARN",
                L"RFID_ORPHAN_TAG_REMOVED",
                L"Vínculo RFID órfão removido após sincronização do ERP",
                L"",
                Tag.TagUid,
                0.0);
        }
    }

    if (RemovedCount > 0)
    {
        OutputDebugStringW(
            (L"[RFID][PORTARIA] " +
             IntToStr(RemovedCount) +
             L" vínculo(s) RFID órfão(s) removido(s).\\r\\n").c_str());

        ApplyRfidStatus();
    }
}


void TMainForm::RecordFaceAccessEvent(const TEmployee& Employee, double Score)
{
    if (FAccessEventRepository == nullptr || Employee.Id <= 0)
    {
        return;
    }

    TAccessEvent Event;
    Event.EmployeeId = Employee.Id;
    Event.EmployeeName = Employee.Name;
    Event.Department = Employee.Department;
    Event.EventType = L"ENTRADA";
    Event.IdentificationMethod = L"FACE";
    Event.EventDateTime = FormatDateTime(L"yyyy-mm-dd hh:nn:ss", Now());
    Event.Terminal = TerminalDisplayName();
    Event.Status = L"FACE_AUTORIZADA";
    Event.RecognitionScore = Score;

    if (!FAccessEventRepository->Add(Event))
    {
        OutputDebugStringW(
            L"[MainForm] Falha ao registrar evento de acesso.\r\n");
    }
}

void TMainForm::RefreshRecentEntries()
{
    if (LstEmployees == nullptr)
    {
        return;
    }

    LstEmployees->Items->BeginUpdate();
    try
    {
        LstEmployees->Items->Clear();

        if (FAccessEventRepository == nullptr)
        {
            LblDeveloperStatus->Caption =
                L"Histórico de acessos indisponível.";
            return;
        }

        const std::vector<TAccessEvent> Events =
            FAccessEventRepository->GetRecent(30);

        for (const TAccessEvent& Event : Events)
        {
            UnicodeString StatusText = Event.Status;

            if (Event.Status == L"FACE_AUTORIZADA")
            {
                StatusText = L"Acesso autorizado • identificação facial";
            }
            else if (Event.Status == L"FACE_CONFIRMADA_BLE_PENDENTE")
            {
                // Compatibilidade com registros antigos.
                StatusText = L"Identificação facial confirmada (legado)";
            }
            else if (Event.Status == L"LIBERACAO_MANUAL")
            {
                StatusText = L"Liberação manual";
            }

            // A data completa já aparece no cabeçalho da página. Na lista
            // exibimos hora + funcionário + setor + fatores, evitando linhas
            // gigantes que eram cortadas visualmente.
            UnicodeString DisplayTime = Event.EventDateTime;
            if (DisplayTime.Length() >= 19)
            {
                DisplayTime = DisplayTime.SubString(12, 8);
            }

            UnicodeString Line =
                DisplayTime + L"   " + Event.EmployeeName;

            if (!Event.Department.IsEmpty())
            {
                Line += L"  •  " + Event.Department;
            }

            Line += L"  •  " + Event.IdentificationMethod +
                L"  •  " + StatusText;

            LstEmployees->Items->Add(Line);
        }

        if (Events.empty())
        {
            LblDeveloperStatus->Caption =
                L"Nenhum acesso registrado ainda.";
        }
        else
        {
            LblDeveloperStatus->Caption =
                IntToStr(static_cast<int>(Events.size())) +
                L" evento(s) recente(s) • access.s3db";
        }
    }
    __finally
    {
        LstEmployees->Items->EndUpdate();
    }
}

void TMainForm::RefreshPresentEmployees()
{
