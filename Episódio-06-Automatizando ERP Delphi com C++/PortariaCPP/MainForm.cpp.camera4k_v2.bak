void __fastcall TMainForm::HeaderDecorPaint(TObject* Sender)
{
    (void)Sender;

    if (FHeaderDecor == nullptr)
        return;

    TCanvas* C = FHeaderDecor->Canvas;
    const int W = FHeaderDecor->ClientWidth;
    const int H = FHeaderDecor->ClientHeight;

    C->Brush->Style = bsSolid;
    C->Brush->Color = RgbColor(2, 7, 12);
    C->FillRect(TRect(0, 0, W, H));

    // Linha inferior azul, com acento vermelho sob a marca TSX.
    C->Pen->Style = psSolid;
    C->Pen->Width = 1;
    C->Pen->Color = RgbColor(10, 54, 86);
    C->MoveTo(0, H - 2);
    C->LineTo(W, H - 2);

    C->Pen->Width = 2;
    C->Pen->Color = RgbColor(210, 24, 40);
    C->MoveTo(22, H - 3);
    C->LineTo(188, H - 3);

    // Cantos tecnológicos laterais.
    C->Pen->Width = 1;
    C->Pen->Color = RgbColor(18, 105, 170);

    C->MoveTo(8, 10); C->LineTo(8, 25); C->LineTo(18, 25);
    C->MoveTo(W - 8, 10); C->LineTo(W - 8, 25); C->LineTo(W - 18, 25);

    // Trilhos angulares: aparência de painel físico.
    C->Pen->Style = psSolid;
    C->Pen->Width = 1;
    C->Pen->Color = RgbColor(12, 69, 108);

    C->MoveTo(218, H - 3);
    C->LineTo(252, H - 3);
    C->LineTo(266, H - 17);
    C->LineTo(std::max(280, W / 2 - 92), H - 17);

    C->MoveTo(W - 218, H - 3);
    C->LineTo(W - 252, H - 3);
    C->LineTo(W - 266, H - 17);
    C->LineTo(std::min(W - 280, W / 2 + 92), H - 17);

    C->Pen->Style = psClear;
    C->Brush->Style = bsSolid;
    C->Brush->Color = RgbColor(24, 122, 190);
    C->Ellipse(205, H - 7, 209, H - 3);
    C->Ellipse(W - 209, H - 7, W - 205, H - 3);
}

void __fastcall TMainForm::CameraDecorPaint(TObject* Sender)
{
    (void)Sender;

    if (FCameraDecor == nullptr)
        return;

    TCanvas* C = FCameraDecor->Canvas;
    const int W = FCameraDecor->ClientWidth;
    const int H = FCameraDecor->ClientHeight;

    C->Brush->Style = bsClear;
    C->Pen->Style = psSolid;
    C->Pen->Width = 2;
    C->Pen->Color = RgbColor(27, 132, 215);

    const int M = 8;
    const int L = 24;

    // Quatro "brackets" nos cantos do card, sem cobrir a imagem.
    C->MoveTo(M, M + L); C->LineTo(M, M); C->LineTo(M + L, M);
    C->MoveTo(W - M - L, M); C->LineTo(W - M, M); C->LineTo(W - M, M + L);

    C->MoveTo(M, H - M - L); C->LineTo(M, H - M); C->LineTo(M + L, H - M);
    C->MoveTo(W - M - L, H - M); C->LineTo(W - M, H - M); C->LineTo(W - M, H - M - L);

    // Linha inferior ciano bem discreta.
    C->Pen->Width = 1;
    C->Pen->Color = RgbColor(13, 72, 116);
    C->MoveTo(W / 4, H - 5);
    C->LineTo((W * 3) / 4, H - 5);

    // Micro detalhes tecnológicos laterais.
    C->Pen->Style = psSolid;
    C->Pen->Width = 1;
    C->Pen->Color = RgbColor(12, 84, 137);

    C->MoveTo(4, H / 2 - 30);
    C->LineTo(4, H / 2 + 30);

    C->MoveTo(W - 4, H / 2 - 30);
    C->LineTo(W - 4, H / 2 + 30);

    C->Pen->Color = RgbColor(31, 151, 232);
    C->MoveTo(W / 2 - 38, 4);
    C->LineTo(W / 2 + 38, 4);

    C->MoveTo(W / 2 - 52, H - 4);
    C->LineTo(W / 2 + 52, H - 4);
}

void __fastcall TMainForm::FooterDecorPaint(TObject* Sender)
{
    (void)Sender;

    if (FFooterDecor == nullptr)
        return;

    TCanvas* C = FFooterDecor->Canvas;
    const int W = FFooterDecor->ClientWidth;
    const int H = FFooterDecor->ClientHeight;
    const int CX = W / 2;

    C->Brush->Style = bsSolid;
    C->Brush->Color = RgbColor(82, 4, 16);
    C->FillRect(TRect(0, 0, W, H));

    // Trilhos vermelhos convergindo para o MENU.
    C->Pen->Style = psSolid;
    C->Pen->Width = 2;
    C->Pen->Color = RgbColor(198, 22, 38);

    C->MoveTo(0, 8);
    C->LineTo(CX - 116, 8);
    C->LineTo(CX - 96, 22);

    C->MoveTo(W, 8);
    C->LineTo(CX + 116, 8);
    C->LineTo(CX + 96, 22);

    // Linha ciano de acabamento sob a faixa vermelha.
    C->Pen->Width = 1;
    C->Pen->Color = RgbColor(18, 73, 112);
    C->MoveTo(18, H - 5);
    C->LineTo(W - 18, H - 5);

    // Segunda camada de profundidade abaixo do botão.
    C->Pen->Style = psSolid;
    C->Pen->Width = 1;
    C->Pen->Color = RgbColor(116, 8, 25);

    C->MoveTo(0, H - 17);
    C->LineTo(CX - 126, H - 17);
    C->LineTo(CX - 106, H - 30);

    C->MoveTo(W, H - 17);
    C->LineTo(CX + 126, H - 17);
    C->LineTo(CX + 106, H - 30);
}


void TMainForm::InitializeIdleVisual()
{
    if (FIdleVisual == nullptr)
    {
        FIdleVisual = new TPaintBox(CameraPanel);
        FIdleVisual->Parent = CameraPanel;
        FIdleVisual->Align = alNone;
        FIdleVisual->Visible = false;
        FIdleVisual->Enabled = false;
        FIdleVisual->OnPaint = IdleVisualPaint;
    }

    if (FIdleVisualTimer == nullptr)
    {
        FIdleVisualTimer = new TTimer(this);
        FIdleVisualTimer->Enabled = false;
        FIdleVisualTimer->Interval = 90;
        FIdleVisualTimer->OnTimer = IdleVisualTimerTimer;
    }
}

void __fastcall TMainForm::IdleVisualTimerTimer(TObject* Sender)
{
    (void)Sender;

    FIdleVisualPhase = (FIdleVisualPhase + 1) % 30;

    if (FIdleVisual != nullptr && FIdleVisual->Visible)
    {
        FIdleVisual->Invalidate();
    }
}

void __fastcall TMainForm::IdleVisualPaint(TObject* Sender)
{
    (void)Sender;

    if (FIdleVisual == nullptr)
        return;

    TCanvas* C = FIdleVisual->Canvas;
    const int W = FIdleVisual->ClientWidth;
    const int H = FIdleVisual->ClientHeight;
    const int CX = W / 2;
    const int CY = H / 2 - 24;

    // Não pintamos fundo sólido: o card tecnológico permanece visível.
    C->Brush->Style = bsClear;

    // Pulso/radar suave ao redor do usuário.
    const int Pulse = (FIdleVisualPhase % 10) * 3;

    C->Pen->Style = psSolid;
    C->Pen->Width = 1;
    C->Pen->Color = RgbColor(10, 54, 88);

    C->Ellipse(
        CX - 90 - Pulse,
        CY - 90 - Pulse,
        CX + 90 + Pulse,
        CY + 90 + Pulse);

    C->Pen->Color = RgbColor(12, 75, 122);
    C->Ellipse(
        CX - 62 - (Pulse / 2),
        CY - 62 - (Pulse / 2),
        CX + 62 + (Pulse / 2),
        CY + 62 + (Pulse / 2));

    // Silhueta minimalista.
    C->Pen->Width = 2;
    C->Pen->Color = RgbColor(44, 156, 238);

    C->Ellipse(CX - 24, CY - 76, CX + 24, CY - 28);

    C->MoveTo(CX - 42, CY + 44);
    C->LineTo(CX - 36, CY - 2);
    C->LineTo(CX - 18, CY - 24);

    C->MoveTo(CX + 42, CY + 44);
    C->LineTo(CX + 36, CY - 2);
    C->LineTo(CX + 18, CY - 24);

    C->MoveTo(CX - 42, CY + 44);
    C->LineTo(CX + 42, CY + 44);

    // Cantos de enquadramento facial.
    C->Pen->Width = 2;
    C->Pen->Color = RgbColor(26, 123, 205);
    const int BoxW = 150;
    const int BoxH = 190;
    const int BX = CX - (BoxW / 2);
    const int BY = CY - 96;
    const int Corner = 22;

    C->MoveTo(BX, BY + Corner); C->LineTo(BX, BY); C->LineTo(BX + Corner, BY);
    C->MoveTo(BX + BoxW - Corner, BY); C->LineTo(BX + BoxW, BY); C->LineTo(BX + BoxW, BY + Corner);
    C->MoveTo(BX, BY + BoxH - Corner); C->LineTo(BX, BY + BoxH); C->LineTo(BX + Corner, BY + BoxH);
    C->MoveTo(BX + BoxW - Corner, BY + BoxH); C->LineTo(BX + BoxW, BY + BoxH); C->LineTo(BX + BoxW, BY + BoxH - Corner);

    // Setas ascendentes animadas.
    const int ArrowBaseY = CY + 112;
    for (int I = 0; I < 3; ++I)
    {
        const int Shift = ((FIdleVisualPhase * 3) + (I * 22)) % 66;
        const int Y = ArrowBaseY - Shift;

        C->Pen->Width = 3;
        C->Pen->Color =
            I == 0 ? RgbColor(54, 183, 255) :
            I == 1 ? RgbColor(28, 132, 221) :
                     RgbColor(14, 83, 145);

        C->MoveTo(CX - 24, Y);
        C->LineTo(CX, Y - 18);
        C->LineTo(CX + 24, Y);
    }

    // Linha inferior "scanner".
    C->Pen->Width = 1;
    C->Pen->Color = RgbColor(20, 102, 166);
    const int ScanX = 40 + ((FIdleVisualPhase * 17) % std::max(1, W - 80));
    C->MoveTo(std::max(18, ScanX - 70), H - 24);
    C->LineTo(std::min(W - 18, ScanX + 70), H - 24);
}

