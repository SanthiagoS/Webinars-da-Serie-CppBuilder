void TMainForm::InitializeIdleAnimation()
{
    if (FIdleLottie != nullptr)
    {
        return;
    }

    FIdleLottie = new TSkAnimatedImage(CameraPanel);
    FIdleLottie->Parent = CameraPanel;

    FIdleLottie->Align = alNone;
    FIdleLottie->Visible = false;

    // Mantém a animação proporcional dentro da área definida.
    FIdleLottie->WrapMode =
        TSkAnimatedImageWrapMode::Fit;

    // A animação deve ficar acima do fundo,
    // mas abaixo dos textos APROXIME-SE.
