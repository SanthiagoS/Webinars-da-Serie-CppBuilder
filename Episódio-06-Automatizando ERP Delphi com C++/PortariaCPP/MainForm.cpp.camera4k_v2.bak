    void QueueRevokeResultForRetry(
        const UnicodeString& RequestId,
        const UnicodeString& Status,
        const UnicodeString& Message)
    {
        GPendingRevokeResultRetry.Active = true;
        GPendingRevokeResultRetry.RequestId = RequestId;
        GPendingRevokeResultRetry.Status = Status;
        GPendingRevokeResultRetry.Message = Message;
    }

    void SendRevokeResultToErp(
        const UnicodeString& RequestId,
        const UnicodeString& Status,
        const UnicodeString& Message)
    {
        if (Trim(RequestId).IsEmpty())
            return;

        if (!SendDirectRevokeResult(
                RequestId,
                Status,
                Message))
        {
            QueueRevokeResultForRetry(
                RequestId,
                Status,
                Message);
        }
    }

    bool FlushPendingRevokeResultToErp()
    {
        if (!GPendingRevokeResultRetry.Active)
            return true;

        if (SendDirectRevokeResult(
                GPendingRevokeResultRetry.RequestId,
                GPendingRevokeResultRetry.Status,
                GPendingRevokeResultRetry.Message))
        {
            GPendingRevokeResultRetry =
                TPendingRevokeResultRetry();

            return true;
        }

        // v0.7.4.3:
        // Se o ERP reiniciar, o estado em memória do requestId anterior pode
        // desaparecer. Nesse cenário um retry antigo receberá 404 para sempre.
        //
        // Antes de bloquear novas remoções, consultamos o comando atualmente
        // pendente no ERP. Se existir outro requestId, o retry local anterior
        // ficou obsoleto e pode ser descartado com segurança.
        TErpRevokeCommand CurrentCommand;

        if (TryGetPendingRevokeFromErp(CurrentCommand) &&
            CurrentCommand.Pending &&
            !SameText(
                Trim(CurrentCommand.RequestId),
                Trim(GPendingRevokeResultRetry.RequestId)))
        {
            OutputDebugStringW(
                (L"[REVOKE][ERP3101] Retry obsoleto descartado. antigo=" +
                 GPendingRevokeResultRetry.RequestId +
                 L" atual=" +
                 CurrentCommand.RequestId +
                 L"\r\n").c_str());

            GPendingRevokeResultRetry =
                TPendingRevokeResultRetry();

            // Retorna true para que ProcessPendingBiometricCommands()
            // possa consumir imediatamente o novo /revoke/pending.
            return true;
        }

        // Mesmo request ainda pendente ou ERP indisponível:
        // preserva o retry e tenta novamente no próximo ciclo.
        return false;
    }

    std::string ToStdString(const UnicodeString& Value)
    {
        return AnsiString(Value).c_str();
    }

    UnicodeString BuildRfidFallbackIdentityKey(
        const TEmployee& Employee)
    {
        // O RFID precisa funcionar mesmo para funcionários que ainda não
        // possuem FaceKey. O fallback usa ID + nome normalizado para não
        // depender do cadastro de identificação facial.
        UnicodeString NormalizedName =
            LowerCase(Trim(Employee.Name));

        NormalizedName = StringReplace(
            NormalizedName,
            L"|",
            L" ",
            TReplaceFlags() << rfReplaceAll);

        return L"RFIDEMP|" +
            IntToStr(Employee.Id) +
            L"|" +
            NormalizedName;
    }

    UnicodeString BuildRfidIdentityKey(
        const TEmployee& Employee)
    {
        const UnicodeString FaceKey =
            Trim(Employee.FaceKey);

        // Mantém compatibilidade com vínculos já gravados pela v0.4.5.
        if (!FaceKey.IsEmpty())
            return FaceKey;

        return BuildRfidFallbackIdentityKey(Employee);
    }

    bool RfidIdentityMatches(
        const UnicodeString& StoredIdentityKey,
        const TEmployee& Employee)
    {
        const UnicodeString Stored =
            Trim(StoredIdentityKey);

        if (Stored.IsEmpty() || Employee.Id <= 0)
            return false;

        const UnicodeString FaceKey =
            Trim(Employee.FaceKey);

        // Vínculo antigo/ERP: FaceKey.
        if (!FaceKey.IsEmpty() &&
            SameText(Stored, FaceKey))
        {
            return true;
        }

        // Vínculo administrativo sem FaceKey:
        // ID + nome normalizado.
        return SameText(
            Stored,
            BuildRfidFallbackIdentityKey(Employee));
    }

    TColor RgbColor(int Red, int Green, int Blue)
    {
        return static_cast<TColor>(RGB(Red, Green, Blue));
    }

    int ClampInt(int Value, int MinValue, int MaxValue)
    {
        if (Value < MinValue)
        {
            return MinValue;
        }

        if (Value > MaxValue)
        {
            return MaxValue;
        }

        return Value;
    }

    TColor StatusColor(TIdentificationFactorStatus Status)
    {
        switch (Status)
        {
        case TIdentificationFactorStatus::Confirmed:
            return RgbColor(41, 214, 132);
        case TIdentificationFactorStatus::Detected:
            return RgbColor(79, 169, 255);
        case TIdentificationFactorStatus::Error:
            return RgbColor(255, 82, 96);
        default:
            return RgbColor(245, 190, 79);
        }
    }

    const char* FaceDistanceName(FaceDistance Distance)
    {
        switch (Distance)
        {
        case FaceDistance::TooFar:
            return "TooFar";
        case FaceDistance::Good:
            return "Good";
        case FaceDistance::TooClose:
            return "TooClose";
        default:
            return "NoFace";
        }
    }

    double CalculateFaceRatio(const FaceRect& Face, int FrameWidth, int FrameHeight)
    {
        if (Face.Empty() || FrameWidth <= 0 || FrameHeight <= 0)
        {
            return 0.0;
        }

        const double WidthRatio = static_cast<double>(Face.Width) / FrameWidth;
        const double HeightRatio = static_cast<double>(Face.Height) / FrameHeight;
        return std::max(WidthRatio, HeightRatio);
    }

    cv::Rect ToCvRect(const FaceRect& Face)
    {
        return cv::Rect(Face.X, Face.Y, Face.Width, Face.Height);
    }

    bool IsFaceNearFrameEdge(const cv::Rect& Face, int FrameWidth, int FrameHeight)
    {
        if (Face.width <= 0 || Face.height <= 0 || FrameWidth <= 0 || FrameHeight <= 0)
        {
            return false;
        }

        const int Margin = std::max(24, std::min(FrameWidth, FrameHeight) * 5 / 100);
        const bool NearLeft = Face.x <= Margin;
        const bool NearTop = Face.y <= Margin;
        const bool NearRight = Face.x + Face.width >= FrameWidth - Margin;
        const bool NearBottom = Face.y + Face.height >= FrameHeight - Margin;
        return NearLeft || NearTop || NearRight || NearBottom;
    }

    FaceDistance ClassifyFaceDistance(const FaceRect& Face, int FrameWidth,
        int FrameHeight, FaceDistance PreviousDistance)
    {
        if (Face.Empty() || FrameWidth <= 0 || FrameHeight <= 0)
        {
            return FaceDistance::NoFace;
        }

        const double FaceRatio = CalculateFaceRatio(Face, FrameWidth, FrameHeight);
        const bool NearEdge = IsFaceNearFrameEdge(ToCvRect(Face), FrameWidth, FrameHeight);

        // If the face is already classified as too close, do not leave this state
        // until it has clearly moved back into the acceptable region.
        if (PreviousDistance == FaceDistance::TooClose)
        {
            if (FaceRatio > TooCloseExitRatio || NearEdge)
            {
                return FaceDistance::TooClose;
            }
        }

        // If the face is already classified as too far, require it to become
        // visibly larger before considering the distance acceptable.
        if (PreviousDistance == FaceDistance::TooFar)
        {
            if (FaceRatio < TooFarExitRatio)
            {
                return FaceDistance::TooFar;
            }
        }

        // Enter the "too close" state.
        if (FaceRatio >= TooCloseEnterRatio ||
            (FaceRatio >= LargeFaceNearEdgeRatio && NearEdge))
        {
            return FaceDistance::TooClose;
        }

        // Enter the "too far" state.
        if (FaceRatio < TooFarEnterRatio)
        {
            return FaceDistance::TooFar;
        }

        return FaceDistance::Good;
    }

    bool CopyFrameToTopDownBgra(const TCameraFrame& SourceFrame, TCameraFrame& TargetFrame)
    {
        TargetFrame = TCameraFrame();
        if (SourceFrame.Empty() || SourceFrame.BytesPerPixel != 4)
        {
            return false;
        }

        const int SourceStride = SourceFrame.Stride == 0
            ? SourceFrame.Width * SourceFrame.BytesPerPixel
            : SourceFrame.Stride;
        const int AbsStride = std::abs(SourceStride);
        const int RowBytes = SourceFrame.Width * SourceFrame.BytesPerPixel;
        const unsigned char* SourceBase = SourceFrame.Data.data();

        if (static_cast<int>(SourceFrame.Data.size()) < AbsStride * SourceFrame.Height)
        {
            return false;
        }

        TargetFrame.Width = SourceFrame.Width;
        TargetFrame.Height = SourceFrame.Height;
        TargetFrame.Stride = RowBytes;
        TargetFrame.BytesPerPixel = SourceFrame.BytesPerPixel;
        TargetFrame.Data.resize(RowBytes * SourceFrame.Height);

        for (int Row = 0; Row < SourceFrame.Height; ++Row)
        {
            const int SourceRow = SourceStride < 0 ? (SourceFrame.Height - 1 - Row) : Row;
            const unsigned char* Source = SourceBase + (SourceRow * AbsStride);
            unsigned char* Target = TargetFrame.Data.data() + (Row * RowBytes);
            std::memcpy(Target, Source, RowBytes);
        }

        return true;
    }

    bool RotateBgraFrame(const TCameraFrame& SourceFrame,
        TCameraFrame& TargetFrame, TCameraRotationMode Rotation)
    {
        if (SourceFrame.Empty() || SourceFrame.BytesPerPixel != 4)
        {
            return false;
        }

        if (Rotation == TCameraRotationMode::Deg0)
        {
            TargetFrame = SourceFrame;
            return true;
        }

        const int SourceStride = SourceFrame.Stride == 0
            ? SourceFrame.Width * 4
            : SourceFrame.Stride;

        if (SourceStride <= 0)
        {
            return false;
        }

        if (Rotation == TCameraRotationMode::Deg180)
        {
            TargetFrame = TCameraFrame();
            TargetFrame.Width = SourceFrame.Width;
            TargetFrame.Height = SourceFrame.Height;
            TargetFrame.BytesPerPixel = 4;
            TargetFrame.Stride = TargetFrame.Width * 4;
            TargetFrame.Data.resize(
                static_cast<size_t>(TargetFrame.Stride) * TargetFrame.Height);

            for (int Y = 0; Y < SourceFrame.Height; ++Y)
            {
                for (int X = 0; X < SourceFrame.Width; ++X)
                {
                    const unsigned char* Src =
                        SourceFrame.Data.data() + (Y * SourceStride) + (X * 4);
                    const int DX = SourceFrame.Width - 1 - X;
                    const int DY = SourceFrame.Height - 1 - Y;
                    unsigned char* Dst =
                        TargetFrame.Data.data() +
                        (DY * TargetFrame.Stride) + (DX * 4);
                    std::memcpy(Dst, Src, 4);
                }
            }
            return true;
        }

        TargetFrame = TCameraFrame();
        TargetFrame.Width = SourceFrame.Height;
        TargetFrame.Height = SourceFrame.Width;
        TargetFrame.BytesPerPixel = 4;
        TargetFrame.Stride = TargetFrame.Width * 4;
        TargetFrame.Data.resize(
            static_cast<size_t>(TargetFrame.Stride) * TargetFrame.Height);

        for (int Y = 0; Y < SourceFrame.Height; ++Y)
        {
            for (int X = 0; X < SourceFrame.Width; ++X)
            {
                int DX = 0;
                int DY = 0;

                if (Rotation == TCameraRotationMode::Deg90CW)
                {
                    DX = SourceFrame.Height - 1 - Y;
                    DY = X;
                }
                else
                {
                    DX = Y;
                    DY = SourceFrame.Width - 1 - X;
                }

                const unsigned char* Src =
                    SourceFrame.Data.data() + (Y * SourceStride) + (X * 4);
                unsigned char* Dst =
                    TargetFrame.Data.data() +
                    (DY * TargetFrame.Stride) + (DX * 4);
                std::memcpy(Dst, Src, 4);
            }
        }

        return true;
    }

    bool FrameToBitmap(const TCameraFrame& Frame, Graphics::TBitmap* Bitmap)
    {
        if (Frame.Empty() || Bitmap == nullptr || Frame.BytesPerPixel != 4)
        {
            return false;
        }

        Bitmap->PixelFormat = pf32bit;
        Bitmap->SetSize(Frame.Width, Frame.Height);

        const int SourceStride = Frame.Stride == 0
            ? Frame.Width * Frame.BytesPerPixel
            : Frame.Stride;
        const int AbsStride = std::abs(SourceStride);
        const int RowBytes = Frame.Width * Frame.BytesPerPixel;
        const unsigned char* SourceBase = Frame.Data.data();

        if (static_cast<int>(Frame.Data.size()) < AbsStride * Frame.Height)
        {
            return false;
        }

        for (int Row = 0; Row < Frame.Height; ++Row)
        {
            const int SourceRow = SourceStride < 0 ? (Frame.Height - 1 - Row) : Row;
            const unsigned char* Source = SourceBase + (SourceRow * AbsStride);
            unsigned char* Target = static_cast<unsigned char*>(Bitmap->ScanLine[Row]);
            std::memcpy(Target, Source, RowBytes);
        }

        return true;
    }
}

