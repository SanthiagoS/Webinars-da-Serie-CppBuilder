    }

    if (FCameraPreviewBitmap == nullptr)
    {
        FCameraPreviewBitmap = new Graphics::TBitmap();
    }

    if (FCameraPreviewTimer == nullptr)
    {
        FCameraPreviewTimer = new TTimer(this);
