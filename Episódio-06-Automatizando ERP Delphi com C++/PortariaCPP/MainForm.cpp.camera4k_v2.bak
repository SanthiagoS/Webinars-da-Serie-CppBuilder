bool TMainForm::ApplyEmployeeDatabasePath(
    const UnicodeString& DatabasePath)
{
    if (!FileExists(DatabasePath))
    {
        MessageDlg(
            L"O arquivo selecionado não existe.",
            mtError,
            TMsgDlgButtons() << mbOK,
            0);
        return false;
    }

    try
    {
        std::unique_ptr<TEmployeeRepository> NewRepository =
            std::make_unique<TEmployeeRepository>(DatabasePath);

        // Força uma consulta real antes de substituir o repositório atual.
        const std::vector<TEmployee> TestEmployees =
            NewRepository->GetAll();

        FConfig.DatabasePath = DatabasePath;

        if (FEmployeeSyncClient != nullptr)
        {
            FEmployeeSyncClient->Stop();
            FEmployeeSyncClient.reset();
        }

        FEmployeeRepository = std::move(NewRepository);

        // O IdentificationManager mantém referência ao repositório.
        // Por isso deve ser reconstruído após mudar o banco.
        FIdentificationManager =
            std::make_unique<TIdentificationManager>(
                *FEmployeeRepository,
                *FIntegrationClient,
                FConfig);

        ReconfigureEmployeeSync();

        FEmployees.clear();
        SavePersistedSettings();

        MessageDlg(
            L"Banco de funcionários alterado com sucesso.\n\n" +
            IntToStr(static_cast<int>(TestEmployees.size())) +
            L" funcionário(s) encontrado(s).",
            mtInformation,
            TMsgDlgButtons() << mbOK,
            0);

        return true;
    }
    catch (const Exception& E)
    {
        MessageDlg(
            L"O arquivo foi selecionado, mas não pôde ser usado como "
            L"banco de funcionários.\n\n" + E.Message,
            mtError,
            TMsgDlgButtons() << mbOK,
            0);
        return false;
    }
}

bool TMainForm::TestErpConnection()
{
    if (FSettingsApiEdit != nullptr)
        FConfig.ApiUrl = Trim(FSettingsApiEdit->Text);

    if (FConfig.ApiUrl.IsEmpty())
    {
        MessageDlg(
            L"Informe o endereço da API do ERP Delphi.",
            mtWarning,
            TMsgDlgButtons() << mbOK,
            0);
        return false;
    }

    try
    {
        std::unique_ptr<THTTPClient> Http(THTTPClient::Create());
        Http->ConnectionTimeout = 3000;
        Http->ResponseTimeout = 3000;

        const UnicodeString EmployeesUrl =
            TEmployeeSyncClient::EmployeesEndpoint(
                FConfig.ApiUrl);

        const _di_IHTTPResponse Response =
            Http->Get(EmployeesUrl);

        const int StatusCode = Response->StatusCode;

        // 2xx/3xx/4xx significam que um servidor HTTP respondeu.
        // Até 404/405 provam conectividade; apenas não garantem que GET
        // seja o método correto para esse endpoint.
        const bool Connected =
            StatusCode >= 200 && StatusCode < 500;

        if (Connected)
        {
            FSettingsErpStatus->Caption =
                L"● ERP DELPHI RESPONDENDO • HTTP " +
                IntToStr(StatusCode);
            FSettingsErpStatus->Font->Color =
                RgbColor(41, 214, 132);

            SavePersistedSettings();
            return true;
        }

        FSettingsErpStatus->Caption =
            L"● ERP DELPHI INDISPONÍVEL • HTTP " +
            IntToStr(StatusCode);
        FSettingsErpStatus->Font->Color =
            RgbColor(255, 82, 96);

        return false;
    }
    catch (const Exception& E)
    {
        FSettingsErpStatus->Caption =
            L"● SEM CONEXÃO COM ERP";
        FSettingsErpStatus->Font->Color =
            RgbColor(255, 82, 96);

        MessageDlg(
            L"Não foi possível alcançar o ERP Delphi.\n\n" +
            E.Message,
            mtWarning,
            TMsgDlgButtons() << mbOK,
            0);
        return false;
    }
}

void TMainForm::RefreshSettingsView()
{
    if (FSettingsErpCard == nullptr)
        return;

    const bool EmployeeDbOk = FileExists(FConfig.DatabasePath);
    const bool AccessDbOk = FileExists(FConfig.AccessDatabasePath);

    int EmployeeCount = 0;
    try
    {
        if (FEmployeeRepository != nullptr)
            EmployeeCount =
                static_cast<int>(FEmployeeRepository->GetAll().size());
    }
    catch (...)
    {
        EmployeeCount = 0;
    }

    FSettingsApiEdit->Text = FConfig.ApiUrl;

    FSettingsErpStatus->Caption =
        FConfig.ApiUrl.IsEmpty()
            ? L"● NÃO CONFIGURADO"
            : L"● ENDPOINT CONFIGURADO";
    FSettingsErpStatus->Font->Color =
        FConfig.ApiUrl.IsEmpty()
            ? RgbColor(245, 190, 79)
            : RgbColor(41, 214, 132);

    const bool RemoteEmployeesReady =
        FEmployeeRepository != nullptr &&
        FEmployeeRepository->HasRemoteSnapshot();

    FSettingsEmployeeDbStatus->Caption =
        RemoteEmployeesReady
            ? L"● ERP Delphi sincronizado • " +
              IntToStr(EmployeeCount) + L" funcionário(s)"
            : (EmployeeDbOk
                ? L"● Fallback Employees.s3db • " +
                  IntToStr(EmployeeCount) + L" funcionário(s)"
                : L"● Aguardando sincronização do ERP Delphi");

    FSettingsEmployeeDbStatus->Font->Color =
        RemoteEmployeesReady
            ? RgbColor(41, 214, 132)
            : (EmployeeDbOk
                ? RgbColor(245, 190, 79)
                : RgbColor(255, 82, 96));
    FSettingsEmployeeDbPath->Caption = FConfig.DatabasePath;
    FSettingsEmployeeDbPath->Hint = FConfig.DatabasePath;
    FSettingsEmployeeDbPath->ShowHint = true;

    FSettingsAccessDbStatus->Caption =
        AccessDbOk
            ? L"● access.s3db disponível"
            : L"● Banco local do terminal ainda não criado";
    FSettingsAccessDbStatus->Font->Color =
        AccessDbOk
            ? RgbColor(41, 214, 132)
            : RgbColor(245, 190, 79);
    FSettingsAccessDbPath->Caption = FConfig.AccessDatabasePath;
    FSettingsAccessDbPath->Hint = FConfig.AccessDatabasePath;
    FSettingsAccessDbPath->ShowHint = true;

    FSettingsTerminalEdit->Text =
        StringReplace(
            FConfig.TerminalName,
            L"-",
            L" ",
            TReplaceFlags() << rfReplaceAll);

    FSettingsTerminalStatus->Caption =
        L"Versão 1.0.0  •  Câmera " +
        IntToStr(FPreviewCameraIndex) +
        L"  •  FACE ativo  •  RFID pronto para integração";

    LblDeveloperStatus->Caption =
        L"Configuração corporativa do terminal C++Builder e integração com o ERP Delphi.";
}

void TMainForm::RunSystemDiagnostic()
{
    const bool EmployeeDbOk = FileExists(FConfig.DatabasePath);
    const bool AccessDbOk = FileExists(FConfig.AccessDatabasePath);
    const bool CameraOk =
        FCameraManager != nullptr && FCameraManager->IsOpen();
    const bool FaceOk =
        FFaceDetector != nullptr && FFaceRecognizer != nullptr;
    const bool RfidPortOk =
        FRfidSerialReader != nullptr && FRfidSerialReader->IsPortOpen();
    const bool RfidReady =
        RfidPortOk && FRfidSerialReader->IsDeviceReady();

    UnicodeString Report =
        L"DIAGNÓSTICO DO TERMINAL\n\n";

    Report += EmployeeDbOk
        ? L"✓ Banco de funcionários\n"
        : L"✗ Banco de funcionários\n";

    Report += AccessDbOk
        ? L"✓ Banco local do terminal\n"
        : L"○ Banco local do terminal\n";

    Report += CameraOk
        ? L"✓ Câmera ativa\n"
        : L"○ Câmera parada\n";

    Report += FaceOk
        ? L"✓ Identificação facial carregada\n"
        : L"✗ Identificação facial indisponível\n";

    if (RfidReady)
        Report += L"✓ RFID / ESP32-S3 online\n";
    else if (RfidPortOk)
        Report += L"○ COM5 aberta • RFID inicializando/recuperando\n";
    else
        Report += L"✗ RFID / COM5 offline\n";

    Report += FConfig.ApiUrl.IsEmpty()
        ? L"○ ERP Delphi não configurado\n"
        : L"✓ Endpoint ERP Delphi configurado\n";

    if (RfidPortOk && !RfidReady)
    {
        Report +=
            L"\nO leitor RFID não está pronto. "
            L"Deseja solicitar recuperação do RC522 agora?";

        if (MessageDlg(
                Report,
                mtWarning,
                TMsgDlgButtons() << mbYes << mbNo,
                0) == mrYes)
        {
            FRfidSerialReader->RecoverReader();
            LblDeveloperStatus->Caption =
                L"Diagnóstico: recuperação do RC522 solicitada.";
        }
        return;
    }

    MessageDlg(
        Report,
        RfidReady ? mtInformation : mtWarning,
        TMsgDlgButtons() << mbOK,
        0);
}

void __fastcall TMainForm::SettingsSelectDbClick(TObject *Sender)
{
    (void)Sender;

    std::unique_ptr<TOpenDialog> Dialog(new TOpenDialog(this));
    Dialog->Title = L"Selecionar banco de funcionários";
    Dialog->Filter =
        L"Banco SQLite (*.s3db;*.db;*.sqlite)|*.s3db;*.db;*.sqlite|"
        L"Todos os arquivos (*.*)|*.*";
    Dialog->Options =
        TOpenOptions() << ofFileMustExist << ofPathMustExist;

    if (!Dialog->Execute())
        return;

    if (ApplyEmployeeDatabasePath(Dialog->FileName))
        RefreshSettingsView();
}

void __fastcall TMainForm::SettingsTestErpClick(TObject *Sender)
{
    (void)Sender;
    TestErpConnection();
}

void __fastcall TMainForm::SettingsSaveTerminalClick(TObject *Sender)
{
    (void)Sender;

    if (FSettingsTerminalEdit != nullptr)
    {
        UnicodeString Terminal =
            Trim(FSettingsTerminalEdit->Text);

        if (Terminal.IsEmpty())
        {
            MessageDlg(
                L"Informe o nome do terminal.",
                mtWarning,
                TMsgDlgButtons() << mbOK,
                0);
            return;
        }

        Terminal =
            StringReplace(
                Terminal,
                L" ",
                L"-",
                TReplaceFlags() << rfReplaceAll);

        FConfig.TerminalName = UpperCase(Terminal);
    }

    if (FSettingsApiEdit != nullptr)
        FConfig.ApiUrl = Trim(FSettingsApiEdit->Text);

    // Reconstrói cliente/gerenciador para usar o endpoint salvo.
    FIntegrationClient =
        std::make_unique<TIntegrationClient>(FConfig.ApiUrl);

    FIdentificationManager =
        std::make_unique<TIdentificationManager>(
            *FEmployeeRepository,
            *FIntegrationClient,
            FConfig);

    ReconfigureEmployeeSync();

    SavePersistedSettings();

    LblTerminal->Caption = TerminalDisplayName();
    LblMenuFooter->Caption =
        TerminalDisplayName() + L" | Versão 1.0.0";

    RefreshSettingsView();

    MessageDlg(
        L"Configurações salvas.",
        mtInformation,
        TMsgDlgButtons() << mbOK,
        0);
}

void __fastcall TMainForm::SettingsDiagnosticClick(TObject *Sender)
{
    (void)Sender;
    RunSystemDiagnostic();
}

void TMainForm::UpdateDeveloperPanel()
{
    // Controles exclusivos da página RFID devem desaparecer ao trocar
    // para qualquer outra tela administrativa.
    if (FRfidReaderCard != nullptr)
        FRfidReaderCard->Visible = false;

    if (FCameraSelectorLabel != nullptr)
        FCameraSelectorLabel->Visible = false;
    if (FCameraSelector != nullptr)
        FCameraSelector->Visible = false;
    if (FCameraSettingsPreview != nullptr)
        FCameraSettingsPreview->Visible = false;

    if (FSettingsErpCard != nullptr)
        FSettingsErpCard->Visible = false;
    if (FSettingsDataCard != nullptr)
        FSettingsDataCard->Visible = false;
    if (FSettingsTerminalCard != nullptr)
        FSettingsTerminalCard->Visible = false;

    const bool PresentPage =
        FCurrentPage == TAccessPage::PresentEmployees;
    const bool RecentPage =
        FCurrentPage == TAccessPage::RecentEntries;
    const bool ManualPage =
        FCurrentPage == TAccessPage::ManualRelease;
    const bool RfidPage =
        FCurrentPage == TAccessPage::BleDevices;
    const bool IncidentPage =
        FCurrentPage == TAccessPage::Incidents;
    const bool CameraPage =
        FCurrentPage == TAccessPage::Camera;
    const bool SettingsPage =
        FCurrentPage == TAccessPage::Settings;

    DeveloperPanel->Visible =
        PresentPage || RecentPage || ManualPage || RfidPage ||
        IncidentPage || CameraPage || SettingsPage;

    LstEmployees->Visible =
        PresentPage || RecentPage || ManualPage || RfidPage || IncidentPage;

    if (PresentPage)
    {
        BtnSimulate->Visible = false;

        BtnClear->Visible = true;
        BtnClear->Caption = L"Atualizar presentes";

        BtnStartCamera->Visible = false;

        RefreshPresentEmployees();
        return;
    }

    if (RecentPage)
    {
        BtnSimulate->Visible = false;

        BtnClear->Visible = true;
        BtnClear->Caption = L"Atualizar histórico";

        BtnStartCamera->Visible = false;

        RefreshRecentEntries();
        return;
    }

    if (ManualPage)
    {
        BtnSimulate->Visible = true;
        BtnSimulate->Caption = L"LIBERAR ACESSO";

        BtnClear->Visible = true;
        BtnClear->Caption = L"Atualizar funcionários";

        BtnStartCamera->Visible = false;

        RefreshManualReleaseEmployees();
        return;
    }

    if (RfidPage)
    {
        BtnSimulate->Visible = true;

        BtnClear->Visible = true;
        BtnClear->Caption = L"REMOVER TAG";

        BtnStartCamera->Visible = true;
        BtnStartCamera->Caption = L"RESET RFID / ESP32";

        RefreshRfidTagEmployees();
        UpdateRfidAdminReader();
        return;
    }

    if (IncidentPage)
    {
        UpdateOccurrencePageButtons();

        if (FIncidentHistoryMode)
        {
            RefreshOccurrences();
        }
        else
        {
            RefreshOccurrenceEmployees();
        }
        return;
    }

    if (SettingsPage)
    {
        BtnSimulate->Visible = false;
        BtnClear->Visible = false;
        BtnStartCamera->Visible = false;
        LstEmployees->Visible = false;

        if (FSettingsErpCard != nullptr)
            FSettingsErpCard->Visible = true;
        if (FSettingsDataCard != nullptr)
            FSettingsDataCard->Visible = true;
        if (FSettingsTerminalCard != nullptr)
            FSettingsTerminalCard->Visible = true;

        RefreshSettingsView();
        return;
    }

    if (CameraPage)
    {
        LblDeveloperStatus->Caption =
            L"Selecione a câmera pelo preview. O índice 0/1 é definido pelo Windows/OpenCV e não indica se é integrada ou USB.";

        if (FCameraSelectorLabel != nullptr)
            FCameraSelectorLabel->Visible = true;
        if (FCameraSelector != nullptr)
            FCameraSelector->Visible = true;
        if (FCameraSettingsPreview != nullptr)
            FCameraSettingsPreview->Visible = true;

        if (!FCameraListInitialized)
            RefreshCameraDeviceList();

        BtnSimulate->Visible = true;
        BtnSimulate->Caption =
            L"Layout: " + LayoutModeCaption();

        BtnClear->Visible = true;
        BtnClear->Caption =
            L"Rotação câmera: " + CameraRotationCaption();

        BtnStartCamera->Visible = true;
        BtnStartCamera->Caption = FCameraManager->IsOpen()
            ? L"Parar câmera"
            : L"Iniciar câmera";

        return;
    }

    LblDeveloperStatus->Caption =
        L"Ferramentas de desenvolvimento e operação do terminal.";

    BtnSimulate->Visible = false;
    BtnClear->Visible = true;
    BtnClear->Caption = L"Limpar identificação";
    BtnStartCamera->Visible = false;
}

bool TMainForm::TryGetSelectedEmployee(TEmployee& Employee) const
{
    Employee = TEmployee();
    const int Index = LstEmployees->ItemIndex;
    if (Index < 0 || Index >= static_cast<int>(FEmployees.size()))
    {
        return false;
    }

    Employee = FEmployees[static_cast<size_t>(Index)];
    return Employee.Id > 0;
}

bool TMainForm::CanProcessRecognition() const
{
    const bool HoldingNegativeResult =
        FFacePreviewState == TFacePreviewState::NotRecognized &&
        ReturnTimer != nullptr &&
        ReturnTimer->Enabled;

    return !FEnrollmentActive &&
        !FFaceRecognitionLocked &&
        !HoldingNegativeResult &&
        FHasPrimaryFace &&
        !FHasMultipleOperationalFaces &&
        FLastDistance == FaceDistance::Good &&
        FIdentificationState == IdentificationState::ReadyForRecognition;
}

bool TMainForm::FaceInsideFrame(const FaceDetection& Detection, int FrameWidth,
    int FrameHeight) const
{
    const FaceRect& Bounds = Detection.Bounds;
    return !Bounds.Empty() && Bounds.X >= 0 && Bounds.Y >= 0 &&
        Bounds.X + Bounds.Width <= FrameWidth &&
        Bounds.Y + Bounds.Height <= FrameHeight;
}

double TMainForm::FaceAverageBrightness(const TCameraFrame& Frame,
    const FaceDetection& Detection) const
{
    if (Frame.Empty() || Detection.Bounds.Empty() || Frame.BytesPerPixel != 4)
    {
        return 0.0;
    }

    // Usa a região central do rosto para reduzir a influência do fundo,
    // cabelo e bordas do bounding box.
    const FaceRect& Bounds = Detection.Bounds;

    const int HorizontalInset =
        std::max(1, Bounds.Width / 8);
    const int VerticalInset =
        std::max(1, Bounds.Height / 8);

    const int Left =
        std::max(0, Bounds.X + HorizontalInset);
    const int Top =
        std::max(0, Bounds.Y + VerticalInset);
    const int Right =
        std::min(Frame.Width,
            Bounds.X + Bounds.Width - HorizontalInset);
    const int Bottom =
        std::min(Frame.Height,
            Bounds.Y + Bounds.Height - VerticalInset);

    if (Right <= Left || Bottom <= Top)
    {
        return 0.0;
    }

    double BrightnessSum = 0.0;
    int Samples = 0;

    // Amostragem a cada 2 pixels é suficiente para feedback visual
    // e evita custo desnecessário no loop da câmera.
    for (int Y = Top; Y < Bottom; Y += 2)
    {
        const unsigned char* Row =
            Frame.Data.data() + (Y * Frame.Stride);

        for (int X = Left; X < Right; X += 2)
        {
            const int Offset = X * Frame.BytesPerPixel;

            const int Blue = Row[Offset];
            const int Green = Row[Offset + 1];
            const int Red = Row[Offset + 2];

            // Luminância aproximada perceptual.
            BrightnessSum +=
                (0.114 * Blue) +
                (0.587 * Green) +
                (0.299 * Red);

            ++Samples;
        }
    }

    if (Samples <= 0)
    {
        return 0.0;
    }

    return BrightnessSum / Samples;
}

bool TMainForm::FaceLightingEnough(const TCameraFrame& Frame,
    const FaceDetection& Detection) const
{
    return FaceAverageBrightness(Frame, Detection) >=
        FaceMinimumBrightness;
}

bool TMainForm::FaceSharpEnough(const TCameraFrame& Frame,
    const FaceDetection& Detection) const
{
    if (Frame.Empty() || Detection.Bounds.Empty() || Frame.BytesPerPixel != 4)
    {
        return false;
    }

    const FaceRect& Bounds = Detection.Bounds;
    const int Left = std::max(0, Bounds.X);
    const int Top = std::max(0, Bounds.Y);
    const int Right = std::min(Frame.Width, Bounds.X + Bounds.Width);
    const int Bottom = std::min(Frame.Height, Bounds.Y + Bounds.Height);
    const int Width = Right - Left;
    const int Height = Bottom - Top;
    if (Width < 64 || Height < 64)
    {
        return false;
    }

    double GradientSum = 0.0;
    int Samples = 0;
    for (int Y = Top + 1; Y < Bottom - 1; ++Y)
    {
        const unsigned char* Row = Frame.Data.data() + (Y * Frame.Stride);
        const unsigned char* PrevRow = Frame.Data.data() + ((Y - 1) * Frame.Stride);
        const unsigned char* NextRow = Frame.Data.data() + ((Y + 1) * Frame.Stride);
        for (int X = Left + 1; X < Right - 1; ++X)
        {
            const int Offset = X * Frame.BytesPerPixel;
            const int PrevOffset = (X - 1) * Frame.BytesPerPixel;
            const int NextOffset = (X + 1) * Frame.BytesPerPixel;

            const int GrayLeft = (Row[PrevOffset] + Row[PrevOffset + 1] + Row[PrevOffset + 2]) / 3;
            const int GrayRight = (Row[NextOffset] + Row[NextOffset + 1] + Row[NextOffset + 2]) / 3;
            const int GrayUp = (PrevRow[Offset] + PrevRow[Offset + 1] + PrevRow[Offset + 2]) / 3;
            const int GrayDown = (NextRow[Offset] + NextRow[Offset + 1] + NextRow[Offset + 2]) / 3;

            GradientSum += std::abs(GrayRight - GrayLeft) + std::abs(GrayDown - GrayUp);
            ++Samples;
        }
    }

    if (Samples <= 0)
    {
        return false;
    }

    const double AverageGradient = GradientSum / Samples;

    // Webcam de portaria: 18.0 estava excessivamente restritivo e podia
    // impedir completamente o cadastro de identificação facial mesmo com a face nítida.
    // Mantemos um filtro leve apenas para rejeitar frames claramente borrados.
    return AverageGradient >= 8.0;
}

void TMainForm::ProcessFaceEnrollment(const TCameraFrame& Frame)
{
    if (!FEnrollmentActive)
    {
        return;
    }

    // Enquanto o cadastro estiver ativo, a UI deve deixar claro que estamos
    // em modo de enrollment, mesmo antes de uma amostra ser aceita.
    FFacePreviewState = TFacePreviewState::Enrolling;

    if (FFaceRecognizer == nullptr || FFaceRepository == nullptr ||
        !FFaceRecognizer->IsInitialized())
    {
        LblPrompt->Caption = L"Reconhecimento facial indisponível";
        LblDeveloperStatus->Caption = L"FaceRecognizer/FaceRepository não inicializado.";
        ApplyFacePreviewStatus();
        return;
    }

    if (!FHasPrimaryFace)
    {
        LblPrompt->Caption = L"Posicione o rosto diante da câmera";
        ApplyFacePreviewStatus();
        return;
    }

    if (FHasMultipleOperationalFaces)
    {
        LblPrompt->Caption = L"Mantenha apenas uma pessoa diante da câmera";
        ApplyFacePreviewStatus();
        return;
    }

    if (FLastDistance != FaceDistance::Good)
    {
        LblPrompt->Caption = FLastDistance == FaceDistance::TooClose
            ? L"Afaste-se um pouco"
            : L"Aproxime-se um pouco";
        ApplyFacePreviewStatus();
        return;
    }

    if (!FaceInsideFrame(FPrimaryFaceDetection, Frame.Width, Frame.Height))
    {
        LblPrompt->Caption = L"Centralize o rosto na câmera";
        ApplyFacePreviewStatus();
        return;
    }

    if (FPrimaryFaceDetection.Confidence < 0.85f)
    {
        LblPrompt->Caption = L"Mantenha o rosto voltado para a câmera";
        ApplyFacePreviewStatus();
        return;
    }

    if (!FaceLightingEnough(Frame, FPrimaryFaceDetection))
    {
        FFaceQualityIssue = TFaceQualityIssue::LowLight;
        ApplyFacePreviewStatus();
        return;
    }

    if (!FaceSharpEnough(Frame, FPrimaryFaceDetection))
    {
        FFaceQualityIssue = TFaceQualityIssue::Blurred;
        ApplyFacePreviewStatus();
        return;
    }

    FFaceQualityIssue = TFaceQualityIssue::None;

    const unsigned int NowTick = GetTickCount();
    if (FLastRecognitionAttemptTick != 0 &&
        NowTick - FLastRecognitionAttemptTick < FaceRecognitionIntervalMs)
    {
        ApplyFacePreviewStatus();
        return;
    }

    FLastRecognitionAttemptTick = NowTick;

    FaceFeature Feature;
    if (!FFaceRecognizer->ExtractFeature(Frame.Data.data(), Frame.Width,
        Frame.Height, Frame.Stride, FPrimaryFaceDetection.Bounds, Feature))
    {
        LblPrompt->Caption = L"Não foi possível extrair as características faciais. Ajuste a posição.";
        ApplyFacePreviewStatus();
        return;
    }

    FEnrollmentSamples.push_back(Feature);

    const int SampleCount = static_cast<int>(FEnrollmentSamples.size());
    LblDeveloperStatus->Caption = Format(
        L"Capturando amostras de identificação facial: %d/%d",
        ARRAYOFCONST((SampleCount, FaceEnrollmentRequiredSamples)));

    // Atualiza imediatamente o contador visível na tela principal.
    LblPrompt->Caption =
        L"Cadastrando identificação facial • " +
        (!FRemoteEnrollmentEmployeeName.IsEmpty()
            ? FRemoteEnrollmentEmployeeName
            : L"funcionário selecionado") +
        L" • " +
        IntToStr(SampleCount) +
        L"/" +
        IntToStr(FaceEnrollmentRequiredSamples);

    if (!FRemoteEnrollmentRequestId.IsEmpty() &&
        SampleCount < FaceEnrollmentRequiredSamples)
    {
        // Canal operacional direto: Portaria -> ERP Delphi :3101.
        // O WebServer :8080 não participa do cadastro facial.
        SendDirectEnrollmentProgress(
            FRemoteEnrollmentRequestId,
            L"Portaria capturando amostras faciais",
            SampleCount);
    }

    if (SampleCount >= FaceEnrollmentRequiredSamples)
    {
        CompleteFaceEnrollment();
        return;
    }

    ApplyFacePreviewStatus();
}

void TMainForm::ProcessFaceRecognition(const TCameraFrame& Frame)
{
    if (FEnrollmentActive)
    {
        return;
    }

    if (FFaceRecognizer == nullptr || FFaceRepository == nullptr ||
        !FFaceRecognizer->IsInitialized() || !CanProcessRecognition() ||
        FFacePreviewState == TFacePreviewState::Recognized ||
        FFacePreviewState == TFacePreviewState::NotRecognized)
    {
        return;
    }

    if (!FaceInsideFrame(FPrimaryFaceDetection, Frame.Width, Frame.Height))
    {
        return;
    }

    // v0.7.1.2
    // Se não existe nenhum template facial que pertença de fato a um
    // funcionário atual (EmployeeId + FaceKey), não há o que comparar.
    // Nesse cenário a UI não deve ficar indefinidamente em "FACE Detectada":
    // a detecção ocorreu, mas a identificação não pode ser confirmada.
    bool HasEligibleFaceTemplate = false;

    if (FFaceRepository != nullptr &&
        FEmployeeRepository != nullptr)
    {
        const std::vector<FaceTemplate> Templates =
            FFaceRepository->LoadAllTemplates();

        for (const FaceTemplate& Template : Templates)
        {
            TEmployee TemplateOwner;

            if (!FEmployeeRepository->FindById(
                    Template.EmployeeId,
                    TemplateOwner))
            {
                continue;
            }

            if (Trim(Template.FaceKey).IsEmpty() ||
                Trim(TemplateOwner.FaceKey).IsEmpty())
            {
                continue;
            }

            if (SameText(
                    Trim(Template.FaceKey),
                    Trim(TemplateOwner.FaceKey)))
            {
                HasEligibleFaceTemplate = true;
                break;
            }
        }
    }

    if (!HasEligibleFaceTemplate)
    {
        RejectFaceRecognition();
        return;
    }

    if (!FaceLightingEnough(Frame, FPrimaryFaceDetection))
    {
        FFaceQualityIssue = TFaceQualityIssue::LowLight;

        // Não reaproveitar uma confirmação parcial obtida antes de
        // a qualidade do frame degradar.
        FRecognitionCandidateId = 0;
        FRecognitionCandidateHits = 0;

        FFacePreviewState = TFacePreviewState::Detected;
        ApplyFacePreviewStatus();
        return;
    }

    if (!FaceSharpEnough(Frame, FPrimaryFaceDetection))
    {
        FFaceQualityIssue = TFaceQualityIssue::Blurred;
        FRecognitionCandidateId = 0;
        FRecognitionCandidateHits = 0;

        FFacePreviewState = TFacePreviewState::Detected;
        ApplyFacePreviewStatus();
        return;
    }

    FFaceQualityIssue = TFaceQualityIssue::None;

    const unsigned int NowTick = GetTickCount();
    if (FLastRecognitionAttemptTick != 0 &&
        NowTick - FLastRecognitionAttemptTick < FaceRecognitionIntervalMs)
    {
        return;
    }
    FLastRecognitionAttemptTick = NowTick;
    FFaceQualityIssue = TFaceQualityIssue::None;
    FFacePreviewState = TFacePreviewState::Recognizing;
    ApplyFacePreviewStatus();

    if (FLivenessDetector != nullptr)
    {
        const LivenessResult Liveness = FLivenessDetector->Process(Frame.Data.data(),
            Frame.Width, Frame.Height, Frame.Stride, FPrimaryFaceDetection);
        if (FLivenessDetector->Mode() == LivenessMode::Prototype)
        {
            OutputDebugStringA("LIVENESS: prototype mode active, allowing pass-through to face recognition.\n");
        }
        else if (!Liveness.Completed || !Liveness.IsLive)
        {
            RejectFaceRecognition();
            return;
        }
    }

    const auto StartedAt = std::chrono::steady_clock::now();
    FaceFeature Feature;
    if (!FFaceRecognizer->ExtractFeature(Frame.Data.data(), Frame.Width,
        Frame.Height, Frame.Stride, FPrimaryFaceDetection.Bounds, Feature))
    {
        return;
    }

    const FaceRecognitionResult Result = RecognizeFeature(Feature);
    FLastRecognitionResult = Result;
    FLastRecognitionDurationMs = std::chrono::duration<double, std::milli>(
        std::chrono::steady_clock::now() - StartedAt).count();

    const double FaceBrightness =
        FaceAverageBrightness(Frame, FPrimaryFaceDetection);

    char DebugBuffer[384];
    std::snprintf(DebugBuffer, sizeof(DebugBuffer),
        "FACE_RECOGNITION: recognized=%d employeeId=%d score=%.4f threshold=%.4f durationMs=%.2f hits=%d brightness=%.1f\n",
        Result.Recognized ? 1 : 0,
        Result.EmployeeId,
        Result.Score,
        FConfig.FaceRecognitionThreshold,
        FLastRecognitionDurationMs,
        FRecognitionCandidateHits,
        FaceBrightness);
    OutputDebugStringA(DebugBuffer);

    if (!Result.Recognized)
    {
        RejectFaceRecognition();
        return;
    }

    if (FRecognitionCandidateId != Result.EmployeeId)
    {
        FRecognitionCandidateId = Result.EmployeeId;
        FRecognitionCandidateHits = 1;
        return;
    }

    ++FRecognitionCandidateHits;
    if (FRecognitionCandidateHits < FaceRecognitionRequiredHits)
    {
        return;
    }

    TEmployee Employee;
    if (FEmployeeRepository == nullptr || !FEmployeeRepository->FindById(Result.EmployeeId, Employee))
    {
        RejectFaceRecognition();
        return;
    }

    UnicodeString BlockReason;
    const bool LocalBlocked =
        IsEmployeeAccessBlocked(Employee, BlockReason);

    // ETAPA 5: ERP online decide. A regra local fica somente como fallback.
    TErpAccessDecision ErpDecision;
    TryGetErpAccessDecision(
        Employee.Id,
        L"FACE",
        ErpDecision);
    LogAccessDecisionComparison(
        L"FACE",
        Employee,
        !LocalBlocked,
        ErpDecision);

    if (ErpDecision.Available)
    {
        if (!ErpDecision.Authorized)
        {
            ShowBlockedEmployeeResult(
                Employee,
                ErpAccessReasonToDisplay(ErpDecision.Reason),
                Frame);
            return;
        }
    }
    else
    {
        // ETAPA 6 - CONTINGENCIA EXPLICITA PARA FACE.
        if (FObservabilityHeartbeat != nullptr)
        {
            FObservabilityHeartbeat->SendEvent(
                L"WARN",
                L"ACCESS_DECISION_OFFLINE",
                L"ERP indisponível • decisão local de contingência",
                Employee.Name,
                LocalBlocked
                    ? UnicodeString(L"FACE|ERP_UNAVAILABLE|LOCAL_DENIED")
                    : UnicodeString(L"FACE|ERP_UNAVAILABLE|LOCAL_GRANTED"),
                FLastRecognitionDurationMs);
        }

        if (LocalBlocked)
        {
            const UnicodeString ContingencyReason =
                BlockReason.IsEmpty()
                    ? UnicodeString(L"Modo contingência • ERP indisponível")
                    : UnicodeString(L"Modo contingência • ") + BlockReason;

            ShowBlockedEmployeeResult(
                Employee, ContingencyReason, Frame);
            return;
        }
    }

    FFacePreviewState = TFacePreviewState::Recognized;
    FIdentificationState = IdentificationState::ReadyForRecognition;
    FFaceRecognitionLocked = true;
    FRecognizedEmployeeId = Employee.Id;
    FFaceMissFrames = 0;
    FRecognitionCandidateId = 0;
    FRecognitionCandidateHits = 0;
    FLastCorrectTestScore = Result.Score;

    // v0.4.5 - identificação facial é um fator de acesso completo.
    // O BLE foi retirado do fluxo do MVP.
    FIdentificationManager->FaceDetected(Employee.Id, 1.0);

    if (ReturnTimer != nullptr)
    {
        ReturnTimer->Enabled = false;
        ReturnTimer->Interval = 3000;
        ReturnTimer->Enabled = true;
    }

    UpdateEmployeePhotoSnapshot(Frame, FPrimaryFaceDetection);

    EmployeeResultPanel->Visible = true;
    EmployeeResultPanel->BringToFront();

    if (FRecognitionCheckShape != nullptr)
    {
        FRecognitionCheckShape->Visible = true;
        FRecognitionCheckShape->BringToFront();
    }
    if (FRecognitionCheckLabel != nullptr)
    {
        FRecognitionCheckLabel->Visible = true;
        FRecognitionCheckLabel->BringToFront();
    }
    const TColor GrantedColor = RgbColor(41, 214, 132);

    LblEmployeeState->Caption = L"ACESSO AUTORIZADO";
    LblEmployeeState->Font->Color = GrantedColor;
    LblName->Caption = Employee.Name;
    LblDepartment->Caption = Employee.Department;
    LblIdentifiedAt->Caption =
        L"Identificação facial confirmada às " +
        FormatDateTime(L"hh:nn:ss", Now());

    // O lock facial impede gravações repetidas enquanto a mesma pessoa
    // permanece diante da câmera.
    RecordFaceAccessEvent(Employee, Result.Score);

// =========================================================
// OBSERVABILITY - EVENTO DE RECONHECIMENTO FACIAL
// =========================================================
  if (FObservabilityHeartbeat != nullptr)
	{
	  FObservabilityHeartbeat->SendEvent(
		L"SUCCESS",
		L"FACE_RECOGNITION",
		L"Funcionário reconhecido por identificação facial",
		Employee.Name,
		L"FACE_CONFIRMED",
		FLastRecognitionDurationMs);
	}

    if (!ErpDecision.Available)
    {
        LblPrompt->Caption =
            L"Acesso autorizado • Modo contingência (ERP indisponível)";
        LblPrompt->Font->Color = RgbColor(245, 190, 79);
    }
    else
    {
        LblPrompt->Caption =
            L"Acesso autorizado por identificação facial";
        LblPrompt->Font->Color = RgbColor(41, 214, 132);
    }

    LayoutTerminal();
    ApplyFacePreviewStatus();
}

FaceRecognitionResult TMainForm::RecognizeFeature(const FaceFeature& Feature)
{
    FaceRecognitionResult Result;
    if (Feature.Empty() || FFaceRecognizer == nullptr || FFaceRepository == nullptr)
    {
        return Result;
    }

    const std::vector<FaceTemplate> Templates =
        FFaceRepository->LoadAllTemplates();

    for (const FaceTemplate& Template : Templates)
    {
        // EmployeeId sozinho não é identidade suficiente:
        // o SQLite pode reutilizar um ID excluído.
        TEmployee TemplateOwner;

        if (FEmployeeRepository == nullptr ||
            !FEmployeeRepository->FindById(
                Template.EmployeeId,
                TemplateOwner))
        {
            continue;
        }

        if (Trim(Template.FaceKey).IsEmpty() ||
            Trim(TemplateOwner.FaceKey).IsEmpty() ||
            !SameText(
                Trim(Template.FaceKey),
                Trim(TemplateOwner.FaceKey)))
        {
            continue;
        }

        const double Score =
            FFaceRecognizer->Compare(
                Feature,
                Template.Feature);

        if (Score > Result.Score)
        {
            Result.Score = Score;
            Result.EmployeeId = Template.EmployeeId;
        }
    }

    Result.Recognized = Result.EmployeeId > 0 &&
        Result.Score >= FConfig.FaceRecognitionThreshold;
    if (!Result.Recognized && Result.Score > FLastUnknownTestScore)
    {
        FLastUnknownTestScore = Result.Score;
    }
    return Result;
}

bool TMainForm::BuildEnrollmentTemplate(FaceFeature& Template) const
{
    Template.Values.clear();
    if (FEnrollmentSamples.empty())
    {
        return false;
    }

    const size_t FeatureSize = FEnrollmentSamples[0].Values.size();
    if (FeatureSize == 0)
    {
        return false;
    }

    Template.Values.assign(FeatureSize, 0.0f);
    for (const FaceFeature& Sample : FEnrollmentSamples)
    {
        if (Sample.Values.size() != FeatureSize)
        {
            Template.Values.clear();
            return false;
        }

        for (size_t Index = 0; Index < FeatureSize; ++Index)
        {
            Template.Values[Index] += Sample.Values[Index];
        }
    }

    double Norm = 0.0;
    for (float& Value : Template.Values)
    {
        Value /= static_cast<float>(FEnrollmentSamples.size());
        Norm += static_cast<double>(Value) * Value;
    }

    Norm = std::sqrt(Norm);
    if (Norm <= 0.0)
    {
        Template.Values.clear();
        return false;
    }

    for (float& Value : Template.Values)
    {
        Value = static_cast<float>(Value / Norm);
    }
    return true;
}

void TMainForm::BeginFaceEnrollment()
{
    TEmployee Employee;
    if (!TryGetSelectedEmployee(Employee))
    {
        LblDeveloperStatus->Caption = L"Selecione um funcionário real antes de iniciar o cadastro de identificação facial.";
        return;
    }

    // IMPORTANTE:
    // Um ReturnTimer pendente de uma tentativa anterior de reconhecimento pode
    // disparar durante o cadastro e chamar ResetFacePreviewState(), que zera
    // FEnrollmentActive. Isso fazia o fluxo abandonar o enrollment no meio e
    // voltar para "Pessoa não reconhecida".
    if (ReturnTimer != nullptr)
    {
        ReturnTimer->Enabled = false;
        ReturnTimer->Interval = 5000;
    }

    // Enrollment iniciado manualmente pela própria Portaria.
    // Não deve responder a nenhuma request remota anterior.
    FRemoteEnrollmentRequestId = L"";
    FRemoteEnrollmentEmployeeName = L"";

    FEnrollmentActive = true;
    FEnrollmentEmployeeId = Employee.Id;
    FEnrollmentSamples.clear();
    FRecognitionCandidateId = 0;
    FRecognitionCandidateHits = 0;
    FFacePreviewState = TFacePreviewState::Enrolling;
    EmployeeResultPanel->Visible = false;

    // Guarda uma mensagem administrativa para quando o operador voltar à tela
    // de funcionários, mas executa o cadastro no preview principal da câmera.
    LblDeveloperStatus->Caption =
        L"Cadastro de identificação facial iniciado para " + Employee.Name +
        L". Aguarde a captura das 8 amostras.";

    // O cadastro de identificação facial precisa ser visual: após selecionar o funcionário,
    // voltamos automaticamente à tela principal, onde o usuário vê a webcam,
    // o bounding box e o contador 0/8 ... 8/8.
    ShowIdentification();

    ApplyFacePreviewStatus();
}


void TMainForm::BeginRemoteFaceEnrollment(
    int EmployeeId,
    const UnicodeString& EmployeeName,
    const UnicodeString& RequestId)
{
    if (RequestId.IsEmpty() || EmployeeId <= 0)
        return;

    // /api/enrollment/pending permanece "pending" durante a captura.
    // Se o mesmo RequestId aparecer novamente, apenas ignore-o.
    if (FEnrollmentActive)
    {
        if (!FRemoteEnrollmentRequestId.IsEmpty() &&
            SameText(
                Trim(FRemoteEnrollmentRequestId),
                Trim(RequestId)))
        {
            return;
        }

        SendEnrollmentResultToErp(
            RequestId,
            L"failed",
            L"Terminal ocupado com outro cadastro de identificação facial",
            0);
        return;
    }

    TEmployee Employee;

    if (FEmployeeRepository == nullptr ||
        !FEmployeeRepository->FindById(EmployeeId, Employee))
    {
        SendEnrollmentResultToErp(
            RequestId,
            L"failed",
            L"EmployeeId não encontrado no repositório da Portaria",
            0);

        LblDeveloperStatus->Caption =
            L"Cadastro remoto recusado: EmployeeId " +
            IntToStr(EmployeeId) +
            L" não existe no repositório da Portaria.";

        return;
    }

    if (FCameraManager == nullptr || !FCameraManager->IsOpen())
    {
        SendEnrollmentResultToErp(
            RequestId,
            L"failed",
            L"Câmera indisponível na Portaria",
            0);
        return;
    }

    if (FFaceRecognizer == nullptr ||
        !FFaceRecognizer->IsInitialized() ||
        FFaceRepository == nullptr)
    {
        SendEnrollmentResultToErp(
            RequestId,
            L"failed",
            L"Face Engine indisponível na Portaria",
            0);
        return;
    }

    if (ReturnTimer != nullptr)
    {
        ReturnTimer->Enabled = false;
        ReturnTimer->Interval = 5000;
    }

    FRemoteEnrollmentRequestId = RequestId;
    FRemoteEnrollmentEmployeeName =
        EmployeeName.IsEmpty()
            ? Employee.Name
            : EmployeeName;

    FEnrollmentActive = true;
    FEnrollmentEmployeeId = EmployeeId;
    FEnrollmentSamples.clear();
    FRecognitionCandidateId = 0;
    FRecognitionCandidateHits = 0;
    FFacePreviewState = TFacePreviewState::Enrolling;

    if (EmployeeResultPanel != nullptr)
        EmployeeResultPanel->Visible = false;

    LblDeveloperStatus->Caption =
        L"Cadastro de identificação facial solicitado pelo ERP para " +
        FRemoteEnrollmentEmployeeName +
        L". Aguarde a captura das 8 amostras.";

    // Confirma diretamente ao ERP que a captura foi iniciada.
    SendDirectEnrollmentProgress(
        RequestId,
        L"Portaria iniciou a captura da identificação facial",
        0);

    ShowIdentification();
    ApplyFacePreviewStatus();
}

void TMainForm::ProcessRemoteBiometricRevoke(
    int EmployeeId,
    const UnicodeString& EmployeeName,
    const UnicodeString& RequestId)
{
    if (RequestId.IsEmpty() || EmployeeId <= 0)
        return;

    // Se houver cadastro do MESMO funcionário em andamento,
    // a revogação prevalece e cancela o enrollment.
    if (FEnrollmentActive &&
        FEnrollmentEmployeeId == EmployeeId)
    {
        const UnicodeString EnrollmentRequestId =
            FRemoteEnrollmentRequestId;

        FEnrollmentActive = false;
        FEnrollmentEmployeeId = 0;
        FEnrollmentSamples.clear();
        FRemoteEnrollmentRequestId = L"";
        FRemoteEnrollmentEmployeeName = L"";

        if (!EnrollmentRequestId.IsEmpty())
        {
            SendEnrollmentResultToErp(
                EnrollmentRequestId,
                L"failed",
                L"Cadastro cancelado por remoção da identificação facial",
                0);
        }
    }

    const bool Existed =
        FFaceRepository != nullptr &&
        FFaceRepository->HasTemplate(EmployeeId);

    const bool Removed =
        FFaceRepository != nullptr &&
        FFaceRepository->DeleteTemplate(EmployeeId);

    if (Removed &&
        FRecognizedEmployeeId == EmployeeId)
    {
        ClearRecognizedFaceResult();
    }

    SendRevokeResultToErp(
        RequestId,
        Removed ? L"completed" : L"failed",
        Removed
            ? (Existed
                ? L"Template facial removido"
                : L"Template facial já estava ausente")
            : L"Falha ao remover o template facial");

    LblDeveloperStatus->Caption =
        Removed
            ? L"Identificação facial removida para EmployeeId " +
                IntToStr(EmployeeId) +
                (EmployeeName.IsEmpty()
                    ? L"."
                    : L" • " + EmployeeName)
            : L"Falha ao remover identificação facial do EmployeeId " +
                IntToStr(EmployeeId) + L".";
}

void TMainForm::ProcessPendingBiometricCommands()
{
    // Se um resultado final não conseguiu chegar ao ERP, tente novamente.
    // Enquanto ele estiver pendente, não inicie outro cadastro remoto.
    const bool EnrollmentResultChannelReady =
        FlushPendingEnrollmentResultToErp();

    const bool EmployeesReady =
        FEmployeeRepository != nullptr &&
        FEmployeeRepository->HasRemoteSnapshot();

    if (EmployeesReady && EnrollmentResultChannelReady)
    {
        const bool RemoteEnrollmentAlreadyActive =
            FEnrollmentActive &&
            !FRemoteEnrollmentRequestId.IsEmpty();

        if (!RemoteEnrollmentAlreadyActive)
        {
            TErpEnrollmentCommand EnrollmentCommand;

            if (TryGetPendingEnrollmentFromErp(
                    EnrollmentCommand))
            {
                BeginRemoteFaceEnrollment(
                    EnrollmentCommand.EmployeeId,
                    EnrollmentCommand.EmployeeName,
                    EnrollmentCommand.RequestId);
            }
        }
    }
    else if (!EmployeesReady && FEmployeeSyncClient != nullptr)
    {
        FEmployeeSyncClient->SyncNow();
    }

    // Remoção de identificação facial também usa o canal operacional
    // direto do ERP Delphi :3101. O WebServer :8080 não participa.
    const bool RevokeResultChannelReady =
        FlushPendingRevokeResultToErp();

    if (RevokeResultChannelReady)
    {
        TErpRevokeCommand RevokeCommand;

        if (TryGetPendingRevokeFromErp(
                RevokeCommand))
        {
            ProcessRemoteBiometricRevoke(
                RevokeCommand.EmployeeId,
                RevokeCommand.EmployeeName,
                RevokeCommand.RequestId);
        }
    }
}

void TMainForm::CompleteFaceEnrollment()
{
    const int SavedEmployeeId = FEnrollmentEmployeeId;
    const int SampleCount =
        static_cast<int>(FEnrollmentSamples.size());

    const UnicodeString RemoteRequestId =
        FRemoteEnrollmentRequestId;

    FaceFeature Template;

    const bool Built =
        BuildEnrollmentTemplate(Template);

    TEmployee EnrollmentEmployee;

    const bool EmployeeResolved =
        FEmployeeRepository != nullptr &&
        FEmployeeRepository->FindById(
            SavedEmployeeId,
            EnrollmentEmployee);

    const bool IdentityReady =
        EmployeeResolved &&
        !Trim(EnrollmentEmployee.FaceKey).IsEmpty();

    const bool Saved =
        Built &&
        IdentityReady &&
        FFaceRepository != nullptr &&
        FFaceRepository->SaveTemplate(
            SavedEmployeeId,
            EnrollmentEmployee.FaceKey,
            Template);

    if (Saved && FFaceRecognizer != nullptr)
    {
        FLastCorrectTestScore =
            FFaceRecognizer->Compare(
                Template,
                Template);
    }

    FEnrollmentActive = false;
    FEnrollmentEmployeeId = 0;
    FEnrollmentSamples.clear();

    FFacePreviewState =
        Saved
            ? TFacePreviewState::Detected
            : TFacePreviewState::NotRecognized;

    LblDeveloperStatus->Caption =
        Saved
            ? Format(
                L"Identificação facial salva para EmployeeId %d.",
                ARRAYOFCONST((SavedEmployeeId)))
            : L"Falha ao salvar o template de identificação facial.";

    // Cadastro remoto: resultado volta diretamente ao ERP Delphi :3101.
    if (!RemoteRequestId.IsEmpty())
    {
        SendEnrollmentResultToErp(
            RemoteRequestId,
            Saved ? L"completed" : L"failed",
            Saved
                ? L"Template salvo pela Portaria"
                : L"Falha ao salvar o template de identificação facial",
            SampleCount);
    }

    FRemoteEnrollmentRequestId = L"";
    FRemoteEnrollmentEmployeeName = L"";

    ApplyFacePreviewStatus();
}

void TMainForm::RejectFaceRecognition()
{
    // Se já estamos exibindo o resultado negativo, não rearmar o timer a cada
    // frame. Isso evita alternância em milissegundos entre Ready e NotRecognized.
    if (FFacePreviewState == TFacePreviewState::NotRecognized &&
        ReturnTimer != nullptr && ReturnTimer->Enabled)
    {
        return;
    }

    FRecognitionCandidateId = 0;
    FRecognitionCandidateHits = 0;
    FFacePreviewState = TFacePreviewState::NotRecognized;
    EmployeeResultPanel->Visible = false;

    if (ReturnTimer != nullptr)
    {
        ReturnTimer->Enabled = false;

        // Só rearma o retorno automático se o usuário continua realmente
        // na tela principal e o menu está fechado.
        if ((OverlayMenu == nullptr || !OverlayMenu->Visible) &&
            FCurrentPage == TAccessPage::Identification)
        {
            ReturnTimer->Interval = 2000;
            ReturnTimer->Enabled = true;
        }
    }

    ApplyFacePreviewStatus();
}

void TMainForm::ClearRecognizedFaceResult()
{
    FFaceRecognitionLocked = false;
    FRecognizedEmployeeId = 0;
    FRecognitionCandidateId = 0;
    FRecognitionCandidateHits = 0;
    FFacePreviewState = TFacePreviewState::Waiting;
    FIdentificationState = IdentificationState::WaitingForFace;
    FFaceMissFrames = 0;
    FSingleFaceFrames = 0;
    FStableFaceStartTick = 0;
    FLastFaceDetections.clear();
    FHasPrimaryFace = false;
    FPrimaryFaceDetection = FaceDetection();

    if (FIdentificationManager != nullptr)
    {
        FIdentificationManager->ClearIdentification();
    }

    if (EmployeeResultPanel != nullptr)
    {
        EmployeeResultPanel->Visible = false;
    }

    if (FEmployeePhotoImage != nullptr)
    {
        FEmployeePhotoImage->Visible = false;
    }

    if (FRecognitionCheckShape != nullptr)
    {
        FRecognitionCheckShape->Visible = false;
    }
    if (FRecognitionCheckLabel != nullptr)
    {
        FRecognitionCheckLabel->Visible = false;
    }

    LblPrompt->Caption = L"Aproxime-se para identificação";
    LblPrompt->Font->Color = RgbColor(245, 190, 79);

    LayoutTerminal();
    ApplyFacePreviewStatus();
}

void TMainForm::UpdateEmployeePhotoSnapshot(const TCameraFrame& Frame,
    const FaceDetection& Detection)
{
    if (FEmployeePhotoImage == nullptr || FEmployeePhotoBitmap == nullptr ||
        Frame.Empty() || Detection.Bounds.Empty())
    {
        return;
    }

    std::unique_ptr<Graphics::TBitmap> SourceBitmap(new Graphics::TBitmap());
    if (!FrameToBitmap(Frame, SourceBitmap.get()))
    {
        return;
    }

    const FaceRect& B = Detection.Bounds;

    // O card usa uma foto quadrada. Antes o recorte tinha proporção variável
    // e era forçado para 180x180, achatando/espremendo o rosto.
    // Agora geramos um crop quadrado ao redor da face.
    const double CenterX = B.X + (B.Width * 0.5);
    const double CenterY = B.Y + (B.Height * 0.48);

    int CropSize = static_cast<int>(std::round(
        std::max(B.Width * 1.55, B.Height * 1.35)));

    CropSize = std::max(96, CropSize);
    CropSize = std::min(CropSize, std::min(Frame.Width, Frame.Height));

    int Left = static_cast<int>(std::round(CenterX - (CropSize * 0.5)));
    int Top = static_cast<int>(std::round(CenterY - (CropSize * 0.48)));

    // Mantém o quadrado inteiro dentro do frame sem alterar a proporção.
    Left = std::max(0, std::min(Left, Frame.Width - CropSize));
    Top = std::max(0, std::min(Top, Frame.Height - CropSize));

    const int Right = Left + CropSize;
    const int Bottom = Top + CropSize;

    if (Right <= Left || Bottom <= Top)
    {
        return;
    }

    const int TargetSize = 220;
    FEmployeePhotoBitmap->PixelFormat = pf32bit;
    FEmployeePhotoBitmap->SetSize(TargetSize, TargetSize);

    // IMPORTANTE:
    // TCanvas::StretchDraw() recebe apenas o retângulo de DESTINO e desenha
    // o bitmap inteiro. O SourceRect calculado anteriormente não era usado,
    // por isso o frame 16:9 completo estava sendo espremido em um quadrado.
    //
    // StretchBlt permite informar explicitamente o retângulo de origem
    // (crop quadrado da face) e o destino quadrado.
    SetStretchBltMode(FEmployeePhotoBitmap->Canvas->Handle, HALFTONE);
    SetBrushOrgEx(FEmployeePhotoBitmap->Canvas->Handle, 0, 0, nullptr);

    StretchBlt(
        FEmployeePhotoBitmap->Canvas->Handle,
        0, 0, TargetSize, TargetSize,
        SourceBitmap->Canvas->Handle,
        Left, Top, CropSize, CropSize,
        SRCCOPY);

    FEmployeePhotoImage->Picture->Assign(FEmployeePhotoBitmap);
    FEmployeePhotoImage->Stretch = true;
    FEmployeePhotoImage->Proportional = true;
    FEmployeePhotoImage->Center = true;
    FEmployeePhotoImage->Visible = true;
    LblPhoto->Visible = false;
}

void __fastcall TMainForm::MenuHoverEnter(TObject* Sender)
{
    (void)Sender;
    if (BtnMenu != nullptr)
    {
        BtnMenu->Color = RgbColor(232, 44, 54);
        BtnMenu->Font->Size = 12;
        BtnMenu->Cursor = crHandPoint;
    }
}

void __fastcall TMainForm::MenuHoverLeave(TObject* Sender)
{
    (void)Sender;
    if (BtnMenu != nullptr)
    {
        BtnMenu->Color = RgbColor(198, 32, 42);
        BtnMenu->Font->Size = 11;
    }
}

void TMainForm::UpdateClock()
{
    const TDateTime NowValue = Now();
    LblClock->Caption = FormatDateTime(L"hh:nn", NowValue);
    LblDate->Caption = FormatDateTime(L"dddd, dd \"de\" mmmm \"de\" yyyy", NowValue);
}

void TMainForm::RefreshIdentificationView()
{
    ApplyFacePreviewStatus();
    LblCameraStatus->Caption =
        L"● Câmera " + FCameraManager->StatusText() +
        L" • índice " + IntToStr(FPreviewCameraIndex);

    if (!FIdentificationManager->HasCurrentEmployee())
    {
        if (FFacePreviewState != TFacePreviewState::Recognized)
        {
            EmployeeResultPanel->Visible = false;
        }
        UpdateCameraPreviewVisibility();
        ApplyFacePreviewStatus();
        return;
    }

    const TEmployee Employee = FIdentificationManager->CurrentEmployee();
    EmployeeResultPanel->Visible = true;
    EmployeeResultPanel->BringToFront();
    ShapeFaceFrame->Pen->Color = RgbColor(41, 214, 132);
    LblPrompt->Caption = L"ACESSO AUTORIZADO";
    LblPrompt->Font->Color = RgbColor(41, 214, 132);
    LblEmployeeState->Caption = L"IDENTIDADE CONFIRMADA";
    LblName->Caption = Employee.Name;
    LblDepartment->Caption = Employee.Department;
    LblIdentifiedAt->Caption = FormatDateTime(L"hh:nn:ss", FIdentificationManager->IdentifiedAt());
    LblFaceIndicator->Caption = L"FACE";
    LblFaceStatusDetail->Caption = L"● Confirmada";
    LblFaceIndicator->Font->Color = RgbColor(164, 176, 194);
    LblFaceStatusDetail->Font->Color = RgbColor(41, 214, 132);
    ApplyRfidStatus();
    UpdateCameraPreviewVisibility();
}

void TMainForm::ShowPage(TAccessPage Page)
{
    const TAccessPage PreviousPage = FCurrentPage;
    FCurrentPage = Page;

    if (Page == TAccessPage::BleDevices &&
        PreviousPage != TAccessPage::BleDevices)
    {
        // Uma leitura usada anteriormente para acesso não deve virar,
        // por acidente, candidata de cadastro administrativo.
        FRfidAdminUid = UnicodeString();
    }

    // A enumeração das câmeras é feita uma vez por execução.
    // Reabrir o menu não deve fechar/probar/reabrir todos os dispositivos,
    // pois isso pode alterar o comportamento do backend de captura.
    CloseMenu();

    if (Page == TAccessPage::Identification)
    {
        ShowIdentification();
        return;
    }

    ReturnTimer->Enabled = false;
    IdentificationView->Visible = false;
    SecondaryView->Visible = true;
    SecondaryView->BringToFront();
    LblAdminTitle->Caption = PageTitle(Page);
    LblAdminDescription->Caption = PageDescription(Page);
    UpdateDeveloperPanel();
    UpdateMenuSelection();
    LayoutTerminal();
}

void TMainForm::ShowIdentification()
{
    FCurrentPage = TAccessPage::Identification;
    SecondaryView->Visible = false;
    IdentificationView->Visible = true;
    IdentificationView->BringToFront();
    if (FTechBackground != nullptr)
    {
        FTechBackground->SendToBack();
        FTechBackground->Invalidate();
    }
    DeveloperPanel->Visible = false;
    CloseMenu();
    RefreshIdentificationView();
    UpdateDeveloperPanel();
    UpdateMenuSelection();

    if (FTechBackground != nullptr)
    {
        FTechBackground->SendToBack();
        FTechBackground->Invalidate();
    }

    if (FHeaderDecor != nullptr)
        FHeaderDecor->Invalidate();

    if (FCameraDecor != nullptr)
        FCameraDecor->Invalidate();

    if (FFooterDecor != nullptr)
        FFooterDecor->Invalidate();

    if (FProductVersion != nullptr)
    {
        FProductVersion->Visible = true;
        FProductVersion->BringToFront();
    }

}

void TMainForm::OpenMenu()
{
    // O menu deve ser independente do resultado da identificação facial.
    // Cancela qualquer retorno automático armado por "Pessoa não reconhecida".
    if (ReturnTimer != nullptr)
    {
        ReturnTimer->Enabled = false;
        ReturnTimer->Interval = 5000;
    }

    OverlayMenu->Visible = true;
    OverlayMenu->BringToFront();

    UpdateMenuSelection();
    LayoutTerminal();

    // LayoutTerminal reorganiza a interface. Garanta novamente o Z-order do menu.
    OverlayMenu->BringToFront();
}

void TMainForm::CloseMenu()
{
    OverlayMenu->Visible = false;
}


bool TMainForm::IsTotemLayout() const
{
    if (FLayoutMode == TTerminalLayoutMode::TotemVertical)
    {
        return true;
    }

    if (FLayoutMode == TTerminalLayoutMode::Horizontal)
    {
        return false;
    }

    // Automático: uma pequena histerese visual não é necessária porque
    // FormResize só relayouta os controles; não reinicia câmera/identificação facial.
    return ClientHeight > ClientWidth;
}

UnicodeString TMainForm::LayoutModeCaption() const
{
    switch (FLayoutMode)
    {
    case TTerminalLayoutMode::Horizontal:
        return L"HORIZONTAL";
    case TTerminalLayoutMode::TotemVertical:
        return L"TOTEM";
    default:
        return L"AUTOMÁTICO";
    }
}

void TMainForm::CycleLayoutMode()
{
    switch (FLayoutMode)
    {
    case TTerminalLayoutMode::Auto:
        FLayoutMode = TTerminalLayoutMode::Horizontal;
        break;
    case TTerminalLayoutMode::Horizontal:
        FLayoutMode = TTerminalLayoutMode::TotemVertical;
        break;
    default:
        FLayoutMode = TTerminalLayoutMode::Auto;
        break;
    }

    ResetFacePreviewState();
    UpdateDeveloperPanel();
    LayoutTerminal();
}

TCameraRotationMode TMainForm::EffectiveCameraRotation() const
{
    if (FCameraRotationMode != TCameraRotationMode::Auto)
    {
        return FCameraRotationMode;
    }

    return IsTotemLayout()
        ? TCameraRotationMode::Deg90CCW
        : TCameraRotationMode::Deg0;
}

UnicodeString TMainForm::CameraRotationCaption() const
{
    switch (FCameraRotationMode)
    {
    case TCameraRotationMode::Deg0:
        return L"0°";
    case TCameraRotationMode::Deg90CW:
        return L"90° →";
    case TCameraRotationMode::Deg90CCW:
        return L"90° ←";
    case TCameraRotationMode::Deg180:
        return L"180°";
    default:
        return L"AUTO";
    }
}

void TMainForm::CycleCameraRotation()
{
    switch (FCameraRotationMode)
    {
    case TCameraRotationMode::Auto:
        FCameraRotationMode = TCameraRotationMode::Deg0;
        break;
    case TCameraRotationMode::Deg0:
        FCameraRotationMode = TCameraRotationMode::Deg90CW;
        break;
    case TCameraRotationMode::Deg90CW:
        FCameraRotationMode = TCameraRotationMode::Deg90CCW;
        break;
    case TCameraRotationMode::Deg90CCW:
        FCameraRotationMode = TCameraRotationMode::Deg180;
        break;
    default:
        FCameraRotationMode = TCameraRotationMode::Auto;
        break;
    }

    ResetFacePreviewState();
    UpdateDeveloperPanel();
    LayoutTerminal();
}

void TMainForm::LayoutOverlayMenu(bool TotemMode)
{
    if (OverlayMenu == nullptr)
    {
        return;
    }

    OverlayMenu->Color = RgbColor(4, 12, 20);
    OverlayMenu->BevelOuter = bvNone;

	BtnMenuBack->Color = RgbColor(61, 61, 61);
    BtnMenuBack->Font->Name = L"Segoe UI Semibold";
    BtnMenuBack->Font->Size = TotemMode ? 10: 10;
    BtnMenuBack->Font->Color = clWhite;

	LblMenuHeader->Font->Name = L"Segoe UI";
    LblMenuHeader->Font->Size = TotemMode ? 10 : 10;
    LblMenuHeader->Font->Color = clWhite;

    LblMenuFooter->Font->Name = L"Segoe UI";
    LblMenuFooter->Font->Size = 8;
    LblMenuFooter->Font->Color = RgbColor(111, 145, 175);

    const int RootWidth = RootPanel->ClientWidth;
    const int RootHeight = RootPanel->ClientHeight;

    int MenuWidth = 0;
    int MenuLeft = 0;

    if (TotemMode)
    {
        // No totem, o menu vira uma folha quase de largura total.
        MenuWidth = std::max(360, RootWidth - 28);
        MenuLeft = (RootWidth - MenuWidth) / 2;
    }
    else
    {
        MenuWidth = ClampInt(RootWidth * 30 / 100, 460, 560);
        MenuLeft = RootWidth - MenuWidth;
    }

    OverlayMenu->SetBounds(MenuLeft, 0, MenuWidth, RootHeight);

    const int Side = TotemMode ? 24 : 28;
    const int ContentWidth = MenuWidth - (Side * 2);

    BtnMenuBack->SetBounds(Side, 24, ContentWidth, 58);
    LblMenuHeader->SetBounds(Side, 102, ContentWidth, 42);

    TPanel* Panels[] = {
        MenuIdentification, MenuPresent, MenuRecent, MenuCamera,
        MenuBle, MenuManual, MenuOccurrences, MenuSettings
    };

    TLabel* Icons[] = {
        LblMenuIdentificationIcon, LblMenuPresentIcon, LblMenuRecentIcon,
        LblMenuCameraIcon, LblMenuBleIcon, LblMenuManualIcon,
        LblMenuOccurrencesIcon, LblMenuSettingsIcon
    };

    TLabel* Titles[] = {
        LblMenuIdentificationTitle, LblMenuPresentTitle, LblMenuRecentTitle,
        LblMenuCameraTitle, LblMenuBleTitle, LblMenuManualTitle,
		LblMenuOccurrencesTitle, LblMenuSettingsTitle
    };

    TLabel* Descs[] = {
        LblMenuIdentificationDesc, LblMenuPresentDesc, LblMenuRecentDesc,
        LblMenuCameraDesc, LblMenuBleDesc, LblMenuManualDesc,
        LblMenuOccurrencesDesc, LblMenuSettingsDesc
    };

    TLabel* Arrows[] = {
        LblMenuIdentificationArrow, LblMenuPresentArrow, LblMenuRecentArrow,
        LblMenuCameraArrow, LblMenuBleArrow, LblMenuManualArrow,
        LblMenuOccurrencesArrow, LblMenuSettingsArrow
    };

    const int ItemHeight = TotemMode ? 88 : 96;
    const int ItemGap = TotemMode ? 9 : 12;
    int Y = 154;

    for (int I = 0; I < 8; ++I)
    {
        Panels[I]->BevelOuter = bvNone;
        Panels[I]->SetBounds(Side, Y, ContentWidth, ItemHeight);

        Icons[I]->Font->Name = L"Segoe UI Semibold";
        Icons[I]->Font->Size = TotemMode ? 15 : 17;
        Icons[I]->Font->Color = RgbColor(214, 229, 241);

        Titles[I]->Font->Name = L"Segoe UI Semibold";
        Titles[I]->Font->Size = TotemMode ? 11 : 12;
        Titles[I]->Font->Color = clWhite;

        Descs[I]->Font->Name = L"Segoe UI";
        Descs[I]->Font->Size = TotemMode ? 8 : 9;
        Descs[I]->Font->Color = RgbColor(177, 196, 214);

        Arrows[I]->Font->Name = L"Segoe UI Semibold";
        Arrows[I]->Font->Size = TotemMode ? 14 : 15;
        Arrows[I]->Font->Color = RgbColor(225, 236, 245);

        const int IconWidth = TotemMode ? 64 : 76;
        Icons[I]->SetBounds(12, 0, IconWidth, ItemHeight);

        const int TextLeft = IconWidth + 20;
        const int ArrowWidth = 42;
        const int TextWidth = ContentWidth - TextLeft - ArrowWidth - 10;

        Titles[I]->AutoSize = false;
        Titles[I]->WordWrap = false;
        Titles[I]->SetBounds(TextLeft, 14, TextWidth, 30);

        Descs[I]->AutoSize = false;
        Descs[I]->WordWrap = false;
        Descs[I]->SetBounds(TextLeft, 46, TextWidth, 25);

        Arrows[I]->SetBounds(ContentWidth - ArrowWidth - 8, 0,
            ArrowWidth, ItemHeight);

        Y += ItemHeight + ItemGap;
    }

    LblMenuFooter->SetBounds(Side, RootHeight - 46, ContentWidth, 28);
}

void TMainForm::LayoutTerminal()
{
    const bool PortraitMode = ClientHeight > ClientWidth;
	// Base visual corporativa.
	// fundo quase preto, mas com azul para separar
	// visualmente o terminal de uma janela VCL comum.
	const TColor BackgroundColor = RgbColor(13, 9, 15);
	const TColor CardColor = RgbColor(7, 20, 32);
	const TColor SubtleTextColor = RgbColor(170, 181, 194);
	const TColor BorderTextColor = RgbColor(219, 225, 232);

	const bool TotemMode = IsTotemLayout();
	const bool ShowRecognizedCard =
		EmployeeResultPanel != nullptr && EmployeeResultPanel->Visible;

	// Cabeçalho empresarial TSX. Nesta etapa usamos texto;
	// depois o mesmo espaço receberá o logo definitivo compartilhado com o ERP Delphi.
	LblAppName->Visible = true;
	LblAppName->Caption = L"C++Builder 13.1 Florence";
	LblClock->Visible = true;

	FaceStatusCard->Visible = false;
	BleStatusCard->Visible = false;
	LblCameraStatus->Visible = false;

	TopBarPanel->Align = alTop;
	ClockPanel->Align = alTop;

	// O bloco inferior acompanha a câmera, sem ficar preso ao rodapé da janela.
	// Isso elimina o vazio entre câmera e identificação.
	BottomStatusPanel->Align = alNone;
	PageHost->Align = alClient;
	IdentificationView->Align = alClient;

	// A câmera é posicionada manualmente apenas nesta página.
	// Isso permite que o card tenha exatamente a altura do vídeo 16:9,
    // sem áreas vazias e sem deformar a imagem.
    CameraPanel->Align = alNone;

    TopBarPanel->Height = TotemMode ? 56 : 60;
    ClockPanel->Height = PortraitMode ? 126 : 144;
    BottomStatusPanel->Height = ShowRecognizedCard
        ? (TotemMode ? 242 : 238)
        : (TotemMode ? 150 : 146);

    // Cabeçalho empresarial: marca à esquerda, terminal/status à direita.
    LblAppName->SetBounds(
        TotemMode ? 18 : 24,
        14,
        TotemMode ? 430 : 620,
        30);
    LblAppName->Font->Name = L"Segoe UI Semibold";
    LblAppName->Font->Size = PortraitMode ? 8 : (TotemMode ? 9 : 10);
    LblAppName->Font->Color = clWhite;
    if (FBrandSubtitle != nullptr)
    {
        FBrandSubtitle->Visible = false;
    }
    LblAppName->Font->Name = L"Segoe UI Semibold";
	LblAppName->Font->Size = TotemMode ? 11 : 11;
	LblAppName->Caption = L"C++Builder 13.1 - FLORENCE";
    TopBarPanel->Color = RgbColor(2, 7, 12);
    TopBarPanel->BevelOuter = bvNone;
    if (FHeaderDecor != nullptr)
    {
        FHeaderDecor->Visible = true;
        FHeaderDecor->SendToBack();
        FHeaderDecor->Invalidate();
    }
    TopBarPanel->Height = TotemMode ? 64 : 70;

    LblTerminal->SetBounds(
        TotemMode ? TopBarPanel->ClientWidth - 245 :
            TopBarPanel->ClientWidth - 290,
        18,
        TotemMode ? 125 : 155,
        26);

    LblOnline->SetBounds(
        TotemMode ? TopBarPanel->ClientWidth - 116 :
            TopBarPanel->ClientWidth - 124,
        18, 108, 26);

    if (PortraitMode)
    {
        // Cabeçalho compacto para orientação vertical.
        LblAppName->SetBounds(14, 12, TopBarPanel->ClientWidth - 28, 24);
        LblAppName->Alignment = taLeftJustify;
        LblAppName->Font->Size = 8;

        if (FBrandSubtitle != nullptr)
            FBrandSubtitle->Visible = false;

        LblTerminal->SetBounds(
            std::max(14, TopBarPanel->ClientWidth - 210),
            12,
            112,
            24);

        LblOnline->SetBounds(
            std::max(126, TopBarPanel->ClientWidth - 96),
            12,
            84,
            24);

        LblTerminal->Font->Size = 9;
        LblOnline->Font->Size = 9;
    }

    // Relógio no estilo terminal comercial: grande, centralizado e com
    // altura suficiente para não cortar os dígitos em DPI alto.
    LblClock->Align = alNone;
    LblClock->Alignment = taCenter;
    LblClock->Layout = tlCenter;
    LblClock->Font->Name = L"Segoe UI Light";
    LblClock->Font->Size = PortraitMode ? 30 : (TotemMode ? 36 : 42);
    LblClock->SetBounds(0, 8, ClockPanel->ClientWidth, PortraitMode ? 86 : 100);

    LblDate->Align = alNone;
    LblDate->Alignment = taCenter;
    LblDate->Layout = tlCenter;
    LblDate->Font->Name = L"Segoe UI";
    LblDate->Font->Size = PortraitMode ? 9 : (TotemMode ? 10 : 11);
    LblDate->SetBounds(0, PortraitMode ? 92 : 110, ClockPanel->ClientWidth, 28);

    // -----------------------------------------------------------------
    // Páginas administrativas / secundárias
    // -----------------------------------------------------------------
    SecondaryView->Align = alClient;

    if (SecondaryView->Visible)
    {
        const int SecondaryWidth = SecondaryView->ClientWidth;
        const int SecondaryHeight = SecondaryView->ClientHeight;

        const int SideMargin = TotemMode ? 24 : 56;
        const int ContentWidth = std::max(320, SecondaryWidth - (SideMargin * 2));

        BtnBackFromPage->Align = alNone;
        BtnBackFromPage->Align = alNone;
        BtnBackFromPage->AutoSize = false;
        BtnBackFromPage->Font->Name = L"Segoe UI Semibold";
        BtnBackFromPage->Font->Size = TotemMode ? 9 : 10;
        BtnBackFromPage->Alignment = taCenter;
        BtnBackFromPage->SetBounds(
            SideMargin,
            TotemMode ? 18 : 26,
            TotemMode ? std::min(330, ContentWidth) : 350,
            50);

        LblAdminTitle->Align = alNone;
        LblAdminTitle->AutoSize = false;
        LblAdminTitle->WordWrap = false;
        LblAdminTitle->Alignment = taLeftJustify;
        LblAdminTitle->Layout = tlCenter;
        LblAdminTitle->Font->Name = L"Segoe UI Semibold";
        LblAdminTitle->Font->Size = TotemMode ? 14 : 14;
        LblAdminTitle->SetBounds(
            SideMargin,
            TotemMode ? 88 : 102,
            ContentWidth,
            46);

        LblAdminDescription->Align = alNone;
        LblAdminDescription->AutoSize = false;
        LblAdminDescription->WordWrap = true;
        LblAdminDescription->Alignment = taLeftJustify;
        LblAdminDescription->Layout = tlTop;
        LblAdminDescription->Font->Name = L"Segoe UI";
        LblAdminDescription->Font->Size = TotemMode ? 9 : 10;
        LblAdminDescription->SetBounds(
            SideMargin,
            TotemMode ? 138 : 152,
            ContentWidth,
            TotemMode ? 58 : 48);

        if (FCurrentPage == TAccessPage::RecentEntries ||
            FCurrentPage == TAccessPage::PresentEmployees ||
            FCurrentPage == TAccessPage::ManualRelease ||
            FCurrentPage == TAccessPage::BleDevices ||
            FCurrentPage == TAccessPage::Incidents)
        {
            // Presença, histórico e liberação manual usam praticamente
            // toda a largura disponível.
            const int PanelTop = TotemMode ? 208 : 218;
            const int PanelHeight = std::max(
                280, SecondaryHeight - PanelTop - (TotemMode ? 24 : 34));

            DeveloperPanel->Align = alNone;
            DeveloperPanel->SetBounds(
                SideMargin,
                PanelTop,
                ContentWidth,
                PanelHeight);

            const int Inner = TotemMode ? 18 : 24;

            BtnSimulate->Font->Name = L"Segoe UI Semibold";
            BtnClear->Font->Name = L"Segoe UI Semibold";
            BtnStartCamera->Font->Name = L"Segoe UI Semibold";

            BtnSimulate->Font->Size = TotemMode ? 8 : 9;
            BtnClear->Font->Size = TotemMode ? 8 : 9;
            BtnStartCamera->Font->Size = TotemMode ? 8 : 9;

            LblDeveloperStatus->AutoSize = false;
            LblDeveloperStatus->WordWrap = false;
            LblDeveloperStatus->Alignment = taLeftJustify;
            LblDeveloperStatus->SetBounds(
                Inner,
                18,
                DeveloperPanel->ClientWidth - (Inner * 2),
                28);

            LstEmployees->SetBounds(
                Inner,
                58,
                DeveloperPanel->ClientWidth - (Inner * 2),
                std::max(150, DeveloperPanel->ClientHeight - 142));

            // Permite scroll horizontal caso um nome/setor excepcionalmente
            // longo ainda ultrapasse o espaço disponível.
            LstEmployees->ScrollWidth =
                std::max(LstEmployees->ClientWidth, 1100);

            if (FCurrentPage == TAccessPage::BleDevices)
            {
                // Faixa de leitura RFID dentro da própria área administrativa.
                // Assim o operador enxerga ONLINE/COM e o UID em tempo real,
                // sem precisar retornar à tela principal.
                if (FRfidReaderCard != nullptr)
                {
                    FRfidReaderCard->SetBounds(
                        Inner,
                        50,
                        DeveloperPanel->ClientWidth - (Inner * 2),
                        58);

                    if (FRfidReaderTitle != nullptr)
                        FRfidReaderTitle->SetBounds(
                            14, 7, 220, 20);

                    if (FRfidReaderStatus != nullptr)
                        FRfidReaderStatus->SetBounds(
                            std::max(240, FRfidReaderCard->ClientWidth - 390),
                            7,
                            376,
                            20);

                    if (FRfidReaderUid != nullptr)
                        FRfidReaderUid->SetBounds(
                            14,
                            30,
                            std::max(100, FRfidReaderCard->ClientWidth - 28),
                            22);

                    FRfidReaderCard->Visible = true;
                    FRfidReaderCard->BringToFront();
                }

                LstEmployees->SetBounds(
                    Inner,
                    118,
                    DeveloperPanel->ClientWidth - (Inner * 2),
                    std::max(105, DeveloperPanel->ClientHeight - 192));

                const int ButtonWidth = TotemMode ? 170 : 210;
                const int Gap = 16;
                const int ButtonsWidth = (ButtonWidth * 3) + (Gap * 2);
                const int ButtonsLeft =
                    std::max(Inner,
                        (DeveloperPanel->ClientWidth - ButtonsWidth) / 2);

                BtnSimulate->SetBounds(
                    ButtonsLeft,
                    DeveloperPanel->ClientHeight - 64,
                    ButtonWidth,
                    40);

                BtnClear->SetBounds(
                    ButtonsLeft + ButtonWidth + Gap,
                    DeveloperPanel->ClientHeight - 64,
                    ButtonWidth,
                    40);

                BtnStartCamera->SetBounds(
                    ButtonsLeft + ((ButtonWidth + Gap) * 2),
                    DeveloperPanel->ClientHeight - 64,
                    ButtonWidth,
                    40);

                BtnSimulate->Visible = true;
                BtnClear->Visible = true;
                BtnStartCamera->Visible = true;
                UpdateRfidAdminReader();
            }
            else if (FCurrentPage == TAccessPage::Incidents)
            {
                const int ButtonWidth = TotemMode ? 170 : 205;
                const int Gap = 12;
                const int ButtonCount = FIncidentHistoryMode ? 2 : 3;
                const int ButtonsWidth =
                    (ButtonWidth * ButtonCount) + (Gap * (ButtonCount - 1));
                const int ButtonsLeft =
                    std::max(Inner,
                        (DeveloperPanel->ClientWidth - ButtonsWidth) / 2);

                BtnSimulate->SetBounds(
                    ButtonsLeft,
                    DeveloperPanel->ClientHeight - 66,
                    ButtonWidth,
                    42);

                BtnClear->SetBounds(
                    ButtonsLeft + ButtonWidth + Gap,
                    DeveloperPanel->ClientHeight - 66,
                    ButtonWidth,
                    42);

                if (!FIncidentHistoryMode)
                {
                    BtnStartCamera->SetBounds(
                        ButtonsLeft + ((ButtonWidth + Gap) * 2),
                        DeveloperPanel->ClientHeight - 66,
                        ButtonWidth,
                        42);
                }
            }
            else if (FCurrentPage == TAccessPage::ManualRelease)
            {
                const int ButtonWidth = TotemMode ? 185 : 220;
                const int Gap = 14;
                const int ButtonsWidth = (ButtonWidth * 2) + Gap;
                const int ButtonsLeft =
                    std::max(Inner,
                        (DeveloperPanel->ClientWidth - ButtonsWidth) / 2);

                BtnSimulate->SetBounds(
                    ButtonsLeft,
                    DeveloperPanel->ClientHeight - 66,
                    ButtonWidth,
                    42);

                BtnClear->SetBounds(
                    ButtonsLeft + ButtonWidth + Gap,
                    DeveloperPanel->ClientHeight - 66,
                    ButtonWidth,
                    42);

                BtnSimulate->Visible = true;
            }
            else
            {
                BtnClear->SetBounds(
                    DeveloperPanel->ClientWidth - Inner - 220,
                    DeveloperPanel->ClientHeight - 64,
                    220,
                    40);

                BtnSimulate->Visible = false;
            }

            // O terceiro botão é usado na página RFID para recovery/reset
            // e na página de Ocorrências quando aplicável.
            if (FCurrentPage != TAccessPage::BleDevices &&
                FCurrentPage != TAccessPage::Incidents)
            {
                BtnStartCamera->Visible = false;
            }
        }
        else if (DeveloperPanel->Visible)
        {
            // Mantém as outras páginas administrativas em um card central
            // proporcional, sem invadir título/descrição.
            // Câmera e Configurações usam toda a coluna direita disponível,
            // partindo após o centro da tela e terminando na margem direita.
            const int RightPanelLeft = TotemMode
                ? SideMargin
                : (SecondaryWidth / 2) + 28;

            const int PanelWidth = TotemMode
                ? ContentWidth
                : std::max(560, SecondaryWidth - RightPanelLeft - SideMargin);

            DeveloperPanel->Align = alNone;
            DeveloperPanel->SetBounds(
                RightPanelLeft,
                TotemMode ? 208 : 196,
                PanelWidth,
                std::max(560, SecondaryHeight - (TotemMode ? 232 : 220)));

            if (FCurrentPage == TAccessPage::Settings)
            {
                FSettingsTestErpButton->Font->Name = L"Segoe UI Semibold";
                FSettingsSelectDbButton->Font->Name = L"Segoe UI Semibold";
                FSettingsSaveTerminalButton->Font->Name = L"Segoe UI Semibold";
                FSettingsDiagnosticButton->Font->Name = L"Segoe UI Semibold";

				FSettingsTestErpButton->Font->Size = TotemMode ? 4 : 5;
				FSettingsSelectDbButton->Font->Size = TotemMode ? 8 : 9;
				FSettingsSaveTerminalButton->Font->Size = TotemMode ? 4: 5;
				FSettingsDiagnosticButton->Font->Size = TotemMode ? 4 : 5;

                const int Inner = 20;
                const int Gap = 14;
                const int W =
                    std::max(320, DeveloperPanel->ClientWidth - (Inner * 2));
                const int AvailableH =
                    std::max(540, DeveloperPanel->ClientHeight - (Inner * 2));

                const int ErpH = 168;
                const int DataH = 198;
                const int TerminalH =
                    std::max(160, AvailableH - ErpH - DataH - (Gap * 2));

                FSettingsErpCard->SetBounds(
                    Inner, Inner, W, ErpH);
                FSettingsDataCard->SetBounds(
                    Inner, Inner + ErpH + Gap, W, DataH);
                FSettingsTerminalCard->SetBounds(
                    Inner,
                    Inner + ErpH + Gap + DataH + Gap,
                    W,
                    TerminalH);

                const int CW = W - 32;

                FSettingsErpTitle->SetBounds(16, 14, CW, 22);
                FSettingsErpStatus->SetBounds(16, 42, CW, 22);
                FSettingsErpInfo->SetBounds(16, 68, CW, 34);
                FSettingsApiEdit->SetBounds(16, 108, CW - 174, 30);
                FSettingsTestErpButton->SetBounds(
                    W - 158, 106, 142, 34);

                FSettingsDataTitle->SetBounds(16, 14, CW, 22);
                FSettingsEmployeeDbStatus->SetBounds(16, 44, CW, 22);
                FSettingsEmployeeDbPath->SetBounds(16, 68, CW, 22);
                FSettingsAccessDbStatus->SetBounds(16, 98, CW, 22);
                FSettingsAccessDbPath->SetBounds(16, 122, CW, 22);
                FSettingsSelectDbButton->SetBounds(
                    16, 152, CW, 34);

                FSettingsTerminalTitle->SetBounds(16, 14, CW, 22);
                FSettingsTerminalStatus->SetBounds(16, 42, CW, 38);
                const int TerminalButtonW = 158;
                const int TerminalButtonGap = 10;
                const int TerminalButtonsW =
                    (TerminalButtonW * 2) + TerminalButtonGap;

                FSettingsTerminalEdit->SetBounds(
                    16, 88,
                    std::max(160, CW - TerminalButtonsW - 12),
                    30);

				FSettingsSaveTerminalButton->SetBounds(
                    W - 16 - TerminalButtonsW,
                    86,
                    TerminalButtonW,
                    34);

                FSettingsDiagnosticButton->SetBounds(
                    W - 16 - TerminalButtonW,
                    86,
                    TerminalButtonW,
                    34);
            }

            if (FCurrentPage == TAccessPage::Camera)
            {
                BtnSimulate->Font->Name = L"Segoe UI Semibold";
                BtnClear->Font->Name = L"Segoe UI Semibold";
                BtnStartCamera->Font->Name = L"Segoe UI Semibold";
                BtnSimulate->Font->Size = TotemMode ? 8 : 9;
                BtnClear->Font->Size = TotemMode ? 8 : 9;
                BtnStartCamera->Font->Size = TotemMode ? 8 : 9;

                const int Inner = 24;
                const int ControlWidth =
                    std::max(260, DeveloperPanel->ClientWidth - (Inner * 2));

                LblDeveloperStatus->AutoSize = false;
                LblDeveloperStatus->WordWrap = true;
                LblDeveloperStatus->SetBounds(
                    Inner, 20, ControlWidth, 56);

                if (FCameraSelectorLabel != nullptr)
                    FCameraSelectorLabel->SetBounds(
                        Inner, 94, ControlWidth, 24);

                if (FCameraSelector != nullptr)
                    FCameraSelector->SetBounds(
                        Inner, 120, ControlWidth, 34);

                if (FCameraSettingsPreview != nullptr)
                    FCameraSettingsPreview->SetBounds(
                        Inner, 166, ControlWidth, 205);

                BtnSimulate->SetBounds(
                    Inner, 388, ControlWidth, 40);

                BtnClear->SetBounds(
                    Inner, 438, ControlWidth, 40);

                BtnStartCamera->SetBounds(
                    Inner, 488, ControlWidth, 40);

                BtnSimulate->Visible = true;
                BtnClear->Visible = true;
                BtnStartCamera->Visible = true;
            }
        }
    }

    CameraPanel->Color = RgbColor(6, 22, 36);
    CameraPanel->BevelOuter = bvNone;
    CameraPanel->BringToFront();
    if (FCameraDecor != nullptr)
    {
        FCameraDecor->Visible = true;
        FCameraDecor->BringToFront();
        FCameraDecor->Invalidate();
        if (FCameraPreviewImage != nullptr && FCameraPreviewImage->Visible)
            FCameraPreviewImage->BringToFront();
        if (FRecognitionCheckShape != nullptr)
            FRecognitionCheckShape->BringToFront();
        if (FRecognitionCheckLabel != nullptr)
            FRecognitionCheckLabel->BringToFront();
    }

    // ---------------------------------------------------------
    // COLUNA PRINCIPAL DA IDENTIFICAÇÃO
    // A câmera e o card do funcionário usam a mesma largura.
    // ---------------------------------------------------------
    const int OverlayReserve =
        (!TotemMode && OverlayMenu != nullptr && OverlayMenu->Visible)
            ? OverlayMenu->Width
            : 0;

    // Com o menu aberto, o terminal se reorganiza no espaço restante.
    const int LayoutWidth =
        std::max(1, IdentificationView->ClientWidth - OverlayReserve);

    const int MainContentWidth = PortraitMode
        ? ClampInt(LayoutWidth * 92 / 100, 360, std::max(360, LayoutWidth - 24))
        : (TotemMode
            ? std::max(320, LayoutWidth - 16)
            : ClampInt(LayoutWidth * 50 / 100, 660, 860));

    const int Padding = TotemMode ? 14 : 10;
    const int PromptHeight = PortraitMode ? 34 : (TotemMode ? 36 : 30);

    const TCameraRotationMode Rotation = EffectiveCameraRotation();
    const bool PortraitCamera =
        Rotation == TCameraRotationMode::Deg90CW ||
        Rotation == TCameraRotationMode::Deg90CCW;

    const int AspectW = PortraitCamera ? 9 : 16;
    const int AspectH = PortraitCamera ? 16 : 9;

    // O vídeo sempre mantém sua proporção. Em horizontal, a largura define
    // a altura 16:9; em rotação 90°, passa naturalmente para 9:16.
    int VideoWidth = std::max(1, MainContentWidth - (Padding * 2));
    int VideoHeight = VideoWidth * AspectH / AspectW;

    // Em orientação vertical, priorizamos a largura útil mas limitamos a altura
    // para reservar funcionário/status/menu. Nunca distorcemos a câmera.

    // Se o monitor for baixo, reduzimos largura e altura juntas.
    const int ReservedBottomHeight = PortraitMode
        ? (ShowRecognizedCard ? 260 : 170)
        : 8;

    const int MaxPanelHeight =
        std::max(220, IdentificationView->ClientHeight - ReservedBottomHeight);

    // Em vertical a câmera não pode dominar toda a tela.
    // Limitamos o vídeo a aproximadamente 67% da altura útil disponível,
    // preservando a proporção do frame.
    const int PortraitVideoCap = PortraitMode
        ? std::max(220, (IdentificationView->ClientHeight * 67) / 100)
        : MaxPanelHeight;

    const int MaxVideoHeight =
        std::max(
            120,
            std::min(
                MaxPanelHeight - PromptHeight - (Padding * 2),
                PortraitVideoCap - PromptHeight - (Padding * 2)));

    if (VideoHeight > MaxVideoHeight)
    {
        VideoHeight = MaxVideoHeight;
        VideoWidth = VideoHeight * AspectW / AspectH;
    }

    VideoWidth = std::max(1, VideoWidth);
    VideoHeight = std::max(1, VideoHeight);

    const int CameraPanelHeight =
        VideoHeight + PromptHeight + (Padding * 2);

    CameraPanel->Margins->Left = 0;
    CameraPanel->Margins->Right = 0;
    CameraPanel->Margins->Top = 0;
    CameraPanel->Margins->Bottom = 0;

    CameraPanel->SetBounds(
        (LayoutWidth - MainContentWidth) / 2,
        4,
        MainContentWidth,
        CameraPanelHeight);

    // O bloco de identificação passa a ficar imediatamente abaixo do card da câmera.
    const int StatusGap = PortraitMode ? 14 : (TotemMode ? 10 : 12);
    const int StatusTop = CameraPanel->Top + CameraPanel->Height + StatusGap;
    // Altura real do painel inferior. Precisa acomodar:
    // card do funcionário + FACE/BLE + MENU + rodapé.
    const int StatusHeight = ShowRecognizedCard
        ? (PortraitMode ? 312 : (TotemMode ? 304 : 302))
        : (PortraitMode ? 208 : (TotemMode ? 204 : 200));

    BottomStatusPanel->SetBounds(
        0,
        StatusTop,
        LayoutWidth,
        StatusHeight);
    BottomStatusPanel->Visible = true;
    BottomStatusPanel->BringToFront();

    const int VideoLeft =
        (CameraPanel->ClientWidth - VideoWidth) / 2;
    const int VideoTop = Padding;

    if (FCameraModeBadge != nullptr)
    {
        FCameraModeBadge->Font->Size = PortraitMode ? 6 : 7;
        FCameraModeBadge->SetBounds(
            VideoLeft + 12,
            VideoTop + 8,
            std::max(120, std::min(220, VideoWidth - 90)),
            18);
        FCameraModeBadge->BringToFront();
    }

    if (FIdleVisual != nullptr)
    {
        FIdleVisual->Align = alNone;
        FIdleVisual->SetBounds(
            VideoLeft,
            VideoTop,
            VideoWidth,
            VideoHeight);
    }

    // Lottie usa a mesma área útil do vídeo. Quando não há rosto, ocupa
    // exatamente o espaço que depois será substituído pela webcam.
    if (FIdleLottie != nullptr)
    {
        const int AnimWidth =
            std::min(VideoWidth * (TotemMode ? 64 : 46) / 100, 320);
        const int AnimHeight =
            std::min(VideoHeight * 48 / 100, TotemMode ? 250 : 210);

        FIdleLottie->Align = alNone;
        FIdleLottie->SetBounds(
            (CameraPanel->ClientWidth - AnimWidth) / 2,
            VideoTop + std::max(8, (VideoHeight - AnimHeight) / 2 - 38),
            AnimWidth,
            AnimHeight);
    }

    if (FCameraPreviewImage != nullptr)
    {
        FCameraPreviewImage->Align = alNone;
        FCameraPreviewImage->Stretch = true;
        FCameraPreviewImage->Proportional = true;
        FCameraPreviewImage->Center = true;
        FCameraPreviewImage->SetBounds(
            VideoLeft, VideoTop, VideoWidth, VideoHeight);
    }

    // Check de confirmação no canto do vídeo.
    const int CheckSize = TotemMode ? 40 : 34;
    const int CheckLeft = VideoLeft + VideoWidth - CheckSize - 12;
    const int CheckTop = VideoTop + 12;

    if (FRecognitionCheckShape != nullptr)
    {
        FRecognitionCheckShape->SetBounds(
            CheckLeft, CheckTop, CheckSize, CheckSize);
    }

    if (FRecognitionCheckLabel != nullptr)
    {
        FRecognitionCheckLabel->Font->Size = TotemMode ? 18 : 16;
        FRecognitionCheckLabel->SetBounds(
            CheckLeft, CheckTop - 1, CheckSize, CheckSize);
    }

    // Moldura tecnológica fixa do card da câmera.
    ShapeFaceFrame->Visible = true;
    ShapeFaceFrame->Shape = stRectangle;
    ShapeFaceFrame->Brush->Style = bsClear;
    ShapeFaceFrame->Pen->Color = RgbColor(26, 125, 210);
    ShapeFaceFrame->Pen->Width = 1;
    ShapeFaceFrame->SetBounds(
        VideoLeft - 4,
        VideoTop - 4,
        VideoWidth + 8,
        VideoHeight + 8);
    ShapeFaceFrame->SendToBack();

	LblFaceGlyph->Alignment = taCenter;
	LblFaceGlyph->Layout = tlCenter;
	LblFaceGlyph->Font->Name = L"Segoe UI Semibold";
	LblFaceGlyph->Font->Size = PortraitMode ? 12 : (TotemMode ? 14 : 15);
	LblFaceGlyph->Font->Color =
	RgbColor(64, 187, 255);

    const int IdleTitleTop =
        VideoTop + (VideoHeight * 56 / 100);

    LblFaceGlyph->Align = alNone;
    LblFaceGlyph->AutoSize = false;
    LblFaceGlyph->Layout = tlCenter;
    LblFaceGlyph->SetBounds(
        VideoLeft,
        IdleTitleTop - 4,
        VideoWidth,
        30);

LblCameraPlaceholder->Alignment = taCenter;
LblCameraPlaceholder->Layout = tlCenter;
LblCameraPlaceholder->Font->Name = L"Segoe UI";
LblCameraPlaceholder->Font->Size =
    TotemMode ? 9 : 10;
LblCameraPlaceholder->Font->Color =
    RgbColor(150, 170, 195);

LblCameraPlaceholder->Font->Size =
    PortraitMode ? 8 : 9;

LblCameraPlaceholder->Align = alNone;
LblCameraPlaceholder->AutoSize = false;
LblCameraPlaceholder->Layout = tlCenter;
LblCameraPlaceholder->SetBounds(
        VideoLeft + 24,
        IdleTitleTop + 52,
        VideoWidth - 48,
        26);


    LblPrompt->Alignment = taCenter;
    LblPrompt->Layout = tlCenter;
    LblPrompt->Font->Size = TotemMode ? 12 : 11;
    LblPrompt->SetBounds(
        18,
        VideoTop + VideoHeight + 1,
        CameraPanel->ClientWidth - 36,
        PromptHeight - 2);

    const int CenterX = BottomStatusPanel->ClientWidth / 2;

    if (ShowRecognizedCard)
   {
	const int ResultWidth = MainContentWidth;

        const int ResultHeight = PortraitMode ? 98 : (TotemMode ? 102 : 98);

        EmployeeResultPanel->SetBounds(
            CenterX - (ResultWidth / 2),
            4,
            ResultWidth,
            ResultHeight);

        const int PhotoSize = TotemMode ? 76 : 78;
        PhotoPanel->SetBounds(12, 14, PhotoSize, PhotoSize);
        LblPhoto->SetBounds(
            0, 0, PhotoPanel->ClientWidth, PhotoPanel->ClientHeight);

        const int InfoLeft = PhotoSize + 28;
        const int InfoWidth = ResultWidth - InfoLeft - 16;

        LblEmployeeState->AutoSize = false;
        LblEmployeeState->WordWrap = false;
        LblEmployeeState->Alignment = taLeftJustify;
        LblEmployeeState->Font->Size = TotemMode ? 8 : 9;
        LblEmployeeState->SetBounds(
            InfoLeft, 10, InfoWidth, 20);

        LblName->AutoSize = false;
        LblName->WordWrap = false;
        LblName->Alignment = taLeftJustify;
        LblName->Font->Size = PortraitMode ? 13 : (TotemMode ? 14 : 15);
        LblName->SetBounds(
            InfoLeft, 31, InfoWidth, 34);

        LblDepartment->AutoSize = false;
        LblDepartment->WordWrap = false;
        LblDepartment->Alignment = taLeftJustify;
        LblDepartment->Font->Size = 9;

        LblIdentifiedAt->AutoSize = false;
        LblIdentifiedAt->WordWrap = false;
        LblIdentifiedAt->Font->Size = 8;

        if (TotemMode || ResultWidth < 690)
        {
            LblDepartment->SetBounds(
                InfoLeft, 68, InfoWidth * 50 / 100, 22);

            LblIdentifiedAt->Alignment = taRightJustify;
            LblIdentifiedAt->SetBounds(
                InfoLeft + (InfoWidth * 50 / 100),
                68,
                InfoWidth * 50 / 100,
                22);
        }
        else
        {
            LblDepartment->SetBounds(
                InfoLeft, 68, InfoWidth * 55 / 100, 22);

            LblIdentifiedAt->Alignment = taRightJustify;
            LblIdentifiedAt->SetBounds(
                InfoLeft + (InfoWidth * 55 / 100),
                68,
                InfoWidth * 45 / 100,
                22);
        }
    }

    // ---------------------------------------------------------
    // BARRA DE STATUS EMPRESARIAL
    // Apenas visual: usa os componentes FACE/BLE já existentes.
    // ---------------------------------------------------------
    // IMPORTANT: status cards must start AFTER the employee card.
    // Previous fixed values (100/104) overlapped the employee card by a few
    // pixels, clipping FACE/RFID/TERMINAL at the top.
    const int FactorTop = ShowRecognizedCard
        ? (EmployeeResultPanel->Top + EmployeeResultPanel->Height + 8)
        : 8;

    const int FactorLeft =
        (BottomStatusPanel->ClientWidth - MainContentWidth) / 2;
    const int FactorGap = 8;
    const int FactorWidth =
        std::max(110, (MainContentWidth - (FactorGap * 2)) / 3);

    LblFaceIndicator->Parent = FaceStatusCard;
    LblFaceStatusDetail->Parent = FaceStatusCard;

    FaceStatusCard->Visible = true;
    FaceStatusCard->Align = alNone;
    FaceStatusCard->Color = RgbColor(5, 18, 29);
    FaceStatusCard->BevelOuter = bvNone;
    FaceStatusCard->SetBounds(
        FactorLeft,
        FactorTop,
        FactorWidth,
        60);

    LblBleIndicator->Parent = BleStatusCard;
    LblBleStatusDetail->Parent = BleStatusCard;

    BleStatusCard->Visible = true;
    BleStatusCard->Align = alNone;
    BleStatusCard->Color = RgbColor(5, 18, 29);
    BleStatusCard->BevelOuter = bvNone;
    BleStatusCard->SetBounds(
        FactorLeft + FactorWidth + FactorGap,
        FactorTop,
        FactorWidth,
        60);

    if (FTerminalStatusCard != nullptr)
    {
        FTerminalStatusCard->Visible = true;
        FTerminalStatusCard->Color = RgbColor(5, 18, 29);
        FTerminalStatusCard->Align = alNone;
        FTerminalStatusCard->SetBounds(
            FactorLeft + ((FactorWidth + FactorGap) * 2),
            FactorTop,
            FactorWidth,
            60);
    }

    // Terceiro bloco visual: reaproveita o status real da câmera.
    if (FTerminalStatusCard != nullptr)
    {
        LblCameraStatus->Parent = FTerminalStatusCard;
        if (FTerminalStatusTitle != nullptr)
            FTerminalStatusTitle->Parent = FTerminalStatusCard;
    }
    LblCameraStatus->Visible = true;
    LblCameraStatus->Transparent = false;
    LblCameraStatus->Color = RgbColor(5, 18, 29);
    LblCameraStatus->Alignment = taCenter;
    LblCameraStatus->Layout = tlCenter;
    LblCameraStatus->Font->Name = L"Segoe UI Semibold";
    LblCameraStatus->Font->Size = PortraitMode ? 8 : 9;
    LblCameraStatus->Font->Color = RgbColor(70, 205, 255);
    LblCameraStatus->Font->Style = TFontStyles() << fsBold;
    if (FTerminalStatusTitle != nullptr)
    {
        FTerminalStatusTitle->Align = alNone;
        FTerminalStatusTitle->AutoSize = false;
        FTerminalStatusTitle->WordWrap = false;
        FTerminalStatusTitle->Alignment = taCenter;
        FTerminalStatusTitle->Layout = tlCenter;
        FTerminalStatusTitle->Font->Size = 9;
        FTerminalStatusTitle->SetBounds(0, 5, FactorWidth, 22);
        FTerminalStatusTitle->BringToFront();

        LblCameraStatus->Align = alNone;
        LblCameraStatus->AutoSize = false;
        LblCameraStatus->WordWrap = false;
        LblCameraStatus->Alignment = taCenter;
        LblCameraStatus->Layout = tlCenter;
        LblCameraStatus->Font->Size = 8;
        LblCameraStatus->SetBounds(4, 31, FactorWidth - 8, 22);
        LblCameraStatus->BringToFront();
    }

    LblFaceIndicator->Align = alNone;
    LblFaceIndicator->AutoSize = false;
    LblFaceIndicator->WordWrap = false;
    LblFaceIndicator->Alignment = taCenter;
    LblFaceIndicator->Layout = tlCenter;
    LblFaceIndicator->Font->Size = 9;
    LblFaceIndicator->SetBounds(0, 5, FactorWidth, 22);

    LblFaceStatusDetail->Align = alNone;
    LblFaceStatusDetail->AutoSize = false;
    LblFaceStatusDetail->WordWrap = false;
    LblFaceStatusDetail->Alignment = taCenter;
    LblFaceStatusDetail->Layout = tlCenter;
    LblFaceStatusDetail->Font->Size = 8;
    LblFaceStatusDetail->SetBounds(
        4, 31, FactorWidth - 8, 22);

    LblBleIndicator->Align = alNone;
    LblBleIndicator->AutoSize = false;
    LblBleIndicator->WordWrap = false;
    LblBleIndicator->Caption = L"RFID";
    LblBleIndicator->Alignment = taCenter;
    LblBleIndicator->Layout = tlCenter;
    LblBleIndicator->Font->Size = 9;
    LblBleIndicator->SetBounds(0, 5, FactorWidth, 22);

    LblBleStatusDetail->Align = alNone;
    LblBleStatusDetail->AutoSize = false;
    LblBleStatusDetail->WordWrap = false;
    LblBleStatusDetail->Alignment = taCenter;
    LblBleStatusDetail->Layout = tlCenter;
    LblBleStatusDetail->Font->Size = 8;
    LblBleStatusDetail->SetBounds(
        4, 31, FactorWidth - 8, 22);

    // Botão MENU vira a única ação permanente sob a identificação.
    // MENU always follows the operational status bar.
    // No magic constants => horizontal/vertical cannot overlap the labels.
    const int MenuTop = FactorTop + 66;

    // Rodapé com sensação de base física: faixa larga e botão central encaixado.
    MenuCenterPanel->SetBounds(
        CenterX - (MainContentWidth / 2),
        MenuTop,
        MainContentWidth,
        88);
	// Rodapé estrutural TSX: vinho escuro no corpo e botão vermelho em
    // primeiro plano, lembrando a base física de um terminal comercial.
    MenuCenterPanel->Color = RgbColor(92, 4, 18);
    MenuCenterPanel->BevelOuter = bvNone;
    if (FFooterDecor != nullptr)
    {
        FFooterDecor->Visible = true;
        FFooterDecor->SendToBack();
        FFooterDecor->Invalidate();
    }

    BtnMenu->SetBounds(
        (MenuCenterPanel->ClientWidth - 184) / 2,
        0,
        184,
        46);
    BtnMenu->Color = RgbColor(216, 28, 43);
    BtnMenu->Font->Name = L"Segoe UI Semibold";
    BtnMenu->Font->Size = 11;
    BtnMenu->Color = RgbColor(218, 28, 44);
    MenuCenterPanel->BringToFront();
    if (FFooterDecor != nullptr)
        FFooterDecor->SendToBack();
    BtnMenu->BringToFront();
    LblMenuHint->BringToFront();
    BtnMenu->Font->Name = L"Segoe UI Semibold";
    BtnMenu->Font->Size = 11;
    BtnMenu->Font->Color = clWhite;

    LblMenuHint->Visible = false;
	LblMenuHint->Caption = L"Portaria   |   C++ TERMINAL   |   IDENTIFICA • AUTENTICA • INTEGRA   |   v1.0.0";
    LblMenuHint->Alignment = taCenter;
    LblMenuHint->Font->Name = L"Segoe UI";
    LblMenuHint->Font->Size = 7;
    LblMenuHint->Font->Color = RgbColor(135, 155, 176);
    LblMenuHint->SetBounds(
        (BottomStatusPanel->ClientWidth - MainContentWidth) / 2,
        MenuTop + 46,
        MainContentWidth,
        20);
    if (FProductVersion != nullptr)
    {
        FProductVersion->Align = alNone;
        FProductVersion->AutoSize = false;
        FProductVersion->WordWrap = false;
        FProductVersion->Layout = tlCenter;
        FProductVersion->Visible = true;
        FProductVersion->SetBounds(
            14,
            56,
            MenuCenterPanel->ClientWidth - 28,
            22);
        FProductVersion->BringToFront();
    }


    BottomStatusPanel->Color = RgbColor(5, 10, 16);
    ShapeFaceFrame->Pen->Color = BorderTextColor;

    LayoutOverlayMenu(TotemMode);

    ApplyRoundedCorners(CameraPanel, TotemMode ? 20 : 24);
    ApplyRoundedCorners(PhotoPanel, 20);
    ApplyRoundedCorners(EmployeeResultPanel, 22);
    ApplyRoundedCorners(BtnMenu, 18);
    ApplyRoundedCorners(BtnBackFromPage, 22);
    ApplyRoundedCorners(DeveloperPanel, 22);
    ApplyRoundedCorners(OverlayMenu, 0);
	ApplyRoundedCorners(BtnMenuBack, 18);
    ApplyRoundedCorners(MenuIdentification, 16);
    ApplyRoundedCorners(MenuPresent, 16);
    ApplyRoundedCorners(MenuRecent, 16);
    ApplyRoundedCorners(MenuCamera, 16);
    ApplyRoundedCorners(MenuBle, 16);
    ApplyRoundedCorners(MenuManual, 16);
    ApplyRoundedCorners(MenuOccurrences, 16);
    ApplyRoundedCorners(MenuSettings, 16);

    UpdateCameraPreviewVisibility();
}

void TMainForm::UpdateMenuSelection()
{
    TPanel* Panels[] = {
        MenuIdentification, MenuPresent, MenuRecent, MenuCamera,
        MenuBle, MenuManual, MenuOccurrences, MenuSettings
    };

    for (int Index = 0; Index < 8; ++Index)
    {
        Panels[Index]->Color = RgbColor(18, 34, 52);
    }

    Panels[static_cast<int>(FCurrentPage)]->Color = RgbColor(24, 96, 154);
}

void TMainForm::ApplyRoundedCorners(TWinControl* Control, int Radius)
{
    if (Control == nullptr || !Control->HandleAllocated())
    {
        return;
    }

    HRGN Region = CreateRoundRectRgn(0, 0, Control->Width + 1, Control->Height + 1,
        Radius, Radius);
    SetWindowRgn(Control->Handle, Region, TRUE);
}

TAccessPage TMainForm::PageFromTag(int Tag) const
{
    switch (Tag)
    {
    case 1: return TAccessPage::PresentEmployees;
    case 2: return TAccessPage::RecentEntries;
    case 3: return TAccessPage::Camera;
    case 4: return TAccessPage::BleDevices;
    case 5: return TAccessPage::ManualRelease;
    case 6: return TAccessPage::Incidents;
    case 7: return TAccessPage::Settings;
    default: return TAccessPage::Identification;
    }
}

UnicodeString TMainForm::PageTitle(TAccessPage Page) const
{
    switch (Page)
    {
	case TAccessPage::PresentEmployees: return L"Funcionários presentes";
    case TAccessPage::RecentEntries: return L"Últimas entradas";
    case TAccessPage::Camera: return L"Câmera";
    case TAccessPage::BleDevices: return L"TAG RFID";
    case TAccessPage::ManualRelease: return L"Liberação manual";
    case TAccessPage::Incidents: return L"Ocorrências";
    case TAccessPage::Settings: return L"Configurações";
    default: return L"Identificação";
    }
}

UnicodeString TMainForm::PageDescription(TAccessPage Page) const
{
    switch (Page)
    {
    case TAccessPage::PresentEmployees:
        return L"Funcionários identificados como presentes neste terminal durante o dia atual.";
    case TAccessPage::RecentEntries:
        return L"Consulte as identificações e os acessos mais recentes registrados por este terminal.";
    case TAccessPage::Camera:
        return L"Selecione a webcam do terminal, valide o vídeo e configure layout e rotação da imagem.";
    case TAccessPage::BleDevices:
        return L"Associe, consulte ou remova TAGs RFID dos funcionários cadastrados no sistema.";
    case TAccessPage::ManualRelease:
        return L"Selecione um funcionário e registre uma liberação de acesso assistida pela portaria.";
    case TAccessPage::Incidents:
        return L"Gerencie bloqueios, liberações e ocorrências relacionadas aos acessos dos funcionários.";
    case TAccessPage::Settings:
        return L"Configure banco corporativo, integração com o ERP Delphi e parâmetros operacionais do terminal.";
    default:
        return L"Tela principal de identificação";
    }
}

UnicodeString TMainForm::TerminalDisplayName() const
{
    return StringReplace(FConfig.TerminalName, L"-", L" ", TReplaceFlags() << rfReplaceAll);
}

void __fastcall TMainForm::FormResize(TObject *Sender)
{
    (void)Sender;
    LayoutTerminal();

    if (FCurrentPage == TAccessPage::Camera)
    {
        UpdateDeveloperPanel();
    }
}

void __fastcall TMainForm::ClockTimerTimer(TObject *Sender)
{
    (void)Sender;
    UpdateClock();

    ProcessEmployeeSyncStatus();

    // Cadastro facial remoto consulta diretamente o ERP Delphi :3101.
    // Observabilidade continua independente no WebServer :8080.
    ProcessPendingBiometricCommands();
}

void __fastcall TMainForm::ReturnTimerTimer(TObject *Sender)
{
    (void)Sender;
    ReturnTimer->Enabled = false;
    ReturnTimer->Interval = 5000;

    // Nunca interromper um cadastro de identificação facial em andamento.
    // O enrollment só deve terminar por CompleteFaceEnrollment() ou por uma
    // ação explícita do operador.
    if (FEnrollmentActive)
    {
        return;
    }

    // O ReturnTimer serve apenas para limpar o resultado da tela principal.
    // Nunca pode fechar o menu ou retirar o operador de uma tela administrativa.
    if ((OverlayMenu != nullptr && OverlayMenu->Visible) ||
        FCurrentPage != TAccessPage::Identification)
    {
        ReturnTimer->Enabled = false;
        return;
    }

    FIdentificationManager->ClearIdentification();

    // Limpa somente o estado visual da última leitura.
    // O vínculo da TAG permanece persistido normalmente no banco.
    FLastRfidUid = UnicodeString();
    FLastRfidState = TRfidVisualState::Idle;

    ResetFacePreviewState();
    ShowIdentification();
    ApplyRfidStatus();
}

void __fastcall TMainForm::MenuButtonClick(TObject *Sender)
{
    (void)Sender;

    if (ReturnTimer != nullptr)
        ReturnTimer->Enabled = false;

    // MENU funciona como abre/fecha e não depende de uma face reconhecida.
    if (OverlayMenu != nullptr && OverlayMenu->Visible)
    {
        CloseMenu();
        return;
    }

    OpenMenu();
}

void __fastcall TMainForm::BackToIdentificationClick(TObject *Sender)
{
	(void)Sender;
    ReturnTimer->Enabled = false;

    // v0.7.4.2:
    // A câmera permanece aberta durante as telas administrativas.
    // Ao voltar para a identificação, limpamos somente qualquer resultado/lock
    // facial transitório criado antes de entrar no menu. Isso evita esperar
    // misses do detector para que o preview principal volte a ficar disponível.
    //
    // IMPORTANTE: não fechamos nem reabrimos FCameraManager aqui.
    if (!FEnrollmentActive)
    {
        ClearRecognizedFaceResult();
    }

	ShowIdentification();
    LayoutTerminal();
}

void __fastcall TMainForm::MenuItemClick(TObject *Sender)
{
    TComponent* Component = dynamic_cast<TComponent*>(Sender);
    if (Component == nullptr)
    {
        return;
    }

    const TAccessPage TargetPage =
        PageFromTag(Component->Tag);

    if (FEnrollmentActive &&
        TargetPage == TAccessPage::Camera)
    {
        MessageDlg(
            L"Cadastro de identificação facial em andamento.\n\n"
            L"A troca de câmera fica bloqueada até concluir as 8 amostras.",
            mtInformation,
            TMsgDlgButtons() << mbOK,
            0);
        return;
    }

	ShowPage(TargetPage);
    LayoutTerminal();
}

void __fastcall TMainForm::StartCameraClick(TObject *Sender)
{
    (void)Sender;

    if (FCurrentPage == TAccessPage::BleDevices)
    {
        if (FRfidSerialReader == nullptr ||
            !FRfidSerialReader->IsPortOpen())
        {
            MessageDlg(
                L"A porta serial do RFID não está aberta.\n\n"
                L"Verifique a conexão USB/COM5.",
                mtWarning,
                TMsgDlgButtons() << mbOK,
                0);
            return;
        }

        const int Choice = MessageDlg(
            L"RECUPERAÇÃO DO RFID\n\n"
            L"SIM  = reiniciar somente o leitor RC522 (recomendado)\n"
            L"NÃO  = reiniciar completamente o ESP32-S3\n"
            L"CANCELAR = não fazer nada\n\n"
            L"Use primeiro a recuperação do RC522. Ela mantém a porta COM aberta.",
            mtConfirmation,
            TMsgDlgButtons() << mbYes << mbNo << mbCancel,
            0);

        if (Choice == mrYes)
        {
            if (FRfidSerialReader->RecoverReader())
            {
                LblDeveloperStatus->Caption =
                    L"Comando de recuperação enviado ao RC522. Aguarde o status ONLINE.";
                FLastRfidUid = UnicodeString();
                FLastRfidState = TRfidVisualState::Idle;
                FRfidAdminUid = UnicodeString();
                ApplyRfidStatus();
                UpdateRfidAdminReader();
            }
            return;
        }

        if (Choice == mrNo)
        {
            if (MessageDlg(
                    L"O ESP32-S3 será reiniciado por software.\n"
                    L"A COM5 pode desaparecer por alguns instantes e a Portaria "
                    L"tentará reconectar automaticamente.\n\n"
                    L"Confirmar reinício completo?",
                    mtWarning,
                    TMsgDlgButtons() << mbYes << mbNo,
                    0) == mrYes)
            {
                if (FRfidSerialReader->RestartDevice())
                {
                    LblDeveloperStatus->Caption =
                        L"Reinício do ESP32-S3 solicitado. Aguardando reconexão automática...";
                    FLastRfidUid = UnicodeString();
                    FLastRfidState = TRfidVisualState::Idle;
                    FRfidAdminUid = UnicodeString();
                    ApplyRfidStatus();
                    UpdateRfidAdminReader();
                }
            }
        }

        return;
    }

    if (FCurrentPage == TAccessPage::Incidents)
    {
        FIncidentHistoryMode = true;
        UpdateOccurrencePageButtons();
        RefreshOccurrences();
        return;
    }

    if (FCameraManager->IsOpen())
    {
        StopCameraPreview();
    }
    else
    {
        StartCameraPreview();
    }

    UpdateDeveloperPanel();
    RefreshIdentificationView();
}

void __fastcall TMainForm::SimulateClick(TObject *Sender)
{
    (void)Sender;

    if (FCurrentPage == TAccessPage::Camera)
    {
        CycleLayoutMode();
        return;
    }

    if (FCurrentPage == TAccessPage::ManualRelease)
    {
        TEmployee Employee;
        if (!TryGetSelectedEmployee(Employee))
        {
            MessageDlg(
                L"Selecione um funcionário para realizar a liberação manual.",
                mtWarning,
                TMsgDlgButtons() << mbOK,
                0);
            return;
        }

        const UnicodeString Question =
            L"Confirmar liberação manual para:\n\n" +
            Employee.Name +
            (Employee.Department.IsEmpty()
                ? UnicodeString()
                : L"\n" + Employee.Department) +
			L"\n\nO evento será registrado no histórico da Portaria 01.";

        if (MessageDlg(
                Question,
                mtConfirmation,
                TMsgDlgButtons() << mbYes << mbNo,
                0) != mrYes)
        {
            return;
        }

        UnicodeString BlockReason;
        if (IsEmployeeAccessBlocked(Employee, BlockReason))
        {
            MessageDlg(
                L"Este funcionário possui bloqueio ativo de acesso.\n\n" +
                (BlockReason.IsEmpty()
                    ? UnicodeString(L"Consulte a ocorrência registrada.")
                    : BlockReason),
                mtError,
                TMsgDlgButtons() << mbOK,
                0);
            return;
        }

        if (RecordManualAccessEvent(Employee))
        {
            LblDeveloperStatus->Caption =
                L"Acesso liberado manualmente para " +
                Employee.Name + L" às " +
                FormatDateTime(L"hh:nn:ss", Now()) + L".";

            MessageDlg(
                L"Acesso liberado e registrado com sucesso.",
                mtInformation,
                TMsgDlgButtons() << mbOK,
                0);
        }
        else
        {
            MessageDlg(
                L"Não foi possível registrar a liberação manual.",
                mtError,
                TMsgDlgButtons() << mbOK,
                0);
        }

        return;
    }

    if (FCurrentPage == TAccessPage::BleDevices)
    {
        RegisterRfidTagManual();
        return;
    }

    if (FCurrentPage == TAccessPage::Incidents)
    {
        if (FIncidentHistoryMode)
        {
            FIncidentHistoryMode = false;
            UpdateOccurrencePageButtons();
            RefreshOccurrenceEmployees();
        }
        else
        {
            SetSelectedEmployeeBlocked(true);
        }
        return;
    }
}

void __fastcall TMainForm::ClearClick(TObject *Sender)
{
    (void)Sender;

    if (FCurrentPage == TAccessPage::PresentEmployees)
    {
        RefreshPresentEmployees();
        return;
    }

    if (FCurrentPage == TAccessPage::RecentEntries)
    {
        RefreshRecentEntries();
        return;
    }

    if (FCurrentPage == TAccessPage::ManualRelease)
    {
        RefreshManualReleaseEmployees();
        return;
    }

    if (FCurrentPage == TAccessPage::BleDevices)
    {
        RemoveSelectedRfidTag();
        return;
    }

    if (FCurrentPage == TAccessPage::Incidents)
    {
        if (FIncidentHistoryMode)
        {
            if (RegisterOccurrence())
            {
                RefreshOccurrences();
            }
        }
        else
        {
            SetSelectedEmployeeBlocked(false);
        }
        return;
    }

    if (FCurrentPage == TAccessPage::Camera)
    {
        CycleCameraRotation();
        return;
    }

    ReturnTimer->Enabled = false;
    FIdentificationManager->ClearIdentification();
    ResetFacePreviewState();
    ShowIdentification();
}

void __fastcall TMainForm::CameraPreviewTimerTimer(TObject *Sender)
{
    (void)Sender;

    if (FCameraManager == nullptr || FCameraPreviewImage == nullptr ||
        FCameraPreviewBitmap == nullptr)
    {
        return;
    }

    TCameraFrame Frame;
    if (!FCameraManager->ReadFrame(Frame))
    {
        if (!FCameraManager->IsOpen() && FCameraPreviewTimer != nullptr)
        {
            FCameraPreviewTimer->Enabled = false;
            UpdateCameraPreviewVisibility();
            RefreshIdentificationView();
        }
        return;
    }

    TCameraFrame NormalizedFrame;
    if (!CopyFrameToTopDownBgra(Frame, NormalizedFrame))
    {
        return;
    }

    TCameraFrame DisplayFrame;
    if (!RotateBgraFrame(NormalizedFrame, DisplayFrame,
        EffectiveCameraRotation()))
    {
        return;
    }

    ++FPreviewFrameCounter;

    const bool DetectorReady = FFaceDetector != nullptr && FFaceDetector->IsInitialized();
    const bool ShouldDetect = DetectorReady &&
        (FPreviewFrameCounter == 1 ||
        (FPreviewFrameCounter % static_cast<unsigned long>(FFaceDetectionInterval)) == 0);

    if (ShouldDetect)
    {
        std::vector<FaceDetection> Detections = FFaceDetector->Detect(
            DisplayFrame.Data.data(), DisplayFrame.Width, DisplayFrame.Height,
            DisplayFrame.Stride);
        const FaceDetectionDebugStats DebugStats = FFaceDetector->LastDebugStats();
        const FaceDetection* CurrentFace = Detections.empty() ? nullptr : &Detections[0];
        const FaceRect CurrentBounds = CurrentFace == nullptr
            ? FaceRect()
            : CurrentFace->Bounds;
        const double CurrentRatio = CalculateFaceRatio(CurrentBounds,
            DisplayFrame.Width, DisplayFrame.Height);
        char DebugBuffer[512];
        std::snprintf(DebugBuffer, sizeof(DebugBuffer),
            "FACE_DISTANCE_INPUT rawDetections=%d validDetections=%d confidence=%.3f faceX=%d faceY=%d faceW=%d faceH=%d faceRatio=%.3f previousFace=%d previousDistance=%s\n",
            DebugStats.RawDetections,
            DebugStats.ValidDetections,
            CurrentFace == nullptr ? 0.0 : CurrentFace->Confidence,
            CurrentFace == nullptr ? -1 : CurrentBounds.X,
            CurrentFace == nullptr ? -1 : CurrentBounds.Y,
            CurrentFace == nullptr ? 0 : CurrentBounds.Width,
            CurrentFace == nullptr ? 0 : CurrentBounds.Height,
            CurrentRatio,
            FHadRecentFace ? 1 : 0,
            FaceDistanceName(FLastDistance));
        OutputDebugStringA(DebugBuffer);

        UpdateDetectionMetrics();
        UpdateFacePreviewState(Detections, DisplayFrame.Width, DisplayFrame.Height);

        std::snprintf(DebugBuffer, sizeof(DebugBuffer),
            "FACE_DISTANCE_STATE rawDetections=%d validDetections=%d faceRatio=%.3f faceWidth=%d faceHeight=%d distanceState=%s previousDistance=%s nearEdge=%d\n",
            DebugStats.RawDetections,
            DebugStats.ValidDetections,
            FLastFaceRatio,
            FLastFaceBounds.width,
            FLastFaceBounds.height,
            FaceDistanceName(FLastDistance),
            FaceDistanceName(FPreviousDistance),
            IsFaceNearFrameEdge(FLastFaceBounds, DisplayFrame.Width, DisplayFrame.Height) ? 1 : 0);
        OutputDebugStringA(DebugBuffer);

        if (Detections.size() > 1)
        {
            FLastFaceDetections = Detections;
        }
        else if (Detections.empty() && FFacePreviewState == TFacePreviewState::Waiting)
        {
            FLastFaceDetections.clear();
        }

        ApplyFacePreviewStatus();
    }

    if (FEnrollmentActive)
    {
        // Cadastro remoto/local continua tendo prioridade e usa o mesmo stream.
        ProcessFaceEnrollment(DisplayFrame);
    }
    else if (FCurrentPage == TAccessPage::Identification)
    {
        // v0.7.4.2:
        // A câmera continua capturando nas telas administrativas, porém uma
        // identificação facial só pode gerar acesso na tela de identificação.
        // Isso evita criar FFaceRecognitionLocked em background (ex.: menu TAG).
        ProcessFaceRecognition(DisplayFrame);
    }

    if (DetectorReady && !FLastFaceDetections.empty() &&
        FFacePreviewState != TFacePreviewState::Waiting)
    {
        FFaceDetector->DrawDetections(DisplayFrame.Data.data(),
            DisplayFrame.Width, DisplayFrame.Height, DisplayFrame.Stride,
            FLastFaceDetections);
    }

    if (FrameToBitmap(DisplayFrame, FCameraPreviewBitmap))
    {
          // Continua atualizando o bitmap mesmo quando o preview principal
    // estiver visualmente oculto. Assim o stream da câmera permanece aquecido.
    // O reconhecimento facial, porém, só é executado na tela Identification.
    FCameraPreviewImage->Picture->Assign(FCameraPreviewBitmap);

    // Preview da página de configuração da câmera.
    UpdateCameraSettingsPreview();

    // Quem decide se a webcam aparece ou não é exclusivamente
    // UpdateCameraPreviewVisibility().
    UpdateCameraPreviewVisibility();

    if (FCameraPreviewImage->Visible)
    {
        FCameraPreviewImage->SendToBack();
        FCameraPreviewImage->Invalidate();
    }
    }

	LblCameraStatus->Caption =
        L"● Câmera " + FCameraManager->StatusText() +
        L" • índice " + IntToStr(FPreviewCameraIndex);

      // =========================================================
    // OBSERVABILITY - STATUS REAL DA PORTARIA
    // =========================================================
    if (FObservabilityHeartbeat != nullptr)
    {
        FObservabilityHeartbeat->UpdateRuntimeStatus(
            FCameraManager != nullptr &&
            FCameraManager->IsOpen(),

            FFaceDetector != nullptr &&
            FFaceDetector->IsInitialized());
    }
}

