      FHeaderDecor(nullptr),
      FCameraDecor(nullptr),
      FFooterDecor(nullptr),
      FBrandSubtitle(nullptr),
      FTerminalStatusCard(nullptr),
      FTerminalStatusTitle(nullptr),
      FProductVersion(nullptr),
      FCameraModeBadge(nullptr),
      FIdleVisual(nullptr),
      FIdleVisualTimer(nullptr),
      FIdleVisualPhase(0),
      FRfidPollTimer(nullptr),
      FLastRfidState(TRfidVisualState::Idle),
      FRfidReaderCard(nullptr),
      FRfidReaderTitle(nullptr),
      FRfidReaderStatus(nullptr),
      FRfidReaderUid(nullptr),

      FCameraPreviewBitmap(nullptr),
      FEmployeePhotoImage(nullptr),
      FEmployeePhotoBitmap(nullptr),
      FRecognitionCheckShape(nullptr),
      FRecognitionCheckLabel(nullptr),
      FFaceRecognitionLocked(false),
      FRecognizedEmployeeId(0),
      FPreviewFrameCounter(0),
      FPreviewCameraIndex(0),
      FCameraListInitialized(false),
      FFaceHitFrames(0),
      FFaceMissFrames(0),
      FSingleFaceFrames(0),
      FMultipleFaceFrames(0),
      FFaceDetectionInterval(FaceDetectionIntervalFrames),
      FDetectionFramesThisSecond(0),
      FLastDetectionMetricTick(0),
      FMeasuredDetectionsPerSecond(0.0),
      FHasCurrentFaceBounds(false),
      FHasSmoothedFaceDetection(false),
      FLastRecognitionAttemptTick(0),
      FRecognitionCandidateId(0),
      FRecognitionCandidateHits(0),
      FLastCorrectTestScore(-1.0),
      FLastUnknownTestScore(-1.0),
      FLastRecognitionDurationMs(0.0),
      FEnrollmentActive(false),
      FIncidentHistoryMode(false),
      FEnrollmentEmployeeId(0),
      FPrimaryFaceDetection(),
      FHasPrimaryFace(false),
      FHasMultipleOperationalFaces(false),
      FStableFaceStartTick(0),
      FLastFaceSeenTick(0),
      FNoFaceSinceTick(0),
      FHadRecentFace(false),
      FLastDistance(FaceDistance::NoFace),
      FPreviousDistance(FaceDistance::NoFace),
      FLastFaceBounds(),
      FLastFaceTime(),
      FLastFaceRatio(0.0),
      FPreviousFaceRatio(0.0),
      FLayoutMode(TTerminalLayoutMode::Auto),
      FCameraRotationMode(TCameraRotationMode::Auto),
      FEmployeeSyncStateInitialized(false),
      FLastEmployeeSyncOnline(false),
      FLastEmployeeSyncCount(-1)
{
    InitializeManagers();
    ConfigureRuntimeView();
    InitializeRfidAdminReader();
    UpdateClock();
    RefreshIdentificationView();
    LayoutTerminal();
    InitializeRfidSerial();

    // =========================================================
    // OBSERVABILITY - HEARTBEAT DA PORTARIA
    // =========================================================
    FObservabilityHeartbeat =
        std::make_unique<TObservabilityHeartbeat>();

    FObservabilityHeartbeat->SetServerUrl(
        L"http://127.0.0.1:8080");

    FObservabilityHeartbeat->SetSource(
        L"PORTARIA-01");

    FObservabilityHeartbeat->SetVersion(
        L"1.0.0");

    FObservabilityHeartbeat->UpdateRuntimeStatus(
        FCameraManager != nullptr &&
        FCameraManager->IsOpen(),

        FFaceDetector != nullptr &&
        FFaceDetector->IsInitialized());

    FObservabilityHeartbeat->Start();
}

__fastcall TMainForm::~TMainForm()
{
    if (FRfidPollTimer != nullptr)
        FRfidPollTimer->Enabled = false;

    if (FRfidSerialReader != nullptr)
        FRfidSerialReader->Stop();

    StopCameraPreview();
    delete FCameraPreviewBitmap;
    FCameraPreviewBitmap = nullptr;

    delete FEmployeePhotoBitmap;
    FEmployeePhotoBitmap = nullptr;
}

void TMainForm::InitializeManagers()
{
    FConfig = TAppConfig::Default();
    LoadPersistedSettings();

    FCameraManager = std::make_unique<TCameraManager>();
    FBleManager = std::make_unique<TBleManager>();

    FAccessEventRepository =
        std::make_unique<TAccessEventRepository>(FConfig.AccessDatabasePath);
    FAccessEventRepository->Initialize();

    FEmployeeRepository = std::make_unique<TEmployeeRepository>(FConfig.DatabasePath);
    FIntegrationClient = std::make_unique<TIntegrationClient>(FConfig.ApiUrl);
    FIdentificationManager = std::make_unique<TIdentificationManager>(
        *FEmployeeRepository, *FIntegrationClient, FConfig);

    // v0.6.3 - ERP Delphi é a fonte oficial dos funcionários.
    FEmployeeSyncClient =
        std::make_unique<TEmployeeSyncClient>(
            FEmployeeRepository.get(),
            FConfig.ApiUrl);
    FEmployeeSyncClient->Start();

    FFaceDetector = std::make_unique<FaceDetector>();
    FFaceDetector->Initialize();

    FFaceRecognizer = std::make_unique<FaceRecognizer>();
    FFaceRecognizer->Initialize(ToStdString(FConfig.FaceRecognitionModelPath),
        ToStdString(FConfig.FaceLandmarkModelPath));

    FFaceRepository = std::make_unique<FaceRepository>(FConfig.FaceDataPath);
    FLivenessDetector = std::make_unique<LivenessDetector>(LivenessMode::Prototype);
}


void TMainForm::InitializeRfidAdminReader()
{
    if (FRfidReaderCard != nullptr || DeveloperPanel == nullptr)
        return;

    FRfidReaderCard = new TPanel(this);
    FRfidReaderCard->Parent = DeveloperPanel;
    FRfidReaderCard->Align = alNone;
    FRfidReaderCard->BevelOuter = bvNone;
    FRfidReaderCard->ParentBackground = false;
    FRfidReaderCard->Color = RgbColor(7, 19, 30);
    FRfidReaderCard->Visible = false;

    FRfidReaderTitle = new TLabel(this);
    FRfidReaderTitle->Parent = FRfidReaderCard;
    FRfidReaderTitle->AutoSize = false;
    FRfidReaderTitle->Caption = L"LEITOR DE TAG RFID";
    FRfidReaderTitle->Font->Name = L"Segoe UI Semibold";
    FRfidReaderTitle->Font->Size = 9;
    FRfidReaderTitle->Font->Color = RgbColor(220, 230, 240);
    FRfidReaderTitle->Transparent = true;

    FRfidReaderStatus = new TLabel(this);
    FRfidReaderStatus->Parent = FRfidReaderCard;
    FRfidReaderStatus->AutoSize = false;
    FRfidReaderStatus->Alignment = taRightJustify;
    FRfidReaderStatus->Font->Name = L"Segoe UI Semibold";
    FRfidReaderStatus->Font->Size = 9;
    FRfidReaderStatus->Transparent = true;

    FRfidReaderUid = new TLabel(this);
    FRfidReaderUid->Parent = FRfidReaderCard;
    FRfidReaderUid->AutoSize = false;
    FRfidReaderUid->Font->Name = L"Consolas";
    FRfidReaderUid->Font->Size = 11;
    FRfidReaderUid->Font->Color = RgbColor(101, 190, 255);
    FRfidReaderUid->Transparent = true;

    UpdateRfidAdminReader();
}

void TMainForm::UpdateRfidAdminReader()
{
    if (FRfidReaderCard == nullptr)
        return;

    const bool Visible =
        FCurrentPage == TAccessPage::BleDevices;

    FRfidReaderCard->Visible = Visible;

    if (!Visible)
        return;

    const bool PortOpen =
        FRfidSerialReader != nullptr &&
        FRfidSerialReader->IsPortOpen();

    const bool Ready =
        PortOpen &&
        FRfidSerialReader->IsDeviceReady();

    if (!PortOpen)
    {
        FRfidReaderStatus->Caption = L"● OFFLINE • COM5";
        FRfidReaderStatus->Font->Color = RgbColor(255, 82, 96);
    }
    else if (!Ready)
    {
        FRfidReaderStatus->Caption = L"● INICIALIZANDO / RECUPERANDO • COM5";
        FRfidReaderStatus->Font->Color = RgbColor(245, 190, 79);
    }
    else
    {
        FRfidReaderStatus->Caption = L"● ONLINE • COM5";
        FRfidReaderStatus->Font->Color = RgbColor(41, 214, 132);
    }

    if (FRfidAdminUid.IsEmpty())
    {
        FRfidReaderUid->Caption =
            L"UID: --   •   Aproxime um cartão ou chaveiro do leitor";
        FRfidReaderUid->Font->Color = RgbColor(164, 176, 194);

        if (BtnSimulate != nullptr)
            BtnSimulate->Caption = L"CADASTRAR TAG RFID";
    }
    else
    {
        FRfidReaderUid->Caption =
            L"UID: " + FRfidAdminUid +
            L"   •   TAG capturada — selecione o funcionário e vincule";
        FRfidReaderUid->Font->Color = RgbColor(101, 190, 255);

        if (BtnSimulate != nullptr)
            BtnSimulate->Caption = L"VINCULAR TAG LIDA";
    }
}

void TMainForm::InitializeRfidSerial()
{
    FRfidSerialReader = std::make_unique<TRfidSerialReader>();

    // ETAPA 2:
    // COM5 foi validada fisicamente com o ESP32-S3.
    // Depois desta prova ponta a ponta a porta será movida para Configurações.
    FRfidSerialReader->Start(L"COM5", 115200);

    FRfidPollTimer = new TTimer(this);
    FRfidPollTimer->Enabled = false;
    // Firmware 0.4.0 entrega o UID imediatamente. O polling da VCL em 20 ms
    // reduz a latencia percebida na portaria sem bloquear a camera.
    FRfidPollTimer->Interval = 20;
    FRfidPollTimer->OnTimer = RfidPollTimerTimer;
    FRfidPollTimer->Enabled = true;

    ApplyRfidStatus();
}

void __fastcall TMainForm::RfidPollTimerTimer(TObject* Sender)
{
    (void)Sender;

    if (FRfidSerialReader == nullptr)
    {
        ApplyRfidStatus();
        return;
    }

    UnicodeString RawUid;

    while (FRfidSerialReader->TryPopTag(RawUid))
    {
        const UnicodeString Uid = NormalizeRfidUid(RawUid);

        if (!IsValidRfidUid(Uid))
        {
            OutputDebugStringW(
                (L"[RFID][PORTARIA] UID inválido recebido: " +
                 RawUid + L"\r\n").c_str());
            continue;
        }

        FLastRfidUid = Uid;
        FLastRfidState = TRfidVisualState::TagRead;

        OutputDebugStringW(
            (L"[RFID][PORTARIA] TAG recebida via USB Serial: " +
             Uid + L"\r\n").c_str());

        // v0.4:
        // Na tela principal a TAG física já é um fator de acesso independente.
        // Na tela administrativa continuamos apenas exibindo o UID recebido,
        // para que o operador possa cadastrar/remover vínculos.
        if (FCurrentPage == TAccessPage::Identification)
        {
            ProcessRfidIdentification(Uid);
        }
        else if (FCurrentPage == TAccessPage::BleDevices)
        {
            // Na área administrativa a leitura é capturada para vínculo,
            // sem executar a liberação de acesso da tela principal.
            FRfidAdminUid = Uid;

            if (LblDeveloperStatus != nullptr)
            {
                LblDeveloperStatus->Caption =
                    L"TAG capturada pelo leitor • UID " + Uid +
                    L" • selecione o funcionário para vincular";
            }

            UpdateRfidAdminReader();
        }
    }

    ApplyRfidStatus();
    UpdateRfidAdminReader();
}

void TMainForm::ApplyRfidStatus()
{
    if (LblBleIndicator == nullptr ||
        LblBleStatusDetail == nullptr)
    {
        return;
    }

    LblBleIndicator->Caption = L"RFID";
    LblBleIndicator->Font->Color = RgbColor(164, 176, 194);

    if (FRfidSerialReader == nullptr ||
        !FRfidSerialReader->IsPortOpen())
    {
        LblBleStatusDetail->Caption = L"● COM5 offline";
        LblBleStatusDetail->Font->Color = RgbColor(255, 82, 96);
        return;
    }

    // v0.4.4.1:
    // O UID recebido não é, por si só, um resultado positivo.
    // Mantemos o estado semântico da última leitura para que uma TAG
    // desconhecida não seja exibida em verde apenas por ter sido lida.
    if (!FLastRfidUid.IsEmpty())
    {
        switch (FLastRfidState)
        {
            case TRfidVisualState::Authorized:
                LblBleStatusDetail->Caption =
                    L"● AUTORIZADA • " + FLastRfidUid;
                LblBleStatusDetail->Font->Color =
                    RgbColor(41, 214, 132);
                return;

            case TRfidVisualState::UnknownTag:
                LblBleStatusDetail->Caption =
                    L"● NÃO CADASTRADA • " + FLastRfidUid;
                LblBleStatusDetail->Font->Color =
                    RgbColor(245, 190, 79);
                return;

            case TRfidVisualState::Denied:
                LblBleStatusDetail->Caption =
                    L"● ACESSO NEGADO • " + FLastRfidUid;
                LblBleStatusDetail->Font->Color =
                    RgbColor(220, 72, 82);
                return;

            case TRfidVisualState::InvalidLink:
                LblBleStatusDetail->Caption =
                    L"● VÍNCULO INVÁLIDO • " + FLastRfidUid;
                LblBleStatusDetail->Font->Color =
                    RgbColor(220, 72, 82);
                return;

            case TRfidVisualState::TagRead:
                LblBleStatusDetail->Caption =
                    L"● TAG " + FLastRfidUid;
                LblBleStatusDetail->Font->Color =
                    RgbColor(41, 214, 132);
                return;

            case TRfidVisualState::Idle:
            default:
                break;
        }
    }

    if (FRfidSerialReader->IsDeviceReady())
    {
        LblBleStatusDetail->Caption = L"● Leitor ONLINE";
        LblBleStatusDetail->Font->Color = RgbColor(41, 214, 132);
        return;
    }

    LblBleStatusDetail->Caption = L"● RFID inicializando / recuperando";
    LblBleStatusDetail->Font->Color = RgbColor(245, 190, 79);
}

void TMainForm::ConfigureRuntimeView()
{
    // Paleta empresarial: preto grafite + azul petróleo + estados fortes.
    // A estrutura segue a lógica visual de um terminal de acesso dedicado,
    // sem copiar marca/identidade visual de terceiros.
    const TColor BackgroundColor = RgbColor(7, 12, 18);
    const TColor HeaderColor = RgbColor(4, 8, 13);
    const TColor CardColor = RgbColor(12, 23, 34);
    const TColor SubtleTextColor = RgbColor(170, 181, 194);
    const TColor OnlineColor = RgbColor(34, 211, 137);

    Caption = L"EmployeeAccess";
    Position = poScreenCenter;
    ConfigureCaptions();

    // Reduz flicker da VCL durante atualização contínua da webcam.
    DoubleBuffered = true;
    RootPanel->DoubleBuffered = true;
    CameraPanel->DoubleBuffered = true;
    BottomStatusPanel->DoubleBuffered = true;
    EmployeeResultPanel->DoubleBuffered = true;

    RootPanel->Color = BackgroundColor;
    TopBarPanel->Color = HeaderColor;
    ClockPanel->Color = BackgroundColor;
    PageHost->Color = BackgroundColor;
    IdentificationView->Color = BackgroundColor;
    BottomStatusPanel->Color = BackgroundColor;
    CameraPanel->Color = CardColor;
    FaceStatusCard->Color = CardColor;
    BleStatusCard->Color = CardColor;
    MenuCenterPanel->Color = BackgroundColor;
    // Botão principal inspirado em terminais corporativos de acesso:
    // vermelho como ação de menu, com hover mais luminoso.
    BtnMenu->Color = RgbColor(198, 32, 42);
    BtnMenu->OnMouseEnter = MenuHoverEnter;
    BtnMenu->OnMouseLeave = MenuHoverLeave;

    TopBarPanel->Height = 72;
    ClockPanel->Height = 150;

    const bool ShowRecognizedCard =
        EmployeeResultPanel != nullptr && EmployeeResultPanel->Visible;
    BottomStatusPanel->Height = ShowRecognizedCard ? 340 : 210;

    LblAppName->Font->Name = L"Segoe UI Semibold";
    LblAppName->Font->Size = 16;
    LblTerminal->Font->Name = L"Segoe UI Semibold";
    LblTerminal->Font->Size = 11;
    LblTerminal->Font->Color = SubtleTextColor;
    LblOnline->Font->Name = L"Segoe UI Semibold";
	LblOnline->Font->Size = 10;
    LblOnline->Font->Color = OnlineColor;

    LblClock->Font->Name = L"Segoe UI Light";
    LblClock->Font->Size = 44;
    LblDate->Font->Name = L"Segoe UI";
    LblDate->Font->Size = 13;
    LblDate->Font->Color = SubtleTextColor;

    LblPrompt->Font->Name = L"Segoe UI Semibold";
    LblPrompt->Font->Size = 18;
    LblCameraStatus->Font->Name = L"Segoe UI";
    LblCameraStatus->Font->Size = 10;
    LblCameraStatus->Font->Color = SubtleTextColor;

    // O resultado facial não deve cobrir a webcam. O card é reaproveitado
    // como um resumo compacto abaixo da câmera.
    EmployeeResultPanel->Parent = BottomStatusPanel;
    EmployeeResultPanel->Color = CardColor;
    EmployeeResultPanel->BevelOuter = bvNone;
    EmployeeResultPanel->Visible = false;

    PhotoPanel->Color = RgbColor(22, 36, 52);
    PhotoPanel->BevelOuter = bvNone;

    if (FEmployeePhotoImage == nullptr)
    {
        FEmployeePhotoImage = new TImage(PhotoPanel);
        FEmployeePhotoImage->Parent = PhotoPanel;
        FEmployeePhotoImage->Align = alClient;
        FEmployeePhotoImage->Stretch = true;
        FEmployeePhotoImage->Proportional = true;
        FEmployeePhotoImage->Center = true;
        FEmployeePhotoImage->Visible = false;
    }

    if (FEmployeePhotoBitmap == nullptr)
    {
        FEmployeePhotoBitmap = new Graphics::TBitmap();
    }

    LblPhoto->Visible = true;
    LblPhoto->Caption = L"FOTO";
    LblEmployeeState->Caption = L"FUNCIONÁRIO RECONHECIDO";

    // Badge de confirmação sobre a área da câmera.
    if (FRecognitionCheckShape == nullptr)
    {
        FRecognitionCheckShape = new TShape(CameraPanel);
        FRecognitionCheckShape->Parent = CameraPanel;
        FRecognitionCheckShape->Shape = stCircle;
        FRecognitionCheckShape->Brush->Color = RgbColor(34, 211, 137);
        FRecognitionCheckShape->Pen->Style = psClear;
        FRecognitionCheckShape->Visible = false;
    }

    if (FRecognitionCheckLabel == nullptr)
    {
        FRecognitionCheckLabel = new TLabel(CameraPanel);
        FRecognitionCheckLabel->Parent = CameraPanel;
        FRecognitionCheckLabel->AutoSize = false;
        FRecognitionCheckLabel->Transparent = true;
        FRecognitionCheckLabel->Alignment = taCenter;
        FRecognitionCheckLabel->Layout = tlCenter;
        FRecognitionCheckLabel->Font->Name = L"Segoe UI Semibold";
        FRecognitionCheckLabel->Font->Size = 16;
        FRecognitionCheckLabel->Font->Color = clWhite;
        FRecognitionCheckLabel->Caption = L"✓";
        FRecognitionCheckLabel->Visible = false;
    }

    InitializeTechBackground();
    InitializeCorporateDecor();
    InitializeIdleVisual();
    InitializeCameraPreview();
	InitializeIdleAnimation();
	InitializeCameraSelector();
	InitializeSettingsControls();
    ReturnTimer->Enabled = false;
    ClockTimer->Enabled = true;
    ShowPage(TAccessPage::Identification);
    StartCameraPreview();
}

void TMainForm::ConfigureCaptions()
{
    LblTerminal->Caption = TerminalDisplayName();
    LblOnline->Caption = L"● ONLINE";
    LblMenuFooter->Caption =
        TerminalDisplayName() + L" | Versão 1.0.0";
    LblMenuHeader->Caption = L"Operações da portaria";
    BtnMenu->Caption = L"MENU";
    LblMenuHint->Caption = L"Opções da portaria";
    BtnBackFromPage->Caption = L"VOLTAR PARA IDENTIFICAÇÃO";
	BtnMenuBack->Caption = L"FECHAR MENU -->";


    LblMenuIdentificationTitle->Caption = L"Identificação";
    LblMenuIdentificationDesc->Caption = L"Tela principal de identificação";
    LblMenuPresentTitle->Caption = L"Funcionários presentes";
    LblMenuPresentDesc->Caption = L"Pessoas presentes na empresa";
    LblMenuRecentTitle->Caption = L"Últimas entradas";
    LblMenuRecentDesc->Caption = L"Eventos recentes do terminal";
    LblMenuCameraTitle->Caption = L"Câmera";
    LblMenuCameraDesc->Caption = L"Configuração e teste de vídeo";
    LblMenuBleTitle->Caption = L"TAG RFID";
    LblMenuBleDesc->Caption = L"Cadastro de chaveiros e cartões RFID";
    LblMenuManualTitle->Caption = L"Liberação manual";
    LblMenuManualDesc->Caption = L"Liberação assistida pelo porteiro";
    LblMenuOccurrencesTitle->Caption = L"Ocorrências";
    LblMenuOccurrencesDesc->Caption = L"Eventos e problemas de acesso";
    LblMenuSettingsTitle->Caption = L"Configurações";
    LblMenuSettingsDesc->Caption = L"Terminal, API e parâmetros";

    // v0.4.3.1 - o estado de espera já aparece no card FACE.
    // Mantemos os overlays centrais vazios para impedir qualquer
    // piscada de "APROXIME-SE" durante alternância rápida dos estados
    // do detector entre frames.
    LblFaceGlyph->Caption = L"";
    LblCameraPlaceholder->Caption = L"";
    LblFaceGlyph->Visible = false;
    LblCameraPlaceholder->Visible = false;

    LblPrompt->Caption = L"Aproxime-se para identificação";
    LblFaceIndicator->Caption = L"FACE";
    LblFaceStatusDetail->Caption = L"● Aguardando";
    LblBleIndicator->Caption = L"RFID";
    LblBleStatusDetail->Caption = L"● Conectando...";
    LblCameraStatus->Caption = L"● Câmera aguardando inicialização";
    LblDeveloperStatus->Caption = L"Selecione um funcionário e cadastre a identificação facial.";
    BtnStartCamera->Caption = L"Iniciar câmera";
    BtnSimulate->Caption = L"Cadastrar identificação facial";
    BtnClear->Caption = L"Atualizar funcionários";
}


void TMainForm::InitializeTechBackground()
{
    if (FTechBackground != nullptr)
    {
        return;
    }

    FTechBackground = new TPaintBox(IdentificationView);
    FTechBackground->Parent = IdentificationView;
    FTechBackground->Align = alClient;
    FTechBackground->Enabled = false;
    FTechBackground->OnPaint = TechBackgroundPaint;
    FTechBackground->SendToBack();
}

void __fastcall TMainForm::TechBackgroundPaint(TObject* Sender)
{
    (void)Sender;

    if (FTechBackground == nullptr)
    {
        return;
    }

    TCanvas* C = FTechBackground->Canvas;
    const int W = FTechBackground->ClientWidth;
    const int H = FTechBackground->ClientHeight;

    C->Brush->Style = bsSolid;
    C->Brush->Color = RgbColor(3, 10, 18);
    C->FillRect(TRect(0, 0, W, H));

    // Grade técnica muito discreta.
    C->Pen->Style = psSolid;
    C->Pen->Width = 1;
    C->Pen->Color = RgbColor(7, 27, 43);

    const int Grid = 72;
    for (int X = 0; X < W; X += Grid)
    {
        C->MoveTo(X, 0);
        C->LineTo(X, H);
    }

    for (int Y = 0; Y < H; Y += Grid)
    {
        C->MoveTo(0, Y);
        C->LineTo(W, Y);
    }

    // Linhas laterais em perspectiva, mantendo o centro limpo.
    C->Pen->Color = RgbColor(9, 55, 88);

    const int CenterY = H / 2;
    for (int I = 0; I < 5; ++I)
    {
        const int Offset = I * 34;

        C->MoveTo(0, CenterY - 170 + Offset);
        C->LineTo(W / 5, CenterY - 70 + Offset / 2);

        C->MoveTo(W, CenterY - 170 + Offset);
        C->LineTo(W - (W / 5), CenterY - 70 + Offset / 2);
    }

    // Pequenos pontos tecnológicos nas laterais.
    C->Pen->Style = psClear;
    C->Brush->Style = bsSolid;
    C->Brush->Color = RgbColor(16, 92, 145);

    for (int I = 0; I < 7; ++I)
    {
        const int Y = 80 + (I * 74);

        C->Ellipse(26, Y, 30, Y + 4);
        C->Ellipse(W - 30, Y + 22, W - 26, Y + 26);
    }

    // Linha de energia horizontal muito sutil.
    C->Pen->Style = psSolid;
    C->Pen->Width = 1;
    C->Pen->Color = RgbColor(11, 72, 115);

    C->MoveTo(W / 16, CenterY);
    C->LineTo(W / 4, CenterY);

    C->MoveTo((W * 3) / 4, CenterY);
    C->LineTo((W * 15) / 16, CenterY);

    // Circuitos angulares nas extremidades superiores/inferiores.
    C->Pen->Color = RgbColor(8, 44, 72);
    C->Pen->Width = 1;

    C->MoveTo(0, 28);
    C->LineTo(W / 8, 28);
    C->LineTo(W / 8 + 28, 56);
    C->LineTo(W / 5, 56);

    C->MoveTo(W, H - 36);
    C->LineTo((W * 7) / 8, H - 36);
    C->LineTo((W * 7) / 8 - 28, H - 64);
    C->LineTo((W * 4) / 5, H - 64);

    // Pequenos nós luminosos.
    C->Pen->Style = psClear;
    C->Brush->Color = RgbColor(20, 112, 174);
    for (int I = 0; I < 5; ++I)
    {
        const int X1 = 70 + (I * 90);
        const int X2 = W - 74 - (I * 88);
        C->Ellipse(X1, 40 + I * 16, X1 + 3, 43 + I * 16);
        C->Ellipse(X2, H - 70 - I * 15, X2 + 3, H - 67 - I * 15);
    }
}


