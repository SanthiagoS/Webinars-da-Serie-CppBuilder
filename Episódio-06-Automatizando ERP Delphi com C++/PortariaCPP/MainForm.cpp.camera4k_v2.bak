    const int FaceDetectedRequiredFrames = 2;
    const int FaceMissingRequiredFrames = 5;
    const int FaceDetectionIntervalFrames = 2;
    const int FaceRecognitionIntervalMs = 300;
    const int FaceRecognitionRequiredHits = 3;
    const int FaceEnrollmentRequiredSamples = 8;

    // v0.7.4.1 - qualidade da imagem facial.
    // O limite foi calibrado com a webcam real para separar melhor
    // pouca iluminação de perda de nitidez.
    // v0.7.4.1 - calibrado após teste real com webcam.
    // A câmera ainda produzia brilho médio acima de 55 mesmo em ambiente
    // visualmente escuro, fazendo o frame cair no filtro de nitidez.
    const double FaceMinimumBrightness = 90.0;
    // Distance tuning:
    // - Enter/exit thresholds intentionally differ to create hysteresis.
    // - This prevents the UI from oscillating between "too far / good / too close".
    const int RecentFaceToleranceMs = 1500;
    const double TooFarEnterRatio = 0.18;
    const double TooFarExitRatio = 0.22;
    const double TooCloseEnterRatio = 0.58;
    const double TooCloseExitRatio = 0.52;
    const double LargeFaceNearEdgeRatio = 0.45;
    const double GrowingFaceRatioDelta = 0.04;

    // =========================================================
    // CANAL OPERACIONAL DIRETO ERP DELPHI <-> PORTARIA
    // =========================================================
    // O WebServer :8080 permanece exclusivamente para observabilidade.
    // Cadastro facial remoto usa diretamente a API operacional do ERP.
    const UnicodeString ErpOperationalApiBase =
        L"http://127.0.0.1:3101/api";

    struct TErpEnrollmentCommand
    {
        bool Pending;
        int EmployeeId;
        UnicodeString EmployeeName;
        UnicodeString RequestId;
        UnicodeString Terminal;

        TErpEnrollmentCommand()
            : Pending(false),
              EmployeeId(0)
        {
        }
    };

    struct TPendingEnrollmentResultRetry
    {
        bool Active;
        UnicodeString RequestId;
        UnicodeString Status;
        UnicodeString Message;
        int Samples;

        TPendingEnrollmentResultRetry()
            : Active(false),
              Samples(0)
        {
        }
    };

    TPendingEnrollmentResultRetry GPendingEnrollmentResultRetry;

