        }
    };

    TPendingRevokeResultRetry GPendingRevokeResultRetry;

    UnicodeString JsonFieldText(
        TJSONObject* Root,
        const UnicodeString& Name)
    {
        if (Root == nullptr)
            return L"";

        TJSONValue* Value = Root->GetValue(Name);
        return Value != nullptr ? Value->Value() : UnicodeString();
    }

    // =========================================================
    // ETAPA 5 - ERP COMO AUTORIDADE DA DECISAO DE ACESSO
    // =========================================================
    // ERP online: /api/access/authorize e a fonte oficial da decisao.
    // ERP indisponivel: a Portaria preserva a regra local como contingencia.
    // FACE/RFID continuam apenas identificando; a Portaria executa a decisao.
    struct TErpAccessDecision
    {
        bool Available;
        bool Authorized;
        UnicodeString Reason;
        UnicodeString EmployeeName;
        UnicodeString WorkStart;
        UnicodeString WorkEnd;

        TErpAccessDecision()
            : Available(false),
              Authorized(false)
        {
        }
    };

    bool TryGetErpAccessDecision(
        int EmployeeId,
        const UnicodeString& Credential,
        TErpAccessDecision& Decision)
    {
        Decision = TErpAccessDecision();

        if (EmployeeId <= 0)
            return false;

        try
        {
            std::unique_ptr<TIdHTTP> Http(new TIdHTTP(nullptr));
            Http->ConnectTimeout = 350;
            Http->ReadTimeout = 650;
            Http->Request->ContentType = L"application/json";
            Http->Request->CharSet = L"utf-8";

            std::unique_ptr<TJSONObject> Payload(new TJSONObject());
            Payload->AddPair(L"employeeId", new TJSONNumber(EmployeeId));
            Payload->AddPair(L"terminal", L"PORTARIA-01");
            Payload->AddPair(L"credential", Credential);

            std::unique_ptr<TStringStream> Body(
                new TStringStream(
                    Payload->ToJSON(),
                    TEncoding::UTF8,
                    false));

            Body->Position = 0;

            const UnicodeString ResponseText =
                Http->Post(
                    ErpOperationalApiBase +
                    L"/access/authorize",
                    Body.get());

            if (Http->ResponseCode < 200 ||
                Http->ResponseCode >= 300)
            {
                return false;
            }

            std::unique_ptr<TJSONValue> JsonValue(
                TJSONObject::ParseJSONValue(
                    ResponseText,
                    true,
                    false));

            TJSONObject* Root =
                dynamic_cast<TJSONObject*>(JsonValue.get());

            if (Root == nullptr)
                return false;

            Decision.Available = true;
            Decision.Authorized = SameText(
                Trim(JsonFieldText(Root, L"authorized")),
                L"true");
            Decision.Reason =
                Trim(JsonFieldText(Root, L"reason"));
            Decision.EmployeeName =
                JsonFieldText(Root, L"employeeName");
            Decision.WorkStart =
                JsonFieldText(Root, L"workStart");
            Decision.WorkEnd =
                JsonFieldText(Root, L"workEnd");

            return true;
        }
        catch (...)
        {
            // ERP indisponivel: o chamador aplicara a contingencia local.
            return false;
        }
    }

    UnicodeString ErpAccessReasonToDisplay(
        const UnicodeString& Reason)
    {
        if (SameText(Reason, L"EMPLOYEE_BLOCKED"))
            return L"Bloqueado pelo ERP";

        if (SameText(Reason, L"OUTSIDE_WORK_HOURS"))
            return L"Fora do horário de expediente";

        if (SameText(Reason, L"INVALID_WORK_SCHEDULE"))
            return L"Horário de expediente inválido no ERP";

        if (SameText(Reason, L"EMPLOYEE_NOT_FOUND"))
            return L"Funcionário não encontrado no ERP";

        if (!Trim(Reason).IsEmpty())
            return Reason;

        return L"Acesso negado pelo ERP";
    }

    void LogAccessDecisionComparison(
        const UnicodeString& Credential,
        const TEmployee& Employee,
        bool LocalAuthorized,
        const TErpAccessDecision& ErpDecision)
    {
        UnicodeString Line;

        if (!ErpDecision.Available)
        {
            Line =
                L"[ACCESS][COMPARE] credential=" + Credential +
                L" employeeId=" + IntToStr(Employee.Id) +
                L" employee=" + Employee.Name +
                L" local=" +
                (LocalAuthorized ? UnicodeString(L"GRANTED") : UnicodeString(L"DENIED")) +
                L" erp=UNAVAILABLE reason=ERP_UNAVAILABLE match=NA";
        }
        else
        {
            const bool Match =
                LocalAuthorized == ErpDecision.Authorized;

            Line =
                L"[ACCESS][COMPARE] credential=" + Credential +
                L" employeeId=" + IntToStr(Employee.Id) +
                L" employee=" + Employee.Name +
                L" local=" +
                (LocalAuthorized ? UnicodeString(L"GRANTED") : UnicodeString(L"DENIED")) +
                L" erp=" +
                (ErpDecision.Authorized ? UnicodeString(L"GRANTED") : UnicodeString(L"DENIED")) +
                L" reason=" + ErpDecision.Reason +
                L" schedule=" + ErpDecision.WorkStart + L"-" + ErpDecision.WorkEnd +
                L" match=" +
                (Match ? UnicodeString(L"1") : UnicodeString(L"0"));
        }

        OutputDebugStringW((Line + L"\r\n").c_str());

        // ETAPA 4.1: registra a comparacao em arquivo para permitir testes
        // com Run Without Debugging, evitando interrupcoes first-chance do Indy.
        try
        {
            const UnicodeString DataDir =
                TPath::Combine(ExtractFilePath(Application->ExeName), L"data");

            if (!TDirectory::Exists(DataDir))
                TDirectory::CreateDirectory(DataDir);

            const UnicodeString LogPath =
                TPath::Combine(DataDir, L"access_compare.log");

            const UnicodeString FileLine =
                FormatDateTime(L"yyyy-mm-dd hh:nn:ss.zzz", Now()) +
                L" | " + Line + L"\r\n";

            TFile::AppendAllText(
                LogPath,
                FileLine,
                TEncoding::UTF8);
        }
        catch (...)
        {
            // Log diagnostico nunca pode interferir na operacao da Portaria.
        }
    }

    bool TryGetPendingEnrollmentFromErp(
        TErpEnrollmentCommand& Command)
    {
        Command = TErpEnrollmentCommand();

        try
        {
            std::unique_ptr<TIdHTTP> Http(new TIdHTTP(nullptr));
            Http->ConnectTimeout = 350;
            Http->ReadTimeout = 650;

            const UnicodeString ResponseText =
                Http->Get(
                    ErpOperationalApiBase +
                    L"/enrollment/pending");

            std::unique_ptr<TJSONValue> JsonValue(
                TJSONObject::ParseJSONValue(
                    ResponseText,
                    true,
                    false));

            TJSONObject* Root =
                dynamic_cast<TJSONObject*>(JsonValue.get());

            if (Root == nullptr)
                return false;

            const bool Pending =
                SameText(
                    Trim(JsonFieldText(Root, L"pending")),
                    L"true");

            if (!Pending)
                return false;

            Command.Pending = true;
            Command.RequestId =
                Trim(JsonFieldText(Root, L"requestId"));

            Command.EmployeeId =
                StrToIntDef(
                    JsonFieldText(Root, L"employeeId"),
                    0);

            Command.EmployeeName =
                JsonFieldText(Root, L"employeeName");

            Command.Terminal =
                JsonFieldText(Root, L"terminal");

            return !Command.RequestId.IsEmpty() &&
                Command.EmployeeId > 0;
        }
        catch (...)
        {
            // ERP indisponível não interrompe câmera, RFID ou acesso local.
            return false;
        }
    }

    bool PostOperationalJson(
        const UnicodeString& RelativePath,
        TJSONObject* Payload)
    {
        if (Payload == nullptr)
            return false;

        try
        {
            std::unique_ptr<TIdHTTP> Http(new TIdHTTP(nullptr));
            Http->ConnectTimeout = 350;
            Http->ReadTimeout = 650;
            Http->Request->ContentType = L"application/json";
            Http->Request->CharSet = L"utf-8";

            std::unique_ptr<TStringStream> Body(
                new TStringStream(
                    Payload->ToJSON(),
                    TEncoding::UTF8,
                    false));

            Body->Position = 0;

            Http->Post(
                ErpOperationalApiBase + RelativePath,
                Body.get());

            return Http->ResponseCode >= 200 &&
                Http->ResponseCode < 300;
        }
        catch (...)
        {
            // A falha de comunicação não pode travar o terminal.
            return false;
        }
    }

    bool SendDirectEnrollmentProgress(
        const UnicodeString& RequestId,
        const UnicodeString& Message,
        int Samples)
    {
        if (Trim(RequestId).IsEmpty())
            return false;

        std::unique_ptr<TJSONObject> Payload(
            new TJSONObject());

        Payload->AddPair(
            L"requestId",
            RequestId);

        Payload->AddPair(
            L"samples",
            new TJSONNumber(Samples));

        Payload->AddPair(
            L"message",
            Message);

        return PostOperationalJson(
            L"/enrollment/progress",
            Payload.get());
    }

    bool SendDirectEnrollmentResult(
        const UnicodeString& RequestId,
        const UnicodeString& Status,
        const UnicodeString& Message,
        int Samples)
    {
        if (Trim(RequestId).IsEmpty())
            return false;

        std::unique_ptr<TJSONObject> Payload(
            new TJSONObject());

        Payload->AddPair(
            L"requestId",
            RequestId);

        Payload->AddPair(
            L"status",
            Status);

        Payload->AddPair(
            L"samples",
            new TJSONNumber(Samples));

        Payload->AddPair(
            L"message",
            Message);

        return PostOperationalJson(
            L"/enrollment/result",
            Payload.get());
    }

    void QueueEnrollmentResultForRetry(
        const UnicodeString& RequestId,
        const UnicodeString& Status,
        const UnicodeString& Message,
        int Samples)
    {
        GPendingEnrollmentResultRetry.Active = true;
        GPendingEnrollmentResultRetry.RequestId = RequestId;
        GPendingEnrollmentResultRetry.Status = Status;
        GPendingEnrollmentResultRetry.Message = Message;
        GPendingEnrollmentResultRetry.Samples = Samples;
    }

    void SendEnrollmentResultToErp(
        const UnicodeString& RequestId,
        const UnicodeString& Status,
        const UnicodeString& Message,
        int Samples)
    {
        if (Trim(RequestId).IsEmpty())
            return;

        if (!SendDirectEnrollmentResult(
                RequestId,
                Status,
                Message,
                Samples))
        {
            QueueEnrollmentResultForRetry(
                RequestId,
                Status,
                Message,
                Samples);
        }
    }

    bool FlushPendingEnrollmentResultToErp()
    {
        if (!GPendingEnrollmentResultRetry.Active)
            return true;

        if (!SendDirectEnrollmentResult(
                GPendingEnrollmentResultRetry.RequestId,
                GPendingEnrollmentResultRetry.Status,
                GPendingEnrollmentResultRetry.Message,
                GPendingEnrollmentResultRetry.Samples))
        {
            return false;
        }

        GPendingEnrollmentResultRetry =
            TPendingEnrollmentResultRetry();

        return true;
    }

